{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.mars.college" }],
      "destination": "https://mars.college/$1",
      "permanent": true
    },
    {
      "source": "/toolcamp",
      "destination": "https://dec.mars.college",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "mit.mars.college" }],
      "destination": "/mit-court"
    }
  ]
}
