{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.mars.college"
        }
      ],
      "destination": "https://mars.college/$1",
      "permanent": true
    },
    {
      "source": "/dec(/)?",
      "destination": "/dom",
      "permanent": true
    },
    {
      "source": "/toolcamp(/)?",
      "destination": "https://dom.mars.college",
      "permanent": true
    },
    {
