---
// /learn2 — "The Almanac"
// Long-form, single column, zine-feel. Pull quotes inline between chapters.
// Heavy editorial type, small image figures sprinkled in.
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Eyebrow from "../components/Eyebrow.astro";
import {
  AI_PROGRAM_TOPICS,
  AI_PROGRAM_LOCK_NOTE,
  TRACKS,
  WEEK,
  TERM,
  COHORT,
  OPEN_CALENDAR,
  QUOTES,
} from "../data/learn-program";
import { APPLY_URL } from "../data/site";

import heroImg from "../assets/photos/learn/002_2026_dscf1586_ece64.jpg"; // tiered audience
import figClass from "../assets/photos/learn/020_2026_dscf0028_1bd1c.jpg";
import figCircle from "../assets/photos/learn/038_2022_img_4312_95dfd.jpg";
import figCelebrate from "../assets/photos/learn/050_2024_img_8542_bb32a.jpg";
import figClay from "../assets/photos/learn/supp_2022_clay_vessels.jpg";
import figYoga from "../assets/photos/learn/supp_2023_acroyoga_desert.jpg";
import figLivecode from "../assets/photos/learn/supp_2023_livecode_tidal.jpg";
import figKitchen from "../assets/photos/learn/supp_2022_noodle_kitchen.jpg";
---

<BaseLayout
  title="Learn — Mars College 2027"
  description="An almanac of the Mars College academic program: AI cohort, open calendar, tracks, and the rhythm of a three-month off-grid term."
>
  <PageHeader
    index="02"
    label="Learn · An almanac"
    title="How the desert teaches."
    lede="An open calendar populated by anyone who wants to teach into it — and an AI program holding the whole thing together. Inside, the inventory."
    image={heroImg}
    imageAlt="Audience seated on tiered plywood at a Mars College Thunder Talk"
  />

  <!-- I. THE INVENTORY -->
  <section class="u-section essay">
    <div class="u-shell essay__shell">
      <Eyebrow index="I" label="The inventory" />
      <h2 class="u-display chapter">What we've actually taught.</h2>
      <p class="lede">
        People ask what kind of college Mars is. We've been figuring it out for
        seven seasons and the answer keeps changing — but the shape underneath
        has held. The simplest way to describe it is to list the classes.
      </p>

      <p>
        Some of what follows is a full department that ran the whole term. Some
        of it was one Wednesday afternoon. Both count. Roughly half recurs every
        year. The other half is whatever the cohort that showed up decided to make.
      </p>

      <ul class="inventory">
        {TRACKS.map((t) => (
          <li>
            <span class="inventory__name">{t.name}</span>
            <span class="inventory__since">since {t.since}</span>
            <span class="inventory__body">— {t.body}</span>
          </li>
        ))}
      </ul>

      <figure class="figure">
        <Image
          src={figCircle}
          alt="A circle of Martians watching a presentation in the hangar"
          widths={[700, 1100, 1400]}
          sizes="(max-width: 900px) 100vw, 70ch"
          format="webp"
          quality={70}
          loading="lazy"
        />
        <figcaption>The circle in the hangar — Ideas Week, 2022.</figcaption>
      </figure>

      <blockquote class="pull">
        <p>{QUOTES[1].text}</p>
        <cite>— {QUOTES[1].source}</cite>
      </blockquote>
    </div>
  </section>

  <!-- II. THE OPEN CALENDAR -->
  <section class="u-section essay">
    <div class="u-shell essay__shell">
      <Eyebrow index="II" label="The open calendar" />
      <h2 class="u-display chapter">If you want to teach it, add it.</h2>

      <p class="lede">{OPEN_CALENDAR.body}</p>

      <p>
        A typical week has yoga in the morning, a writing workshop at noon, a
        soldering circle in the afternoon, a screening at sunset, and somebody
        live-coding music on a plywood wall until 2am. None of it is mandatory.
        Most of it has a small, devoted audience. The cumulative effect is that
        you arrive at Mars with one project and leave having quietly learned six
        other things.
      </p>

      <p>
        We call this <em>do-ocracy</em>. <em>If you want to do something and it
        doesn't look like it'll majorly inconvenience anybody, you just do it.</em>
        It applies to classes the same way it applies to building a shade
        structure or starting a café. The downside is that nobody's hovering to
        make sure you're growing; the upside is that the people teaching are
        doing it because they genuinely want to.
      </p>

      <figure class="figure">
        <Image
          src={figLivecode}
          alt="A Martian live-coding Tidal music with code projected behind"
          widths={[700, 1100, 1400]}
          sizes="(max-width: 900px) 100vw, 70ch"
          format="webp"
          quality={70}
          loading="lazy"
        />
        <figcaption>Live-coded music. The code is the instrument and the projection.</figcaption>
      </figure>
    </div>
  </section>

  <!-- III. THE AI PROGRAM -->
  <section class="u-section essay is-essay-night">
    <div class="u-shell essay__shell">
      <Eyebrow index="III" label="The AI program — the spine" />
      <h2 class="u-display chapter">Five things every cohort Martian learns.</h2>

      <p class="lede">
        The Creative AI program has run every year since 2022. Each season builds
        on the last. The pitch hasn't changed: <strong>use AI to expand your
        understanding of the things you already know and care about</strong>.
      </p>

      <ol class="five">
        {AI_PROGRAM_TOPICS.map((t) => (
          <li>
            <span class="u-index">{t.n}</span>
            <h3>{t.title}</h3>
            <p>{t.body}</p>
          </li>
        ))}
      </ol>

      <p class="note">
        <span class="u-label u-label--clay">Note</span>
        {AI_PROGRAM_LOCK_NOTE}
      </p>

      <blockquote class="pull pull--night">
        <p>{QUOTES[0].text}</p>
        <cite>— {QUOTES[0].source}</cite>
      </blockquote>
    </div>
  </section>

  <!-- IV. A WEEK -->
  <section class="u-section essay">
    <div class="u-shell essay__shell">
      <Eyebrow index="IV" label="A week" />
      <h2 class="u-display chapter">Seven days, more or less.</h2>

      <p class="lede">
        Inside the calendar, certain beats recur enough to be load-bearing.
        <strong>Thunder Talks</strong> every Wednesday night. <strong>Marsbod</strong>
        most mornings. <strong>Livecoding</strong> Friday. <strong>Algorave</strong>
        most other Saturdays.
      </p>

      <ol class="week-list">
        {WEEK.map((d) => (
          <li>
            <h3 class="week-list__day">{d.day}</h3>
            <p class="week-list__line"><span>morning</span> {d.morning}</p>
            <p class="week-list__line"><span>midday</span> {d.midday}</p>
            <p class="week-list__line"><span>evening</span> {d.evening}</p>
          </li>
        ))}
      </ol>

      <figure class="figure">
        <Image
          src={figKitchen}
          alt="A Martian serving noodles from a wok in the kitchen"
          widths={[700, 1100, 1400]}
          sizes="(max-width: 900px) 100vw, 70ch"
          format="webp"
          quality={70}
          loading="lazy"
        />
        <figcaption>Sunday noodle bar at Chatsubo.</figcaption>
      </figure>
    </div>
  </section>

  <!-- V. THE TERM -->
  <section class="u-section essay">
    <div class="u-shell essay__shell">
      <Eyebrow index="V" label="The term" />
      <h2 class="u-display chapter">From Build Week to the desert returning.</h2>

      <ol class="arc">
        {TERM.filter((t) => t.kind !== "online").map((t) => (
          <li>
            <span class="arc__date">{t.date}</span>
            <div>
              <h3 class="arc__label">{t.label}</h3>
              <p>{t.body}</p>
            </div>
          </li>
        ))}
      </ol>

      <figure class="figure">
        <Image
          src={figCelebrate}
          alt="The cohort applauding at the end of a Mars College show"
          widths={[700, 1100, 1400]}
          sizes="(max-width: 900px) 100vw, 70ch"
          format="webp"
          quality={70}
          loading="lazy"
        />
        <figcaption>Mars Electronica. Finals look like a release party.</figcaption>
      </figure>

      <blockquote class="pull">
        <p>{QUOTES[3].text}</p>
        <cite>— {QUOTES[3].source}</cite>
      </blockquote>
    </div>
  </section>

  <!-- VI. THE OFF-SEASON -->
  <section class="u-section essay is-essay-night">
    <div class="u-shell essay__shell">
      <Eyebrow index="VI" label="The off-season" />
      <h2 class="u-display chapter">Aug 24 to December. Online.</h2>

      <p class="lede">{COHORT.blurb}</p>

      <ul class="off">
        {COHORT.bullets.map((b) => (
          <li>
            <h3>{b.title}</h3>
            <p>{b.body}</p>
          </li>
        ))}
      </ul>

      <p class="aside">
        We'll write more about the cohort in a separate post. The short version:
        the actual practice of the AI program — building agents, generating media,
        automating your own work — doesn't require the desert. The desert is for
        everything else. The off-season cohort separates them.
      </p>
    </div>
  </section>

  <!-- VII. CTA -->
  <section class="u-section--tight">
    <div class="u-shell cta-band">
      <p class="cta-band__text u-display">
        Bring the work you want to make.
      </p>
      <a href={APPLY_URL} class="u-cta">
        Apply for 2027 <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <style>
    .essay__shell { max-width: 78ch; margin-inline: auto; padding-inline: 0; }
    .essay p, .essay li { font-size: 1.125rem; line-height: 1.65; color: var(--color-ink); }
    .essay .lede { font-size: 1.3rem; line-height: 1.55; color: var(--color-ink); margin: 0 0 1.5rem; max-width: 50ch; }
    .essay p { margin: 1rem 0; }
    .essay p em { font-style: italic; color: var(--color-clay-deep); }
    .essay p strong { font-weight: 800; }
    .chapter { font-size: clamp(2rem, 4.5vw, 3.4rem); line-height: 1.02; max-width: 22ch; margin: 0.25rem 0 1.5rem; }

    .figure { margin: 2.5rem 0; }
    .figure :global(img) { width: 100%; height: auto; display: block; }
    .figure figcaption { margin-top: 0.6rem; font-family: var(--font-body); font-size: var(--text-meta); color: var(--color-ink-3); letter-spacing: 0.02em; font-style: italic; }

    .pull { border-top: var(--rule-strong); border-bottom: var(--rule-strong); padding: 1.5rem 0; margin: 2.5rem 0; }
    .pull p { font-family: var(--font-display); font-size: clamp(1.3rem, 2.4vw, 1.75rem); font-weight: 600; line-height: 1.3; letter-spacing: -0.01em; color: var(--color-clay-deep); }
    .pull cite { display: block; margin-top: 0.75rem; font-style: normal; font-size: var(--text-meta); letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-ink-3); }

    /* Night variant of essay */
    .is-essay-night { background: var(--color-night); color: var(--color-bone-on-night); background-image: radial-gradient(var(--color-rule-night) 0.5px, transparent 0.5px); background-size: 28px 28px; }
    .is-essay-night .essay__shell p, .is-essay-night .essay__shell li, .is-essay-night .essay__shell .lede { color: var(--color-bone-on-night); }
    .is-essay-night .figure figcaption { color: #b7a98f; }
    .pull--night { border-color: var(--color-rule-night); }
    .pull--night p { color: var(--color-clay); }
    .pull--night cite { color: #b7a98f; }

    /* Inventory list */
    .inventory { list-style: none; padding: 0; margin: 1.5rem 0; }
    .inventory li { padding: 0.85rem 0; border-bottom: var(--rule); display: flex; flex-wrap: wrap; gap: 0.5rem 0.75rem; align-items: baseline; }
    .inventory__name { font-family: var(--font-display); font-weight: 800; font-size: 1.15rem; letter-spacing: -0.01em; }
    .inventory__since { font-family: var(--font-mono); font-size: var(--text-meta); color: var(--color-clay); }
    .inventory__body { color: var(--color-ink-2); flex-basis: 100%; }
    .is-essay-night .inventory li { border-color: var(--color-rule-night); }
    .is-essay-night .inventory__body { color: #d2c5af; }

    /* Five-list (AI topics) */
    .five { list-style: none; padding: 0; margin: 1.5rem 0; counter-reset: five; }
    .five li { padding: 1.5rem 0; border-bottom: 1px solid var(--color-rule-night); display: grid; grid-template-columns: 3rem 1fr; gap: 0.5rem 1rem; align-items: baseline; }
    .five li .u-index { color: var(--color-clay); }
    .five li h3 { font-family: var(--font-display); font-weight: 800; font-size: 1.5rem; }
    .five li p { margin: 0.3rem 0 0; grid-column: 2; color: #d2c5af; }

    .note { border-left: 2px solid var(--color-clay); padding: 0.25rem 0 0.25rem 1.25rem; margin: 1.5rem 0 0; max-width: 60ch; font-size: 1.1rem; }
    .note .u-label { display: block; margin-bottom: 0.4rem; }

    /* Week list */
    .week-list { list-style: none; padding: 0; margin: 1.5rem 0; display: grid; gap: 0; border-top: var(--rule); }
    .week-list li { padding: 1rem 0; border-bottom: var(--rule); }
    .week-list__day { font-family: var(--font-display); font-weight: 800; font-size: 1.5rem; letter-spacing: -0.02em; }
    .week-list__line { margin: 0.3rem 0; color: var(--color-ink-2); }
    .week-list__line span { display: inline-block; width: 5rem; font-family: var(--font-body); font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-ink-3); font-weight: 700; }

    /* Arc */
    .arc { list-style: none; padding: 0; margin: 1.5rem 0; border-top: var(--rule-strong); }
    .arc li { display: grid; grid-template-columns: 9rem 1fr; gap: 1rem; padding: 1.25rem 0; border-bottom: var(--rule); align-items: baseline; }
    .arc__date { font-family: var(--font-mono); font-size: var(--text-meta); color: var(--color-clay); }
    .arc__label { font-family: var(--font-display); font-weight: 800; font-size: 1.4rem; letter-spacing: -0.02em; }
    @media (max-width: 560px) { .arc li { grid-template-columns: 1fr; gap: 0.25rem; } }

    /* Off-season */
    .off { list-style: none; padding: 0; margin: 1.5rem 0; }
    .off li { padding: 1.25rem 0; border-bottom: 1px solid var(--color-rule-night); }
    .off h3 { font-family: var(--font-display); font-weight: 800; font-size: 1.25rem; color: var(--color-bone-on-night); }
    .off p { margin: 0.4rem 0 0; color: #d2c5af; }

    .aside { font-style: italic; color: #cabda6; margin-top: 2rem; max-width: 56ch; }

    .cta-band { display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap; border-top: var(--rule-strong); padding-top: 2.5rem; max-width: 78ch; margin-inline: auto; }
    .cta-band__text { font-size: clamp(1.6rem, 3.4vw, 2.6rem); max-width: 20ch; }
  </style>
</BaseLayout>
