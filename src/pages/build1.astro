---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Eyebrow from "../components/Eyebrow.astro";
import {
  BUILD_SCHEDULE,
  BUILD_FAQ,
  TALLY_BUILD_FORM_ID,
  BUILD_SUBSTACK_URL,
  EMAIL,
} from "../data/site";

// Hero
import hero from "../assets/photos/build-curated/047_2026_img_1144_2f1d9.jpg";

// The four phases
import phasePlan from "../assets/photos/build-curated/bare-playa-survey-2025.jpg";
import phaseBuild from "../assets/photos/build-curated/047_2025_img_8497_70ffe.jpg";
import phaseServe from "../assets/photos/aerial-3.jpg";
import phaseBreak from "../assets/photos/build-curated/bare-playa-sunset-2020.jpg";

// What gets built
import strAmph from "../assets/photos/build-curated/solar-structure.jpg";
import strPavilion from "../assets/photos/build/mural-solar.jpg";
import strGallery from "../assets/photos/build-curated/2026-ai-gallery.jpg";
import strProjWall from "../assets/photos/build/solar-pyramid.jpg";

// DPW intro
import dpwHero from "../assets/photos/build-curated/041_2026_20260130_170446_06ab8.jpg";

// Closer
import closer from "../assets/photos/build-curated/021_2025_2026_img_20251116_161732_63192.jpg";

// What DPW crew gets — highlighted up top
const perks = [
  { icon: "⌂", h: "Housing", body: "A place to live for the season, if you need one." },
  { icon: "✦", h: "Fee waived", body: "Your Mars general fee is waived." },
  { icon: "◗", h: "Meal plan", body: "Eat on the DPW meal plan." },
  { icon: "◆", h: "No camp dues", body: "No camp dues stacked on top." },
];

// The DPW year — Freeman's four phases
const phases = [
  {
    n: "01",
    name: "Planning",
    when: "Jul – Oct",
    img: phasePlan,
    body: "Design the city. Draw the urban plan, model the structures we want to build, and line up the materials for them. Think through the services DPW can offer and the equipment each one needs.",
  },
  {
    n: "02",
    name: "Build",
    when: "Nov – Dec",
    img: phaseBuild,
    body: "Raise the city. Most of it is pallet-rack and lumber construction. Once the core structures stand, the crew moves to solar and electrical, plumbing and kitchens, internet, and everything else that makes it livable.",
  },
  {
    n: "03",
    name: "Serve",
    when: "Jan – Mar",
    img: phaseServe,
    body: "Keep the services running through the semester. Truck in water and fill the tanks, keep the filters going so there's drinking water for everyone, run the trash trailer to the dump. Ice, recycling, composting, a food co-op — what we manage depends on who shows up.",
  },
  {
    n: "04",
    name: "Breakdown",
    when: "Apr – May",
    img: phaseBreak,
    body: "Take it all back down. Deconstruct the solar and water systems, dismantle the large structures, then clean, organize, and put everything into storage. Leave the land as we found it.",
  },
];

const structures = [
  {
    n: "01",
    name: "The Amphitheater",
    role: "Outdoor stage · projection wall · gatherings",
    img: strAmph,
    imgCap: "Chiba, Mars 2023",
    body: "Open-air stage and seating with north and west wind walls. The north wall doubles as a projection surface. Hosts Thunder Talks, music, algoraves, and large gatherings.",
  },
  {
    n: "02",
    name: "The Pavilion",
    role: "80 ft shade structure · living room · café",
    img: strPavilion,
    imgCap: "Solar wall, Mars 2026",
    body: "Burning Man Center Camp-style shade structure. Eighty-foot diameter, shade net on a pallet rack frame in concentric rings. Comfortable seating, wind and sun protection, no solid walls. The daily living room. A central tower with a spiral staircase is on the table.",
  },
  {
    n: "03",
    name: "Art Gallery & Refuge",
    role: "Enclosed · gallery · compute · classroom",
    img: strGallery,
    imgCap: "Inside the gallery, MC26 midterms",
    body: "Smaller, fully enclosed, climate-controlled. Houses the gallery for screens, projection, and darkness; doubles as compute room, bad-weather refuge, and classroom space.",
  },
  {
    n: "04",
    name: "The Projection Wall",
    role: "Freestanding 20×60 ft · classrooms behind",
    img: strProjWall,
    imgCap: "Chiba, Mars 2026",
    body: "A standalone twenty-by-sixty-foot artifact with classrooms tucked behind it. The thing you can see from across the playa at sunset.",
  },
];

const TRACKS = [
  {
    title: "DPW crew",
    when: "Apply by Oct 1, 2026",
    body: "Plan, build, serve, break down. Full-season infrastructure work. Housing, fee waived, meal plan, no camp dues.",
  },
  {
    title: "Concession operator",
    when: "Inquire any time",
    body: "Run a service Mars needs. Fridge, ice, water, solar, food co-op, EUC repair, dump runs. Vendor channel through DPW.",
  },
  {
    title: "Grant applicant",
    when: "Open July → Dec 1, 2026",
    body: "Gallery, bakery, kiln, tool library, large-scale art. Issued as DPW credits, spendable on materials and services.",
  },
  {
    title: "First Camp build-track",
    when: "Arrive late December",
    body: "New to Mars. Enter through the build. Earn your season through infrastructure work. Lighter academic load.",
  },
];
---

<BaseLayout
  title="Build · Mars College 2027"
  description="Mars DPW — the off-grid major for Mars College. Plan, build, serve, and break down the off-grid village raised from bare desert every winter. Housing, meals, fee waived, no camp dues."
>
  <!-- ============= HERO ============= -->
  <section class="hero6">
    <div class="hero6__bg" aria-hidden="true">
      <Image
        src={hero}
        alt="Six Mars College builders lifting a horizontal orange pallet-rack beam together at sunset"
        widths={[768, 1280, 1920]}
        sizes="100vw"
        format="webp"
        quality={74}
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero6__scrim"></div>
    </div>
    <div class="u-shell hero6__content">
      <p class="u-eyebrow hero6__eyebrow">
        <span class="u-index">SEASON 8</span>
        <span class="u-label">Department of Public Works</span>
      </p>
      <h1 class="hero6__title u-display u-rise">
        Come help build<br />
        <span class="hero6__title-em">the next Mars.</span>
      </h1>
      <p class="hero6__lede u-rise" style="animation-delay:120ms">
        Mars DPW — the Department of Public Works — is the <strong>off-grid
        major</strong> for Mars College. It designs the desert city, builds it,
        keeps it running for a season, and takes it back down. Crew for the 2027
        build is open, and the deal is simple:
        <strong>housing, meals, fee waived, no camp dues.</strong>
      </p>
      <div class="hero6__actions u-rise" style="animation-delay:200ms">
        <a href="#inquire" class="u-cta">Apply to build <span aria-hidden="true">→</span></a>
        <a href="#phases" class="u-link hero6__what">See the four phases <span class="u-arrow" aria-hidden="true">↓</span></a>
      </div>
      <p class="hero6__deadline u-label">Applications close · October 1, 2026</p>
    </div>
  </section>

  <!-- ============= MEET DPW ============= -->
  <section class="u-section dpw6">
    <div class="u-shell dpw6__grid">
      <div class="dpw6__text">
        <Eyebrow index="01" label="Department of Public Works" />
        <h2 class="dpw6__title u-display">
          The off-grid major.
        </h2>
        <p class="dpw6__body">
          <strong>Mars DPW</strong> builds and runs every physical system at
          Mars — power, water, shelter, kitchens, internet, gear. Put simply,
          DPW does whatever needs doing to get Mars functioning.
        </p>
        <p class="dpw6__body">
          It's the most physical, immediate work at Mars, and it runs the whole
          year in four phases: design it over the summer, build it in the fall,
          keep it alive through the winter semester, take it back down in the
          spring. You learn off-grid construction from people who've done it
          five seasons, and you make friends in shared effort before you know
          them in conversation.
        </p>
        <p class="dpw6__deep">
          For the full operational picture (material catalog, deadlines,
          concessions, economics), read the
          <a href={BUILD_SUBSTACK_URL} class="u-link dpw6__link">DPW deep dive
            <span class="u-arrow" aria-hidden="true">→</span></a>
        </p>
      </div>
      <figure class="u-plate dpw6__media">
        <Image
          src={dpwHero}
          alt="Two people sit on a pallet-rack platform at golden hour, the desert and trailers stretching to the mountains beyond"
          widths={[500, 900, 1300]}
          sizes="(max-width: 900px) 100vw, 45vw"
          format="webp"
          quality={70}
          loading="lazy"
        />
        <figcaption class="dpw6__cap u-label">Sitting on what got built · MC26</figcaption>
      </figure>
    </div>
  </section>

  <!-- ============= WHAT DPW CREW GETS (highlight band) ============= -->
  <section class="u-section--tight perks6 is-night">
    <div class="u-shell">
      <p class="u-eyebrow perks6__eyebrow">
        <span class="u-label u-label--clay">What you get</span>
      </p>
      <h2 class="perks6__title u-display">Crew earns its season back.</h2>
      <ul class="perks6__grid">
        {
          perks.map((p) => (
            <li class="perks6__card">
              <span class="perks6__icon" aria-hidden="true">{p.icon}</span>
              <h3 class="perks6__h">{p.h}</h3>
              <p class="perks6__body">{p.body}</p>
            </li>
          ))
        }
      </ul>
      <p class="perks6__note">
        Plus more depending on how long you're here and what you take on.
      </p>
    </div>
  </section>

  <!-- ============= THE FOUR PHASES ============= -->
  <section id="phases" class="u-section phases6">
    <div class="u-shell phases6__head">
      <Eyebrow index="02" label="How the year works · four phases" />
      <h2 class="phases6__title u-display">Plan it. Build it. Serve it. Break it down.</h2>
      <p class="phases6__lede">
        DPW is a year-round major, not a two-month build. The work moves through
        four phases — from a summer of design to a spring of breakdown.
      </p>
    </div>
    <div class="u-shell phases6__grid">
      {
        phases.map((p) => (
          <article class="phase6">
            <div class="u-plate phase6__plate">
              <Image
                src={p.img}
                alt={`${p.name} phase`}
                widths={[500, 900, 1300]}
                sizes="(max-width: 820px) 100vw, 50vw"
                format="webp"
                quality={70}
                loading="lazy"
              />
            </div>
            <div class="phase6__text">
              <p class="phase6__meta">
                <span class="u-index">{p.n} / 04</span>
                <span class="u-label u-label--clay">{p.when}</span>
              </p>
              <h3 class="phase6__name">{p.name}</h3>
              <p class="phase6__body">{p.body}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- ============= WHAT GETS BUILT ============= -->
  <section class="u-section is-night structures6">
    <div class="u-shell structures6__head">
      <Eyebrow index="03" label="Urban plan 2027 · designs evolving" />
      <h2 class="structures6__title u-display">
        Four buildings taking shape.
      </h2>
      <p class="structures6__lede">
        The 2027 plan is still being worked out — this is the Planning phase in
        motion. DPW members are inspiring and refining each design as build
        approaches. Photographs below are references from past Mars builds, not
        renderings of what's planned.
      </p>
    </div>

    <div class="u-shell">
      <ol class="strs6__list">
        {
          structures.map((s, i) => (
            <li class:list={["strs6", { "is-reverse": i % 2 === 1 }]}>
              <figure class="strs6__media-wrap">
                <div class="u-plate strs6__media">
                  <Image
                    src={s.img}
                    alt={s.name}
                    widths={[500, 900, 1300]}
                    sizes="(max-width: 900px) 100vw, 50vw"
                    format="webp"
                    quality={70}
                    loading="lazy"
                  />
                </div>
                <figcaption class="strs6__imgcap u-label">{s.imgCap}</figcaption>
              </figure>
              <div class="strs6__text">
                <p class="strs6__meta">
                  <span class="u-index">{s.n} / 04</span>
                  <span class="u-label u-label--clay">{s.role}</span>
                </p>
                <h3 class="strs6__name">{s.name}</h3>
                <p class="strs6__body">{s.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============= FOUR WAYS IN ============= -->
  <section class="u-section tracks6">
    <div class="u-shell">
      <Eyebrow index="04" label="Four ways in" />
      <h2 class="tracks6__title u-display">
        Pick a track. Each one earns its way differently.
      </h2>
      <ul class="tracks6__grid">
        {
          TRACKS.map((t, i) => (
            <li class="track6">
              <p class="track6__meta">
                <span class="u-index">{String(i + 1).padStart(2, "0")}</span>
                <span class="u-label u-label--clay">{t.when}</span>
              </p>
              <h3 class="track6__title">{t.title}</h3>
              <p class="track6__body">{t.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============= BUILD CALENDAR (vertical timeline with bg) ============= -->
  <section class="timeline6">
    <div class="timeline6__bg" aria-hidden="true">
      <Image
        src={closer}
        alt=""
        widths={[768, 1280, 1920]}
        sizes="100vw"
        format="webp"
        quality={68}
        loading="lazy"
      />
      <div class="timeline6__scrim"></div>
    </div>
    <div class="u-shell timeline6__content">
      <Eyebrow index="05" label="Build calendar · 2026 – 2027" />
      <h2 class="timeline6__title u-display">
        How the year plays out.
      </h2>
      <ol class="tl6__list">
        {
          BUILD_SCHEDULE.map((s, i) => (
            <li class="tl6__item">
              <span class="tl6__index u-index">{String(i + 1).padStart(2, "0")}</span>
              <span class="tl6__date">{s.date}</span>
              <span class="tl6__label">{s.label}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============= FAQ ============= -->
  <section class="u-section faq6">
    <div class="u-shell">
      <Eyebrow index="06" label="Frequently asked questions" />
      <ul class="faq6__list">
        {
          BUILD_FAQ.map((item, i) => (
            <li class="faq6__item">
              <details>
                <summary>
                  <span class="u-index">{String(i + 1).padStart(2, "0")}</span>
                  <span class="faq6__q">{item.q}</span>
                  <span class="faq6__chevron" aria-hidden="true">+</span>
                </summary>
                <p class="faq6__a">{item.a}</p>
              </details>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============= APPLY TO BUILD (Tally embed) ============= -->
  <section id="inquire" class="u-section is-night inquire6">
    <div class="u-shell inquire6__grid">
      <div class="inquire6__text">
        <Eyebrow index="07" label="Apply to build" />
        <h2 class="inquire6__title u-display">Tell us what you'll bring.</h2>
        <p class="inquire6__body">
          A short form for build crew, breakdown crew, or DPW concessions. We'll
          follow up about phases and skills.
        </p>
        <p class="inquire6__deep">
          For the full operational picture, read the
          <a href={BUILD_SUBSTACK_URL} class="u-link inquire6__link">DPW deep dive
            <span class="u-arrow" aria-hidden="true">→</span></a>
        </p>
      </div>
      <div class="inquire6__form">
        {
          TALLY_BUILD_FORM_ID ? (
            <iframe
              data-tally-src={`https://tally.so/embed/${TALLY_BUILD_FORM_ID}?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1`}
              loading="lazy"
              width="100%"
              height="700"
              frameborder="0"
              marginheight="0"
              marginwidth="0"
              title="Mars DPW build inquiry"
            />
          ) : (
            <div class="inquire6__placeholder">
              <p class="u-label u-label--clay">Form coming soon</p>
              <p>
                Until the form is up, email <a href={`mailto:${EMAIL}`} class="inquire6__email">{EMAIL}</a>
                with subject "DPW 2027".
              </p>
            </div>
          )
        }
      </div>
    </div>
    <script async src="https://tally.so/widgets/embed.js"></script>
  </section>


  <style>
    /* ============================== HERO ============================== */
    .hero6 {
      position: relative;
      background: var(--color-night);
      color: var(--color-bone-on-night);
      overflow: hidden;
      isolation: isolate;
      min-height: clamp(38rem, 88vh, 56rem);
      display: flex;
      flex-direction: column;
    }
    .hero6__bg { position: absolute; inset: 0; z-index: 0; }
    .hero6__bg img { width: 100%; height: 100%; object-fit: cover; object-position: center 55%; }
    .hero6__scrim {
      position: absolute; inset: 0;
      background:
        linear-gradient(
          to top,
          rgba(18, 15, 12, 0.96) 0%,
          rgba(18, 15, 12, 0.72) 40%,
          rgba(18, 15, 12, 0.2) 80%,
          rgba(18, 15, 12, 0.45) 100%
        ),
        linear-gradient(
          to right,
          rgba(18, 15, 12, 0.55) 0%,
          rgba(18, 15, 12, 0.05) 50%,
          rgba(18, 15, 12, 0) 100%
        );
    }
    .hero6__content {
      position: relative; z-index: 2;
      margin-top: auto;
      padding-block: clamp(2rem, 5vh, 3.5rem);
      max-width: 60rem;
    }
    .hero6__eyebrow { color: var(--color-bone-on-night); }
    .hero6__eyebrow::after { background: var(--color-rule-night); }
    .hero6__eyebrow .u-label { color: #c8b89b; }
    .hero6__title {
      font-family: var(--font-display);
      font-weight: 800;
      font-size: clamp(3rem, 8vw, 6.75rem);
      line-height: 0.95;
      letter-spacing: -0.035em;
      text-wrap: balance;
      text-shadow: 0 2px 28px rgba(18, 15, 12, 0.78);
    }
    .hero6__title-em { color: var(--color-clay); }
    .hero6__lede {
      margin-top: 1.5rem;
      max-width: 54ch;
      font-size: clamp(1.15rem, 1.6vw, 1.4rem);
      line-height: 1.5;
      color: #efe6d4;
    }
    .hero6__lede strong { color: var(--color-bone-on-night); font-weight: 700; }
    .hero6__actions {
      margin-top: 2rem;
      display: flex;
      align-items: center;
      gap: 1.75rem;
      flex-wrap: wrap;
    }
    .hero6__what {
      color: var(--color-bone-on-night);
      border-color: var(--color-bone-on-night);
    }
    .hero6__deadline {
      margin-top: 2rem;
      color: var(--color-clay);
    }

    /* ============================== MEET DPW ============================== */
    .dpw6__grid {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: clamp(2rem, 6vw, 5rem);
      align-items: center;
    }
    .dpw6__title {
      font-size: clamp(1.9rem, 4vw, 3rem);
      max-width: 18ch;
    }
    .dpw6__body {
      margin-top: 1.25rem;
      font-size: var(--text-lg);
      line-height: 1.55;
      color: var(--color-ink-2);
      max-width: 52ch;
    }
    .dpw6__body strong {
      color: var(--color-ink);
      font-weight: 700;
    }
    .dpw6__deep {
      margin-top: 1.75rem;
      color: var(--color-ink-2);
      max-width: 50ch;
    }
    .dpw6__media {
      aspect-ratio: 3 / 4;
    }
    .dpw6__cap {
      position: absolute;
      left: 0;
      bottom: 0;
      z-index: 2;
      padding: 0.65rem 0.75rem;
      color: var(--color-bone-on-night);
      background: linear-gradient(
        to top,
        rgba(20, 17, 14, 0.8),
        rgba(20, 17, 14, 0) 100%
      );
      width: 100%;
    }
    @media (max-width: 880px) {
      .dpw6__grid { grid-template-columns: 1fr; }
    }

    /* ============================== WHAT DPW CREW GETS ============================== */
    .perks6__eyebrow {
      margin-bottom: 1rem;
    }
    .perks6__title {
      font-size: clamp(1.7rem, 3.6vw, 2.6rem);
      color: var(--color-bone-on-night);
      max-width: 20ch;
      margin-bottom: 2rem;
    }
    .perks6__grid {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: clamp(1rem, 2vw, 1.25rem);
    }
    .perks6__card {
      background: var(--color-night-2);
      border: 1px solid var(--color-rule-night);
      color: var(--color-bone-on-night);
      padding: clamp(1.4rem, 2.5vw, 2rem);
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      min-height: 11rem;
    }
    .perks6__icon {
      font-family: var(--font-display);
      font-size: clamp(1.8rem, 3vw, 2.4rem);
      color: var(--color-clay);
      line-height: 1;
      margin-bottom: 0.9rem;
    }
    .perks6__h {
      font-family: var(--font-display);
      font-weight: 800;
      font-size: clamp(1.2rem, 2.2vw, 1.55rem);
      letter-spacing: -0.025em;
      line-height: 1;
    }
    .perks6__body {
      margin-top: 0.5rem;
      color: #cabda6;
      font-size: var(--text-sm);
      line-height: 1.45;
      max-width: 28ch;
    }
    .perks6__note {
      margin-top: 1.5rem;
      color: #b7a98f;
      font-size: var(--text-base);
    }
    @media (max-width: 900px) {
      .perks6__grid { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 520px) {
      .perks6__grid { grid-template-columns: 1fr; }
    }

    /* ============================== FOUR PHASES ============================== */
    .phases6__head { max-width: 60rem; margin-bottom: 3rem; }
    .phases6__title {
      font-size: clamp(1.9rem, 4.2vw, 3.2rem);
      max-width: 20ch;
    }
    .phases6__lede {
      margin-top: 1.25rem;
      color: var(--color-ink-2);
      font-size: var(--text-lg);
      line-height: 1.55;
      max-width: 56ch;
    }
    .phases6__grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: clamp(1.75rem, 4vw, 3rem) clamp(1.5rem, 3vw, 2.5rem);
    }
    .phase6 { margin: 0; }
    .phase6__plate { aspect-ratio: 5 / 4; }
    /* Serve phase is a wide drone shot with empty space on the left;
       shift the crop right so the village reads. */
    .phase6:nth-child(3) .phase6__plate :global(img) {
      object-position: 72% center;
    }
    .phase6__text { margin-top: 1.1rem; }
    .phase6__meta {
      display: flex;
      align-items: baseline;
      gap: 1rem;
      flex-wrap: wrap;
