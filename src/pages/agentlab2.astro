---
// /agentlab2 — Agent Lab candidate #2: "Syllabus / curriculum-forward."
// The week-by-week curriculum is the star: academic, precise, calm.
// Mono dates, hairline rules, generous rhythm. Reads from the single
// source of truth in src/data/agentlab.ts. Different layout from the
// canonical /agentlab — NOT a copy.
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Eyebrow from "../components/Eyebrow.astro";
import { EMAIL, TALLY_OFFGRID_FORM_ID } from "../data/site";
import {
  AGENTLAB,
  AGENTLAB_ARCS,
  AGENTLAB_SCHEDULE,
  AGENTLAB_TIERS,
  AGENTLAB_GRANTS,
  AGENTLAB_FACTS,
  AGENTLAB_WINTER,
  AGENTLAB_LINKS,
  HERO_IMG,
  IMG_DESERT,
} from "../data/agentlab";

// ── Group the 12 sessions by arc, preserving schedule order. This drives
// the curriculum section: each arc becomes a labelled unit of weeks.
const ARC_ORDER = [
  "Kickoff",
  "Personal agents",
  "Agents that earn",
  "Sovereign & off-grid",
  "Ship",
  "Demo Day",
];

const scheduleByArc = ARC_ORDER.map((arc) => ({
  arc,
  weeks: AGENTLAB_SCHEDULE.filter((s) => s.arc === arc),
})).filter((g) => g.weeks.length > 0);

// Tie each curriculum arc to its at-a-glance blurb where one exists.
const arcBlurb = new Map(AGENTLAB_ARCS.map((a) => [a.title, a.blurb]));
---

<BaseLayout noindex={true}
  title="Agent Lab — The Syllabus · Off-Grid AI · Fall 2026"
  description={AGENTLAB.blurb}
>
  <PageHeader
    index=""
    label={`${AGENTLAB.name} · ${AGENTLAB.tagline}`}
    title="Twelve Tuesdays."
    lede={AGENTLAB.lede}
    image={HERO_IMG}
    imageAlt="A class at Mars College — laptops open, an instructor at the front, AI work projected on the wall"
  />

  <!-- ============ COURSE AT A GLANCE — the 3 arcs ============ -->
  <section class="u-section u-section--tight syllabus-top">
    <div class="u-shell">
      <Eyebrow index="01" label="The course · at a glance" />
      <div class="top__grid">
        <div class="top__head">
          <h2 class="top__lead u-display">A syllabus for building agents.</h2>
          <p class="top__intro u-measure">
            Agent Lab is a 12-week online cohort on building <strong>personal AI
            agents</strong> — read like a real course, run live every Tuesday this
            fall. Three arcs carry you from your first agent to a fully off-grid
            stack you own. <em>Off-Grid AI</em> is the lineage; this is the
            coursework.
          </p>
        </div>
        <ol class="arcs">
          {AGENTLAB_ARCS.map((a) => (
            <li class="arc">
              <span class="arc__n u-index">{a.n}</span>
              <h3 class="arc__title">{a.title}</h3>
              <p class="arc__blurb">{a.blurb}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ============ THE CURRICULUM — the centerpiece ============ -->
  <section class="u-section curriculum">
    <div class="u-shell">
      <Eyebrow index="02" label="Curriculum · 12 sessions" />
      <h2 class="cur__lead u-display">Week by week.</h2>
      <p class="cur__intro u-measure">
        Every Tuesday from {AGENTLAB.cadence.replace("Tuesdays · ", "")}.
        Eleven working sessions and a Demo Day, grouped into the three arcs
        of the course.
      </p>

      <div class="units">
        {scheduleByArc.map((group) => {
          const isFinale = group.arc === "Demo Day";
          return (
            <section
              class={`unit${isFinale ? " unit--finale" : ""}`}
              aria-label={`${group.arc} sessions`}
            >
              <div class="unit__head">
                <h3 class="unit__title u-label u-label--clay">{group.arc}</h3>
                {arcBlurb.has(group.arc) && (
                  <p class="unit__blurb">{arcBlurb.get(group.arc)}</p>
                )}
              </div>
              <ol class="rows">
                {group.weeks.map((s) => (
                  <li class={`row${s.arc === "Demo Day" ? " row--finale" : ""}`}>
                    <span class="row__wk u-index">
                      {`W${String(s.week).padStart(2, "0")}`}
                    </span>
                    <span class="row__date">{s.date}</span>
                    <span class="row__title">{s.title}</span>
                  </li>
                ))}
              </ol>
            </section>
          );
        })}
      </div>

      <a href={AGENTLAB_LINKS.enroll} class="u-cta cur__cta">
        Enroll in the cohort <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <!-- ============ LOGISTICS — definition list ============ -->
  <section class="u-section is-night logistics">
    <div class="u-shell log__grid">
      <div class="log__head">
        <Eyebrow index="03" label="Logistics" />
        <h2 class="log__lead u-display">How the cohort runs.</h2>
        <p class="log__note">
          {AGENTLAB.tagline} — online, recorded, and open from anywhere.
        </p>
      </div>
      <dl class="facts">
        {AGENTLAB_FACTS.map((f) => (
          <div class="facts__row">
            <dt class="facts__k u-label">{f.k}</dt>
            <dd class="facts__v">{f.v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ============ TUITION — secondary to the curriculum ============ -->
  <section class="u-section tuition">
    <div class="u-shell">
      <Eyebrow index="04" label="Tuition · four levels" />
      <h2 class="tu__lead u-display">Four ways to take the course.</h2>
      <p class="tu__intro u-measure">
        A cumulative ladder — each level includes everything below it. Sit in for
        free, or step up as far as you like. Scholarships sit on top of every paid
        level.
      </p>
      <ol class="tiers">
        {AGENTLAB_TIERS.map((tier, i) => {
          const isFree = "free" in tier && tier.free;
          return (
            <li class={`tier${tier.featured ? " tier--featured" : ""}${isFree ? " tier--free" : ""}`}>
              <div class="tier__rail">
                <span class="tier__level u-index">{String(i).padStart(2, "0")}</span>
                <div class="tier__id">
                  <p class="tier__name u-label u-label--clay">
                    {tier.name}
                    {"abbr" in tier && tier.abbr ? <span class="tier__abbr">{tier.abbr}</span> : null}
                  </p>
                  {tier.featured && <span class="tier__flag u-label">Recommended</span>}
                </div>
                <p class="tier__price">
                  <span class="tier__amount">{tier.price}</span>
                  <span class="tier__unit">{tier.unit}</span>
                </p>
              </div>
              <div class="tier__main">
                <p class="tier__tagline">{tier.tagline}</p>
                <ul class="tier__features">
                  {tier.features.map((f) => <li>{f}</li>)}
                </ul>
                <a
                  href={AGENTLAB_LINKS.enroll}
                  class={`u-cta tier__cta${tier.featured || isFree ? "" : " u-cta--ghost"}`}
                >
                  {isFree ? "Join free" : `Enroll · ${tier.name}`}
                  <span aria-hidden="true">→</span>
                </a>
                {"link" in tier && tier.link && (
                  <a href={tier.link.href} class="tier__learn" target="_blank" rel="noopener">
                    {tier.link.label} <span aria-hidden="true">→</span>
                  </a>
                )}
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <!-- ============ GRANTS — prominent callout ============ -->
  <section class="u-section--tight" aria-label="Grants">
    <div class="u-shell">
      <div class="grants" id="grant">
        <div class="grants__text">
          <p class="grants__badge u-label">{AGENTLAB_GRANTS.badge}</p>
          <h2 class="grants__headline u-display">{AGENTLAB_GRANTS.headline}</h2>
          <p class="grants__body">{AGENTLAB_GRANTS.body}</p>
        </div>
        <a href={AGENTLAB_LINKS.grant} class="u-cta grants__cta">
          {AGENTLAB_GRANTS.cta} <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ WINTER CONNECTION ============ -->
  <section class="u-section winter">
    <div class="u-shell winter__grid">
      <div class="winter__media u-plate">
        <Image
          src={IMG_DESERT}
          alt="The off-grid Mars College village lit by warm cabin lights at night"
          widths={[600, 1000, 1400]}
          sizes="(max-width: 880px) 100vw, 45vw"
          format="webp"
          quality={72}
          loading="lazy"
        />
      </div>
      <div class="winter__text">
        <Eyebrow index="05" label={AGENTLAB_WINTER.eyebrow} />
        <h2 class="winter__lead u-display">{AGENTLAB_WINTER.headline}</h2>
        <p class="winter__body">{AGENTLAB_WINTER.body}</p>
        <a href={AGENTLAB_LINKS.winter} class="u-link">
          {AGENTLAB_WINTER.cta} <span class="u-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ SIGNUP — Tally form ============ -->
  <section id="signup" class="u-section is-night signup">
    <div class="u-shell signup__grid">
      <div class="signup__text">
        <Eyebrow index="06" label="Enroll · Demo Day Nov 24" />
        <h2 class="signup__lead u-display">Save your seat in the cohort.</h2>
        <p class="signup__intro u-measure">
          Twelve Tuesdays, one agent, and a Demo Day to ship something cool.
          Sessions are recorded and supplementary video lectures come throughout,
          all online over Discord. Reserve your place below.
        </p>
        <ul class="signup__list">
          <li>{AGENTLAB.cadence}</li>
          <li>{AGENTLAB.time}</li>
          <li>{AGENTLAB.where}</li>
        </ul>
      </div>

      <div class="signup__form">
        <p class="u-label u-label--clay signup__form-eyebrow">Save your seat</p>
        {
          TALLY_OFFGRID_FORM_ID ? (
            <iframe
              data-tally-src={`https://tally.so/embed/${TALLY_OFFGRID_FORM_ID}?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1`}
              loading="lazy"
              width="100%"
              height="600"
              frameborder="0"
              marginheight="0"
              marginwidth="0"
              title="Agent Lab signup"
            />
          ) : (
            <div class="signup__form-placeholder">
              <p class="signup__form-headline">Form coming soon.</p>
              <p>
                Email{" "}
                <a href={`mailto:${EMAIL}?subject=Agent%20Lab%20cohort`}>{EMAIL}</a>{" "}
                with subject "Agent Lab" and we'll save you a seat.
              </p>
            </div>
          )
        }
      </div>
    </div>
    <script async src="https://tally.so/widgets/embed.js"></script>
  </section>

  <style>
    /* ── course at a glance (the 3 arcs) ── */
    .top__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 6vw, 5rem); align-items: start; }
    .top__lead { font-size: var(--text-2xl); max-width: 14ch; }
    .top__intro { margin-top: 1rem; color: var(--color-ink-2); font-size: var(--text-lg); line-height: 1.5; }
    .top__intro em { color: var(--color-clay-deep); font-style: normal; font-weight: 700; }
    .top__intro strong { font-weight: 800; color: var(--color-ink); }

    .arcs { list-style: none; margin: 0; padding: 0; border-top: var(--rule-strong); }
    .arc { display: grid; grid-template-columns: 3rem 1fr; grid-template-rows: auto auto; column-gap: 1rem; padding: 1.15rem 0; border-bottom: var(--rule); }
    .arc__n { grid-row: 1 / span 2; align-self: baseline; }
    .arc__title { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.3rem, 2.4vw, 1.7rem); letter-spacing: -0.02em; }
    .arc__blurb { grid-column: 2; margin-top: 0.25rem; color: var(--color-ink-2); }
    @media (max-width: 820px) { .top__grid { grid-template-columns: 1fr; gap: 2.25rem; } }

    /* ── curriculum — the centerpiece ── */
    .cur__lead { font-size: var(--text-3xl); }
    .cur__intro { margin-top: 1rem; color: var(--color-ink-2); font-size: var(--text-lg); line-height: 1.5; }

    .units { margin-top: 2.75rem; border-top: var(--rule-strong); }
    .unit { padding: clamp(1.5rem, 3.5vw, 2.5rem) 0; border-bottom: var(--rule); }
    .unit__head { margin-bottom: 1rem; }
    .unit__title { font-size: var(--text-meta); }
    .unit__blurb { margin-top: 0.4rem; color: var(--color-ink-3); font-family: var(--font-mono); font-size: var(--text-meta); letter-spacing: 0.01em; }

    .rows { list-style: none; margin: 0; padding: 0; }
    .row { display: grid; grid-template-columns: 4rem 6rem 1fr; gap: 1rem; padding: 0.9rem 0; border-top: var(--rule); align-items: baseline; }
    .row:first-child { border-top: 0; }
    .row__wk { color: var(--color-ink-3); }
    .row__date { font-family: var(--font-mono); font-size: var(--text-meta); color: var(--color-clay); letter-spacing: 0.02em; }
    .row__title { color: var(--color-ink); font-weight: 500; line-height: 1.4; }

    /* Demo Day — the finale, visually distinguished */
    .unit--finale { background: var(--color-paper-2); margin: 0 calc(-1 * clamp(1.25rem, 4vw, 2.5rem)); padding-inline: clamp(1.25rem, 4vw, 2.5rem); border-left: 3px solid var(--color-clay); }
    .unit--finale .unit__title { color: var(--color-clay); }
    .row--finale .row__title { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.15rem, 2vw, 1.4rem); letter-spacing: -0.01em; }
    .row--finale .row__wk { color: var(--color-clay); }

    .cur__cta { margin-top: 2.5rem; }

    @media (max-width: 640px) {
      .row { grid-template-columns: 3.25rem 1fr; }
      .row__date { grid-column: 2; order: 3; margin-top: 0.1rem; }
    }

    /* ── logistics (definition list, night) ── */
    .log__grid { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(2rem, 6vw, 5rem); align-items: start; }
    .log__lead { font-size: var(--text-2xl); color: var(--color-bone-on-night); max-width: 12ch; }
    .log__note { margin-top: 1rem; color: #cabda6; line-height: 1.5; }
    .facts { margin: 0; padding: 0; border-top: 1px solid var(--color-rule-night); }
    .facts__row { display: grid; grid-template-columns: 9rem 1fr; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--color-rule-night); align-items: baseline; }
    .facts__k { color: #b7a98f !important; }
    .facts__v { color: var(--color-bone-on-night); font-size: 1.0625rem; line-height: 1.4; }
    @media (max-width: 820px) {
      .log__grid { grid-template-columns: 1fr; gap: 2rem; }
      .facts__row { grid-template-columns: 7rem 1fr; }
    }

    /* ── tuition: a calm progressive ladder of four cumulative levels ── */
    .tu__lead { font-size: var(--text-2xl); max-width: 16ch; }
    .tu__intro { margin-top: 1rem; color: var(--color-ink-2); font-size: var(--text-lg); line-height: 1.5; }
    .tiers { list-style: none; margin: 2.5rem 0 0; padding: 0; border-top: var(--rule-strong); }
    .tier {
      position: relative;
      display: grid;
      grid-template-columns: 15rem 1fr;
      gap: clamp(1.5rem, 4vw, 3.5rem);
      padding: clamp(1.5rem, 3.5vw, 2.5rem) 0;
      border-bottom: var(--rule);
    }
    /* Recommended level — highlighted with a clay rail, bled to the gutter */
    .tier--featured {
      background: var(--color-paper-2);
      margin: 0 calc(-1 * clamp(1.25rem, 4vw, 2.5rem));
      padding-inline: clamp(1.25rem, 4vw, 2.5rem);
      border-left: 3px solid var(--color-clay);
    }
    /* Free level — distinct, quieter styling */
    .tier--free .tier__amount { color: var(--color-ink-2); }

    .tier__rail { display: grid; grid-template-columns: 2.5rem 1fr; column-gap: 1rem; align-content: start; align-items: baseline; }
    .tier__level { grid-row: 1 / span 3; align-self: baseline; color: var(--color-ink-3); }
    .tier__id { grid-column: 2; }
    .tier__name { margin-bottom: 0; display: flex; align-items: center; gap: 0.55rem; flex-wrap: wrap; }
    .tier__abbr { font-family: var(--font-mono); font-size: 0.7rem; font-weight: 600; letter-spacing: 0.08em; color: var(--color-clay); border: 1px solid color-mix(in srgb, var(--color-clay) 45%, transparent); padding: 0.1rem 0.4rem; }
    .tier__flag { display: inline-block; margin-top: 0.5rem; color: var(--color-paper) !important; background: var(--color-clay); padding: 0.15rem 0.55rem; }
    .tier__price { grid-column: 2; margin-top: 0.75rem; display: flex; align-items: baseline; gap: 0.5rem; flex-wrap: wrap; }
    .tier__amount { font-family: var(--font-display); font-weight: 800; font-size: clamp(2.1rem, 4vw, 3rem); letter-spacing: -0.03em; line-height: 1; }
    .tier__unit { color: var(--color-ink-3); font-size: var(--text-meta); }

    .tier__main { display: flex; flex-direction: column; align-items: flex-start; }
    .tier__tagline { font-family: var(--font-display); font-weight: 700; font-size: 1.2rem; letter-spacing: -0.01em; }
    .tier__body { margin-top: 0.5rem; color: var(--color-ink-2); line-height: 1.5; max-width: 60ch; }
    .tier__features { list-style: none; margin: 1.1rem 0 1.6rem; padding: 0; display: grid; gap: 0.5rem; }
    .tier__features li { padding-left: 1.5rem; position: relative; color: var(--color-ink); line-height: 1.4; }
    .tier__features li::before { content: "✓"; position: absolute; left: 0; color: var(--color-clay); font-weight: 800; }
    .tier__cta { margin-top: 0.25rem; }
    .tier__learn { display: inline-block; margin-top: 1rem; font-size: var(--text-meta); color: var(--color-ink-2); text-decoration: underline; text-decoration-color: var(--color-clay); text-decoration-style: dashed; text-underline-offset: 4px; }
    .tier__learn:hover { color: var(--color-clay); }
    @media (max-width: 720px) {
      .tier { grid-template-columns: 1fr; gap: 1.25rem; }
      .tier__price { margin-top: 0.5rem; }
    }

    /* ── grants (prominent callout) ── */
    .grants { padding: clamp(1.5rem, 3vw, 2.25rem); background: var(--color-clay); color: var(--color-paper); display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
    .grants__badge { color: color-mix(in srgb, var(--color-paper) 82%, transparent) !important; margin-bottom: 0.6rem; }
    .grants__headline { font-size: clamp(1.6rem, 3.2vw, 2.4rem); color: var(--color-paper); max-width: 18ch; line-height: 1.02; }
    .grants__body { margin-top: 0.75rem; max-width: 54ch; color: color-mix(in srgb, var(--color-paper) 92%, transparent); line-height: 1.5; }
    .grants__cta { background: var(--color-paper); color: var(--color-clay-deep); border-color: var(--color-paper); flex-shrink: 0; }
    .grants__cta:hover { background: var(--color-ink); color: var(--color-paper); border-color: var(--color-ink); }

    /* ── winter ── */
    .winter__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
    .winter__media { aspect-ratio: 5 / 4; }
    .winter__lead { font-size: var(--text-2xl); max-width: 16ch; margin-top: 0.5rem; }
    .winter__body { margin-top: 1rem; color: var(--color-ink-2); font-size: var(--text-lg); line-height: 1.5; margin-bottom: 1.75rem; }
    @media (max-width: 880px) { .winter__grid { grid-template-columns: 1fr; } .winter__media { aspect-ratio: 16 / 10; } }

    /* ── signup ── */
    .signup__grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(2rem, 6vw, 5rem); align-items: start; }
    .signup__lead { font-size: clamp(1.9rem, 4vw, 3rem); color: var(--color-bone-on-night); max-width: 16ch; }
    .signup__intro { color: #cabda6; margin-top: 1rem; font-size: var(--text-lg); }
    .signup__list { list-style: none; margin: 2rem 0 0; padding: 0; border-top: 1px solid var(--color-rule-night); }
    .signup__list li { padding: 0.85rem 0 0.85rem 1.4rem; border-bottom: 1px solid var(--color-rule-night); color: var(--color-bone-on-night); position: relative; }
    .signup__list li::before { content: "→"; position: absolute; left: 0; color: var(--color-clay); font-weight: 700; }
    .signup__form { background: var(--color-bone-on-night); color: var(--color-ink); padding: clamp(1.25rem, 2.5vw, 2rem); }
    .signup__form-eyebrow { margin-bottom: 1rem; }
    .signup__form :global(iframe) { background: transparent; display: block; }
    .signup__form-headline { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.4rem, 2.4vw, 1.85rem); letter-spacing: -0.02em; margin-bottom: 0.85rem; }
    .signup__form-placeholder p:not(.signup__form-headline) { color: var(--color-ink-2); line-height: 1.55; }
    .signup__form-placeholder a { color: var(--color-clay); text-decoration: underline; text-underline-offset: 3px; }
    @media (max-width: 820px) { .signup__grid { grid-template-columns: 1fr; } }
  </style>
</BaseLayout>
