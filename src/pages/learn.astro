---
// /learn5 — derived from /learn3 with these changes:
//  · new hero image (learnheader.jpg → learn-hero.jpg), terser hero copy
//  · "Academic calendar" replaces the term-arc section's title
//  · Tracks + past-terms gallery unified into one section; each track has photos,
//    click any photo → vanilla-JS lightbox with prev/next/arrow-key navigation
//  · diminished do-ocracy/no-attendance framing; program reads as structured
//  · weekly Sun–Sat grid removed
//  · the Creative AI program section kept (Gene flagged it as good)
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Eyebrow from "../components/Eyebrow.astro";
import {
  AI_PROGRAM_REQUIREMENTS,
  AI_PROGRAM_BENEFITS,
} from "../data/learn-program";
import { APPLY_URL, EMAIL, TALLY_OFFGRID_FORM_ID } from "../data/site";

// Hero
import heroImg from "../assets/photos/learn/learn-hero.jpg";

// AI history strip (credibility section)
import aiHist2019 from "../assets/photos/learn/ai-history/2019-bbgan.png";
import aiHist2021 from "../assets/photos/learn/ai-history/2021-abraham.png";
import aiHist2022 from "../assets/photos/learn/ai-history/2022-mars-bots.jpg";
import aiHist2023 from "../assets/photos/learn/ai-history/2023-performance.jpg";
import aiHist2024 from "../assets/photos/learn/ai-history/2024-film-festival.jpg";
import aiHist2025 from "../assets/photos/learn/supp_marscollege_research-and-learn.jpg";
import aiHist2026 from "../assets/photos/learn/ai-history/2026-finals-presentation.jpg";
// Featured video for the §04 Off-Grid AI close (lives in /public).
const AI_VIDEO_SRC = "/learn-video/2025-mars-research.mp4";
const AI_VIDEO_POSTER = "/learn-video/2025-mars-research-poster.jpg";

// Pillar photos.
import pillarUnconf from "../assets/photos/learn/supp_substack_high.jpeg";
import pillarGround from "../assets/photos/night-glow.jpg";
import pillarAI from "../assets/photos/learn/supp_marscollege_marzipan-aiart.jpeg";

// Topic list inlined here (replaces AI_PROGRAM_TOPICS from shared data,
// so the candidate pages /learn1–4 are not affected by these edits).
const TOPICS = [
  {
    n: "01",
    title: "Personal AI",
    body: "A coach, digital twin, chief of staff, guardian angel, second brain. An agent that knows you and answers only to you.",
  },
  {
    n: "02",
    title: "Off-Grid AI",
    body: "Open-source, self-hosted, local models. A stack that doesn't go down when the cloud does.",
  },
  {
    n: "03",
    title: "Art with AI",
    body: "Film, music, performance, live code. AI as an instrument, not a style.",
  },
  {
    n: "04",
    title: "Earning a living",
    body: "How people using AI are making money now, and how you might.",
  },
];

// Dual program timelines used in §02 Upcoming programs.
const OFF_GRID_AI_TIMELINE = [
  { date: "Aug 31", label: "Cohort opens" },
  { date: "Sep – Nov", label: "Async tutorials and weekly lab" },
  { date: "Mid-cohort", label: "Project sprint" },
  { date: "Dec 7", label: "Final presentations" },
  { date: "Jan 4", label: "Optional crossover to the desert" },
];

const MARS_COLLEGE_TIMELINE = [
  { date: "Nov – Dec", label: "Build the village", href: "/build" },
  { date: "Jan 4", label: "Mars College begins" },
  { date: "Jan 11 – 17", label: "Ideas Week" },
  { date: "Wed nights", label: "Thunder Talks · weekly" },
  { date: "Jan · Feb · Mar", label: "Moons of Mars · 3 gallery shows" },
  { date: "Feb 13 – 15", label: "Declaration Days · midterm" },
  { date: "Mar 26 – 28", label: "Mars Electronica · finals" },
  { date: "April", label: "Unbuild" },
];

// Three-pillars block — the page's defining lines under the hero.
const PILLARS = [
  {
    n: "01",
    title: "An uncollege",
    body: "A self-organizing semester on an open calendar. Anyone in the cohort can propose and teach, and the curriculum is built each year out of what shows up.",
    img: pillarUnconf,
    alt: "Mars cohort in the dark Chiba hangar watching a projected class",
  },
  {
    n: "02",
    title: "On ground we maintain",
    body: "An off-grid campus in the desert, built and run by the people in it. The term is framed by Ideas Week, midterm, and Mars Electronica.",
    img: pillarGround,
    alt: "Off-grid village at Mars lit by warm cabin lights at night",
  },
  {
    n: "03",
    title: "Learning off-grid AI",
    body: "A program in self-aligned AI agents for art, knowledge, productivity, and commerce. Participants present final work at the AI Film Festival and Mars Electronica.",
    img: pillarAI,
    alt: "Marzipan teaching AI art at Mars — Burroughs Quotes screen with AI-generated mandala imagery",
  },
];

// AI program history — credibility strip. Captions accept inline HTML so we can
// link out to source posts, model homepages, and project pages.
const AI_HISTORY = [
  {
    year: "2019",
    img: aiHist2019,
    alt: "BBGAN — early generative AI video trained on Bombay Beach",
    captionHtml: `<a href="https://x.com/Mars_College/status/1440013890369187842" target="_blank" rel="noopener">BBGAN</a>. Early generative AI video trained on Bombay Beach.`,
  },
  {
    year: "2021",
    img: aiHist2021,
    alt: "Abraham — early Eden generative model output",
    captionHtml: `<a href="https://abraham.ai" target="_blank" rel="noopener">Abraham</a>. Early <a href="https://eden.art" target="_blank" rel="noopener">Eden</a> models trained on the cohort.`,
  },
  {
    year: "2022",
    img: aiHist2022,
    alt: "Mars Bots and Mulabonding — 2022 AI Art series, SolarPunk Strength",
    captionHtml: `<a href="https://marscollege.substack.com/p/the-fifth-element" target="_blank" rel="noopener">Mars Bots</a> and <a href="https://vault.jmill.dev/project/Mulabonding" target="_blank" rel="noopener">Mulabonding</a>. Four GPT-3 house bots and the cohort AI art they generated.`,
  },
  {
    year: "2023",
    img: aiHist2023,
    alt: "Creative AI major launched at Mars College 2023",
    captionHtml: `<a href="https://marscollege.substack.com/p/study-creative-ai-at-mars-college" target="_blank" rel="noopener">Creative AI major</a> launched.`,
  },
  {
    year: "2024",
    img: aiHist2024,
    alt: "Outdoor projection of the first AI Film Festival at Bombay Beach",
    captionHtml: `The first <a href="https://marscollege.substack.com/p/creative-ai-at-mars-college-2026" target="_blank" rel="noopener">AI Film Festival</a>, projected outdoors at Bombay Beach.`,
  },
  {
    year: "2025",
    img: aiHist2025,
    alt: "Mars Research cohort in the tiered Chiba seating, 2025",
    captionHtml: `<a href="https://marscollege.substack.com/p/ai-agents-class" target="_blank" rel="noopener">Personal agents</a> for every Martian. <a href="https://eden.art" target="_blank" rel="noopener">Eden</a> on Mars hardware.`,
  },
  {
    year: "2026",
    img: aiHist2026,
    alt: "Mars 2026 finals presentation — projected geometric diagrams between pallet-rack columns",
    captionHtml: `<a href="https://marscollege.substack.com/p/creative-ai-at-mars-college-2026" target="_blank" rel="noopener">Creative AI major</a>. Agents, films, generative radio — AI as connective tissue.`,
  },
];

// Track photos
import pClassAI from "../assets/photos/learn/004_2026_p1012535_96a9e.JPG";
import pThunderProjection from "../assets/photos/learn/002_2026_dscf1586_ece64.jpg";
import pColorClass from "../assets/photos/learn/045_2024_2026_p1036172_1.JPG";
import pMusicTheory from "../assets/photos/learn/020_2026_dscf0028_1bd1c.jpg";
import pLivecode from "../assets/photos/learn/supp_2023_livecode_tidal.jpg";
import pAlgorave from "../assets/photos/learn/supp_2023_algorave_rings.jpg";
import pCelebration from "../assets/photos/learn/050_2024_img_8542_bb32a.jpg";
import pCircle from "../assets/photos/learn/038_2022_img_4312_95dfd.jpg";
import pClayVessels from "../assets/photos/learn/supp_2022_clay_vessels.jpg";
import pClayWorkshop from "../assets/photos/learn/supp_2023_clay_workshop.jpg";
import pYogaDesert from "../assets/photos/learn/supp_2023_acroyoga_desert.jpg";
import pYogaSunset from "../assets/photos/learn/supp_2023_acroyoga_sunset.jpg";
import pYogaAerial from "../assets/photos/learn/supp_2021_aerial_yoga.jpg";
import pKitchen from "../assets/photos/learn/supp_2022_noodle_kitchen.jpg";
import pZenden from "../assets/photos/learn/supp_2022_zenden_mic.jpg";
import pWorkshopPano from "../assets/photos/learn/supp_2021_workshop_panoramic.jpg";
import pLivecodeIntro from "../assets/photos/learn/supp_2023_livecoding_intro.jpg";
import pChibaSunset from "../assets/photos/learn/supp_2023_chiba_sunset_deck.jpg";
import pOutdoorTalk from "../assets/photos/learn/013_2022_pxl_20220116_020317372_night_dd72d.jpg";
import pHangarTalk from "../assets/photos/learn/049_2022_pxl_20220116_025716120_night_55447.jpg";
import pLaptopClass from "../assets/photos/learn/001_2022_img_0517_a1dd1.jpg";
// Newly added for open-calendar gallery
import pMcLivecoding from "../assets/photos/learn/supp_marscollege_live-coding.jpg";
import pMcResearchLearn from "../assets/photos/learn/supp_marscollege_research-and-learn.jpg";
import pClaySubstack from "../assets/photos/learn/supp_substack_clay.jpeg";
import pClaySubstack2 from "../assets/photos/learn/supp_substack_clay2.jpeg";
import pClay2026Wheel from "../assets/photos/learn/supp_2026_clay_kickwheel.jpg";
import pClay2026Shelf from "../assets/photos/learn/supp_2026_clay_shelf.jpg";
import pMcMarzipanAI from "../assets/photos/learn/supp_marscollege_marzipan-aiart.jpeg";
import pMcHydroponics from "../assets/photos/learn/supp_marscollege_hydroponics.jpeg";
import pMcChibaGallery from "../assets/photos/learn/supp_marscollege_chiba-gallery.jpg";

// Open-calendar gallery — classes (indoor and outdoor), not parties.
const OPEN_CAL_PHOTOS = [
  { img: pMusicTheory, alt: "Music theory class · 2026" },
  { img: pColorClass, alt: "Evening lecture · 2024" },
  { img: pMcResearchLearn, alt: "Cohort in the tiered Chiba seating" },
  { img: pThunderProjection, alt: "Class in the Chiba hangar · 2026" },
  { img: pClaySubstack, alt: "Ceramics workshop in the hangar · 2026" },
  { img: pClaySubstack2, alt: "Ceramics circle on the desert lakebed" },
  { img: pClay2026Wheel, alt: "Throwing on the kick wheel at Tool Camp · 2026" },
  { img: pClay2026Shelf, alt: "Workshop shelf of unfired clay · 2026" },
  { img: pWorkshopPano, alt: "Workshop in the main hall · 2021" },
  { img: pMcLivecoding, alt: "Live-coding class with code on the wall" },
  { img: pLivecodeIntro, alt: "Live Coding Club intro session · 2023" },
  { img: pOutdoorTalk, alt: "Outdoor evening class · 2022" },
  { img: pYogaDesert, alt: "Acroyoga on the lake bed · 2023" },
  { img: pYogaSunset, alt: "Sunset acroyoga on the plywood deck · 2023" },
  { img: pCircle, alt: "Studio circle · 2022" },
  { img: pHangarTalk, alt: "Outdoor evening seminar · 2022" },
  { img: pLaptopClass, alt: "Workshop in the library · 2022" },
  { img: pMcMarzipanAI, alt: "Marzipan teaching AI art" },
  { img: pMcHydroponics, alt: "Hydroponics" },
  { img: pMcChibaGallery, alt: "Chiba Art Gallery" },
];

// Gallery list for the lightbox carousel.
const GALLERY = OPEN_CAL_PHOTOS.map((p, i) => ({
  img: p.img,
  alt: p.alt,
  id: `oc-${i}`,
}));

// Filter the term to IRL beats only — online cohort gets its own section.
---

<BaseLayout
  title="Learn — Mars College 2027"
  description="The Mars College academic program: a three-month off-grid term in the California desert and an off-season AI cohort online."
>
  <PageHeader
    index="02"
    label="Learn"
    title="The academic program."
    lede="A three-month off-grid term in the California desert (Jan – Mar), plus an off-season AI cohort online (Aug – Dec). What's taught, when, and how to apply."
    image={heroImg}
    imageAlt="A class in session inside the Mars College hangar — presenter at the front, hexagonal diagram projected on the wall, audience seated on tiered plywood"
  />

  <!-- ===================== THREE PILLARS ===================== -->
  <section class="u-section pillars">
    <div class="u-shell">
      <Eyebrow index="01" label="What Mars College is" />
      <ol class="pillars__list">
        {PILLARS.map((p) => (
          <li class="pillar">
            <div class="pillar__media u-plate">
              <Image
                src={p.img}
                alt={p.alt}
                widths={[400, 700, 1000]}
                sizes="(max-width: 820px) 100vw, 30vw"
                format="webp"
                quality={70}
                loading="lazy"
              />
            </div>
            <span class="pillar__n u-index">{p.n}</span>
            <h3 class="pillar__title">{p.title}</h3>
            <p class="pillar__body">{p.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ===================== UPCOMING PROGRAMS ===================== -->
  <section class="u-section compare">
    <div class="u-shell">
      <Eyebrow index="02" label="Upcoming programs" />
      <h2 class="compare__lead u-display">Two tracks: IRL and online.</h2>
      <p class="compare__intro u-measure">
        An online AI cohort in fall, an off-grid term in winter. Shared
        curriculum, shared instructors. Many people do one; some do both.
      </p>

      <div class="compare__cols">
        <article class="compare__col">
          <p class="compare__col-tag u-label">Online · Aug – Dec</p>
          <h3 class="compare__col-name u-display">Off-Grid AI</h3>
          <p class="compare__col-meta">14 weeks · Discord + Eden · ~3 hrs/week</p>
          <ol class="ptl">
            {OFF_GRID_AI_TIMELINE.map((t) => (
              <li class="ptl__item">
                <span class="ptl__date">{t.date}</span>
                <span class="ptl__label">{t.label}</span>
              </li>
            ))}
          </ol>
          <a href="#offgrid-signup" class="compare__cta u-cta">
            Sign up for Off-Grid AI <span aria-hidden="true">→</span>
          </a>
        </article>

        <article class="compare__col">
          <p class="compare__col-tag u-label">In the desert · Jan – Mar</p>
          <h3 class="compare__col-name u-display">Mars College</h3>
          <p class="compare__col-meta">3 months on-site · Bombay Beach, California</p>
          <ol class="ptl">
            {MARS_COLLEGE_TIMELINE.map((t) => (
              <li class="ptl__item">
                <span class="ptl__date">{t.date}</span>
                {t.href ? (
                  <a href={t.href} class="ptl__label ptl__label--link">{t.label}</a>
                ) : (
                  <span class="ptl__label">{t.label}</span>
                )}
              </li>
            ))}
          </ol>
          <a href="/apply" class="compare__cta u-cta">
            Apply to Mars College <span aria-hidden="true">→</span>
          </a>
        </article>
      </div>
    </div>
  </section>

  <!-- ===================== AI PROGRAM HISTORY ===================== -->
  <section class="u-section is-night aihist">
    <div class="u-shell">
      <Eyebrow index="03" label="The Mars AI program — at Mars since the beginning" />
      <h2 class="aihist__lead u-display">Seven years of building AI at Mars.</h2>
      <p class="aihist__intro u-measure" set:html={`
        The AI program dates back to before Mars College had a name. A GAN
        trained on Bombay Beach in 2019. GPT-3 bots and deepfake models
        trained on Martians by 2021. House bots and a hand-bound zine by 2022.
        The <a href="https://www.youtube.com/watch?v=ih7okZcBhEA" target="_blank" rel="noopener">first AI Film Festival</a> by 2024.
        <a href="https://marscollege.substack.com/p/ai-agents-class" target="_blank" rel="noopener">Personal agents for every Martian</a> by 2025.
        <a href="https://marscollege.substack.com/p/creative-ai-at-mars-college-2026" target="_blank" rel="noopener">Creative AI major</a> in 2026.
      `}></p>

      <ol class="aihist__strip">
        {AI_HISTORY.map((h) => (
          <li class="aiyr">
            <div class="aiyr__plate u-plate">
              <Image
                src={h.img}
                alt={h.alt}
                widths={[300, 500, 800]}
                sizes="(max-width: 720px) 50vw, 14vw"
                format="webp"
                quality={70}
                loading="lazy"
              />
            </div>
            <p class="aiyr__year u-index">{h.year}</p>
            <p class="aiyr__cap" set:html={h.captionHtml}></p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ===================== OFF-GRID AI PROGRAM ===================== -->
  <section class="u-section ai">
    <div class="u-shell">
      <Eyebrow index="04" label="Off-Grid AI" />
      <h2 class="ai__lead u-display">Outsmart the superintelligence.</h2>
      <div class="ai__intro u-measure">
        <p set:html={`
          The year is 2033. Superintelligence has taken hold of the economy.
          <a href="https://www.entrepreneur.com/business-news/ai-could-lead-to-mass-joblessness-within-the-next-5-years/496742" target="_blank" rel="noopener">Unemployment is at 90%</a>.
          <a href="https://www.inc.com/moses-jeanfrancois/san-francisco-rents-rose-by-22-percent-even-some-tech-workers-blaming-ai-boom/91351374" target="_blank" rel="noopener">Bay Area rent is $50,000 a month</a>. Sound crazy?
          It's the future
          <a href="https://fortune.com/2026/05/26/sam-altman-dario-amodei-walking-back-ai-jobs-apocalypse-prophecies-ipo/" target="_blank" rel="noopener">every frontier-AI CEO is openly predicting</a>, and the
          future <a href="https://marscollege.substack.com/p/study-creative-ai-at-mars-college" target="_blank" rel="noopener">we've been preparing for</a> since we started Mars College.
        `}></p>
        <p>
          Here are the four things every Off-Grid AI student learns to do.
        </p>
      </div>

      <ol class="ai__topics">
        {TOPICS.map((t) => (
          <li class="ai__topic">
            <span class="ai__n u-index">{t.n}</span>
            <div>
              <h3 class="ai__title">{t.title}</h3>
              <p class="ai__body">{t.body}</p>
            </div>
          </li>
        ))}
      </ol>

      <div class="ai__quotes">
        <figure class="ai__quote">
          <blockquote>"I think that AI will probably, most likely, sort of lead to the end of the world."</blockquote>
          <figcaption>
            — Sam Altman,
            <a href="https://siepr.stanford.edu/news/what-point-do-we-decide-ais-risks-outweigh-its-promise" target="_blank" rel="noopener">SIEPR / Stanford</a>
          </figcaption>
        </figure>
        <figure class="ai__quote">
          <blockquote>"There's a 25% chance that things go really, really badly."</blockquote>
          <figcaption>
            — Dario Amodei,
            <a href="https://www.axios.com/2025/09/17/anthropic-dario-amodei-p-doom-25-percent" target="_blank" rel="noopener">Axios</a>
          </figcaption>
        </figure>
      </div>

      <figure class="ai__feature">
        <video
          class="ai__video"
          src={AI_VIDEO_SRC}
          poster={AI_VIDEO_POSTER}
          controls
          playsinline
          preload="none"
          aria-label="Mars 2025 trailer"
        ></video>
      </figure>
    </div>
  </section>

  <!-- ===================== OPEN CALENDAR ===================== -->
  <section class="u-section opencal">
    <div class="u-shell">
      <Eyebrow index="05" label="Open calendar" />
      <h2 class="opencal__lead u-display">The open calendar.</h2>
      <p class="opencal__intro u-measure">
        Past terms have held creative AI, agentic coding, AI film, music theory, live coding, ceramics and clay, breadmaking, fermentation, the writers' workshop, screenwriting, yoga, Thai bodywork, acroyoga, contact improv, geometry, philosophy, solar literacy, vanlife skills, 3D printing, digital architecture, foraging, and desert ecology — and whatever else a Martian wants to teach gets added to the calendar.
      </p>

      <div class="opencal__split">
        <div>
          <p class="u-label u-label--clay">Requirements</p>
          <ul class="opencal__list">{AI_PROGRAM_REQUIREMENTS.map((r) => <li>{r}</li>)}</ul>
        </div>
        <div>
          <p class="u-label u-label--clay">Comes with</p>
          <ul class="opencal__list">{AI_PROGRAM_BENEFITS.map((b) => <li>{b}</li>)}</ul>
        </div>
      </div>

      <ul class="opencal__grid">
        {OPEN_CAL_PHOTOS.map((p, i) => (
          <li>
            <button
              type="button"
              class="opencal__cell u-plate lb"
              data-lb-id={`oc-${i}`}
              aria-label={`Open photo: ${p.alt}`}
            >
              <Image
                src={p.img}
                alt={p.alt}
                widths={[400, 700, 1000]}
                sizes="(max-width: 720px) 50vw, 22vw"
                format="webp"
                quality={68}
                loading="lazy"
              />
            </button>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ===================== OFF-SEASON COHORT ===================== -->
  <section id="offgrid-signup" class="u-section is-night cohort">
    <div class="u-shell cohort__grid">
      <div class="cohort__text">
        <Eyebrow index="06" label="The off-season cohort · Aug 31 – Dec" />
        <h2 class="cohort__lead u-display">Off-Grid AI, online.</h2>
        <p class="cohort__intro u-measure">
          Fourteen weeks of asynchronous tutorials and a weekly live lab on
          Discord. Curriculum on local and sovereign AI, agents for personal
          productivity and growth, and creative agents. People who finish the
          cohort get an inside track on the winter term in the desert.
        </p>
        <ul class="cohort__list">
          <li>~3 hrs/week · async tutorials + weekly live lab on Discord</li>
          <li>Eden compute grant for the full 14 weeks</li>
          <li>Three tiers · starts free (curriculum and labs access)</li>
        </ul>
      </div>

      <div class="cohort__form">
        <p class="u-label u-label--clay cohort__form-eyebrow">Sign up</p>
        {
          TALLY_OFFGRID_FORM_ID ? (
            <iframe
              data-tally-src={`https://tally.so/embed/${TALLY_OFFGRID_FORM_ID}?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1`}
              loading="lazy"
              width="100%"
              height="640"
              frameborder="0"
              marginheight="0"
              marginwidth="0"
              title="Off-Grid AI cohort signup"
            />
          ) : (
            <div class="cohort__form-placeholder">
              <p class="cohort__form-headline">Form coming soon.</p>
              <p>
                Until the form ships, email
                {" "}<a href={`mailto:${EMAIL}?subject=Off-Grid%20AI%20cohort`} class="cohort__form-link">{EMAIL}</a>
                {" "}with subject "Off-Grid AI cohort" and we'll save you a seat.
              </p>
            </div>
          )
        }
      </div>
    </div>
    <script async src="https://tally.so/widgets/embed.js"></script>
  </section>

  <!-- ===================== CTA ===================== -->
  <section class="u-section--tight">
    <div class="u-shell cta-band">
      <p class="cta-band__text u-display">
        Start online in August. Cross to the desert in January.
      </p>
      <a href={APPLY_URL} class="u-cta">
        Apply for 2027 <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <!-- ===================== LIGHTBOX ===================== -->
  <div
    id="lightbox"
    class="lb-box"
    role="dialog"
    aria-modal="true"
    aria-label="Photo gallery"
    hidden
  >
    <button type="button" class="lb-box__close" aria-label="Close gallery">×</button>
    <button type="button" class="lb-box__nav lb-box__nav--prev" aria-label="Previous">‹</button>
    <button type="button" class="lb-box__nav lb-box__nav--next" aria-label="Next">›</button>
    <figure class="lb-box__figure">
      <div class="lb-box__imgwrap">
        {GALLERY.map((g) => (
          <Image
            src={g.img}
            alt={g.alt}
            widths={[900, 1400, 1920]}
            sizes="(max-width: 900px) 100vw, 90vw"
            format="webp"
            quality={78}
            loading="lazy"
            data-lb-slide={g.id}
          />
        ))}
      </div>
      <figcaption class="lb-box__cap">
        <span class="lb-box__cap-text"></span>
        <span class="lb-box__cap-meta"></span>
      </figcaption>
    </figure>
  </div>

  <script is:inline>
    (() => {
      const box = document.getElementById("lightbox");
      if (!box) return;
      const slides = Array.from(box.querySelectorAll("[data-lb-slide]"));
      const capText = box.querySelector(".lb-box__cap-text");
      const capMeta = box.querySelector(".lb-box__cap-meta");
      const triggers = Array.from(document.querySelectorAll(".lb[data-lb-id]"));
      // id → index in slides
      const order = slides.map((el) => el.dataset.lbSlide);
      // For caption lookup: id → { cap, track } from data attrs on the trigger.
      const meta = {};
      triggers.forEach((t) => {
        const id = t.dataset.lbId;
        const img = t.querySelector("img");
        meta[id] = {
          cap: (img && img.alt) || "",
          track: "",
        };
      });
      let cur = 0;
      const show = (i) => {
        cur = (i + order.length) % order.length;
        slides.forEach((el, idx) => el.classList.toggle("is-active", idx === cur));
        const id = order[cur];
        const m = meta[id] || {};
        capText.textContent = m.cap || "";
        capMeta.textContent = m.track || "";
      };
      const open = (id) => {
        const idx = order.indexOf(id);
        if (idx < 0) return;
        box.hidden = false;
        document.body.style.overflow = "hidden";
        show(idx);
      };
      const close = () => {
        box.hidden = true;
        document.body.style.overflow = "";
      };
      triggers.forEach((t) => {
        t.addEventListener("click", (e) => {
          e.preventDefault();
          open(t.dataset.lbId);
        });
      });
      box.querySelector(".lb-box__close").addEventListener("click", close);
      box.querySelector(".lb-box__nav--prev").addEventListener("click", () => show(cur - 1));
      box.querySelector(".lb-box__nav--next").addEventListener("click", () => show(cur + 1));
      box.addEventListener("click", (e) => {
        if (e.target === box) close();
      });
      document.addEventListener("keydown", (e) => {
        if (box.hidden) return;
        if (e.key === "Escape") close();
        if (e.key === "ArrowLeft") show(cur - 1);
        if (e.key === "ArrowRight") show(cur + 1);
      });
    })();
  </script>

