---
// /agentlab3 — Agent Lab candidate #3: "Manifesto / sovereignty narrative".
// A bold, opinionated long-form editorial that leads with the "Off-Grid AI"
// THESIS — strong voice, narrative momentum, big type, built for cross-posting.
// All content reads from src/data/agentlab.ts (single source of truth).
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Eyebrow from "../components/Eyebrow.astro";
import { EMAIL, TALLY_OFFGRID_FORM_ID } from "../data/site";
import {
  AGENTLAB,
  AGENTLAB_TOPICS,
  AGENTLAB_SCHEDULE,
  AGENTLAB_TIERS,
  AGENTLAB_GRANTS,
  AGENTLAB_FACTS,
  AGENTLAB_WINTER,
  AGENTLAB_LINEAGE,
  AGENTLAB_LINKS,
  HERO_IMG,
  IMG_DESERT,
} from "../data/agentlab";
---

<BaseLayout noindex={true}
  title="Off-Grid AI — Agent Lab · Fall 2026"
  description={AGENTLAB.blurb}
>
  <!-- ============ HERO (dark, provocation) ============ -->
  <PageHeader
    index=""
    label={`${AGENTLAB.name} · ${AGENTLAB.season}`}
    title="Own your intelligence."
    lede={AGENTLAB.lede}
    image={HERO_IMG}
    imageAlt="A class at Mars College — laptops open, an instructor at the front, AI work projected on the wall"
  />

  <!-- ============ MANIFESTO INTRO ============ -->
  <section class="u-section manifesto">
    <div class="u-shell">
      <Eyebrow index="01" label="The thesis · Off-Grid AI" />
      <p class="manifesto__tagline u-label u-label--clay">{AGENTLAB.tagline}</p>

      <h2 class="manifesto__lead u-display">
        Intelligence is centralizing. Yours doesn't have to.
      </h2>

      <div class="manifesto__body u-measure">
        <p>
          Frontier AI is consolidating into a handful of clouds you don't own,
          can't see into, and don't control — and
          <strong>the people building it are the ones warning you</strong>. The
          power to think, decide, and earn is being rented back to us through an
          interface someone else can change or switch off.
        </p>
        <p>
          There is another path. Build an agent that answers
          <em>only to you</em> — that knows your work, makes things, earns a
          living, and ultimately runs <em>off-grid</em>: local, self-hosted,
          on hardware you control. Not a subscription to someone's
          superintelligence. Your own.
        </p>
        <p>
          That's <em>Off-Grid AI</em>. It's what <strong>Agent Lab</strong>
          teaches — twelve Tuesdays online this fall, from your first agent to a
          sovereign stack you keep.
        </p>
      </div>

      <div class="manifesto__quotes">
        <figure class="ai__quote">
          <blockquote>"There's a 25% chance that things go really, really badly."</blockquote>
          <figcaption>
            — <a href="https://www.axios.com/2025/09/17/anthropic-dario-amodei-p-doom-25-percent" target="_blank" rel="noopener">Dario Amodei</a>, Anthropic
          </figcaption>
        </figure>
        <figure class="ai__quote">
          <blockquote>"I think that AI will probably, most likely, sort of lead to the end of the world."</blockquote>
          <figcaption>
            — <a href="https://siepr.stanford.edu/news/what-point-do-we-decide-ais-risks-outweigh-its-promise" target="_blank" rel="noopener">Sam Altman</a>, OpenAI
          </figcaption>
        </figure>
      </div>
      <p class="manifesto__retort u-measure">
        The frontier labs say the quiet part out loud. Our answer isn't fear —
        it's <em>ownership</em>. Outsmart the superintelligence by building your
        own.
      </p>
    </div>
  </section>

  <!-- ============ THE TRIAD (3 topics reframed) ============ -->
  <section class="u-section triad">
    <div class="u-shell">
      <Eyebrow index="02" label="What you'll be able to do" />
      <h2 class="triad__lead u-display">Three powers you'll take home.</h2>
      <p class="triad__intro u-measure">
        Agent Lab is built around three claims — three things you'll be able to
        do for yourself by Demo Day, in order.
      </p>

      <ol class="triad__list">
        {AGENTLAB_TOPICS.map((t) => (
          <li class="claim">
            <span class="claim__n u-index">{t.n}</span>
            <h3 class="claim__title">{t.title}</h3>
            <p class="claim__body">{t.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ LINEAGE as PROOF (dark) ============ -->
  <section class="u-section is-night lineage">
    <div class="u-shell">
      <Eyebrow index="03" label="Off-Grid AI — at Mars since the beginning" />
      <h2 class="lineage__lead u-display">We've been building this since 2019.</h2>
      <p class="lineage__intro u-measure">
        This is not a thought experiment. <em>Off-Grid AI</em> has run at Mars
        since before it had a name — a GAN trained on Bombay Beach in 2019,
        GPT-3 house bots by 2022, an AI Film Festival by 2024, a personal agent
        for every Martian by 2025. Agent Lab is the next chapter of seven years
        of proof.
      </p>
      <ol class="lineage__strip">
        {AGENTLAB_LINEAGE.map((h) => (
          <li class="ly">
            <div class="ly__plate u-plate">
              <Image
                src={h.img}
                alt={h.alt}
                widths={[300, 500, 800]}
                sizes="(max-width: 720px) 50vw, 14vw"
                format="webp"
                quality={70}
                loading="lazy"
              />
            </div>
            <p class="ly__year u-index">{h.year}</p>
            <p class="ly__cap" set:html={h.captionHtml}></p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ WHAT THE COHORT IS (schedule + facts) ============ -->
  <section class="u-section cohort">
    <div class="u-shell cohort__grid">
      <div class="cohort__head">
        <Eyebrow index="04" label="The cohort · 12 Tuesdays" />
        <h2 class="cohort__lead u-display">Twelve Tuesdays. One agent.</h2>
        <p class="cohort__intro u-measure">
          A weekly live lab on Discord, recorded, plus video lectures
          throughout. No location required — the only off-grid thing you need to
          start is conviction. It ends with Demo Day.
        </p>
        <dl class="facts">
          {AGENTLAB_FACTS.map((f) => (
            <div class="facts__row">
              <dt class="facts__k u-label">{f.k}</dt>
              <dd class="facts__v">{f.v}</dd>
            </div>
          ))}
        </dl>
        <a href={AGENTLAB_LINKS.enroll} class="u-cta cohort__cta">
          Join the cohort <span aria-hidden="true">→</span>
        </a>
      </div>

      <ol class="weeks">
        {AGENTLAB_SCHEDULE.map((s) => (
          <li class={`week${s.arc === "Demo Day" ? " week--demo" : ""}`}>
            <span class="week__date">{s.date}</span>
            <span class="week__arc u-label">{s.arc}</span>
            <span class="week__title">{s.title}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ PRICING + GRANTS ============ -->
  <section class="u-section join">
    <div class="u-shell">
      <Eyebrow index="05" label="Join · four ways in" />
      <h2 class="join__lead u-display">Pick your altitude. Free to fully off-grid.</h2>
      <p class="join__intro u-measure">
        Four tiers, each building on the one before — climb the ladder from
        spectator to a fully managed agent that's yours to keep. Start free; pay
        only for as much as you want to own.
      </p>

      <!-- Scholarships — prominent, above pricing -->
      <div class="grants" id="grant">
        <div class="grants__text">
          <p class="grants__badge u-label">{AGENTLAB_GRANTS.badge}</p>
          <h3 class="grants__headline u-display">{AGENTLAB_GRANTS.headline}</h3>
          <p class="grants__body">{AGENTLAB_GRANTS.body}</p>
        </div>
        <a href={AGENTLAB_LINKS.grant} class="u-cta grants__cta">
          {AGENTLAB_GRANTS.cta} <span aria-hidden="true">→</span>
        </a>
      </div>

      <ol class="tiers">
        {AGENTLAB_TIERS.map((tier, i) => {
          const isFree = "free" in tier && tier.free;
          return (
            <li class={`tier${tier.featured ? " tier--featured" : ""}${isFree ? " tier--free" : ""}`}>
              {tier.featured && <span class="tier__flag u-label">Recommended</span>}
              <span class="tier__rung u-index" aria-hidden="true">{`0${i + 1}`}</span>
              <p class="tier__name u-label u-label--clay">{tier.name}</p>
              <p class="tier__price">
                <span class="tier__amount">{tier.price}</span>
                <span class="tier__unit">{tier.unit}</span>
              </p>
              <p class="tier__tagline">
                {tier.tagline}
                {"abbr" in tier && tier.abbr ? <span class="tier__abbr">{tier.abbr}</span> : null}
              </p>
              <ul class="tier__features">
                {tier.features.map((f) => <li>{f}</li>)}
              </ul>
              <a
                href={AGENTLAB_LINKS.enroll}
                class={`u-cta tier__cta${tier.featured || isFree ? "" : " u-cta--ghost"}`}
              >
                {isFree ? "Join free" : `Enroll · ${tier.name}`} <span aria-hidden="true">→</span>
              </a>
              {"link" in tier && tier.link && (
                <a href={tier.link.href} class="tier__learn" target="_blank" rel="noopener">
                  {tier.link.label} <span aria-hidden="true">→</span>
                </a>
              )}
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <!-- ============ WINTER — the next chapter ============ -->
  <section class="u-section winter">
    <div class="u-shell winter__grid">
      <div class="winter__media u-plate">
        <Image
          src={IMG_DESERT}
          alt="The off-grid Mars College village lit by warm cabin lights at night"
          widths={[600, 1000, 1400]}
          sizes="(max-width: 880px) 100vw, 45vw"
          format="webp"
          quality={72}
          loading="lazy"
        />
      </div>
      <div class="winter__text">
        <Eyebrow index="06" label={AGENTLAB_WINTER.eyebrow} />
        <h2 class="winter__lead u-display">{AGENTLAB_WINTER.headline}</h2>
        <p class="winter__body">{AGENTLAB_WINTER.body}</p>
        <a href={AGENTLAB_LINKS.winter} class="u-link">
          {AGENTLAB_WINTER.cta} <span class="u-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ CLOSING CTA + SIGNUP (dark) ============ -->
  <section id="signup" class="u-section is-night signup">
    <div class="u-shell">
      <div class="signup__band">
        <Eyebrow index="07" label="Sign up · Demo Day Nov 24" />
        <h2 class="signup__lead u-display">Stop renting your intelligence.</h2>
        <p class="signup__intro u-measure">
          Twelve weeks from now you'll have an agent that's yours — and the
          skills to keep it that way. It's online over Discord, every session
          recorded, with lectures throughout. Save your seat.
        </p>
      </div>

      <div class="signup__grid">
        <ul class="signup__list">
          <li>{AGENTLAB.cadence}</li>
          <li>{AGENTLAB.time}</li>
          <li>{AGENTLAB.where}</li>
          <li>Ends with Demo Day — do something cool with your agent</li>
        </ul>

        <div class="signup__form">
          <p class="u-label u-label--clay signup__form-eyebrow">Save your seat</p>
          {
            TALLY_OFFGRID_FORM_ID ? (
              <iframe
                data-tally-src={`https://tally.so/embed/${TALLY_OFFGRID_FORM_ID}?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1`}
                loading="lazy"
                width="100%"
                height="600"
                frameborder="0"
                marginheight="0"
                marginwidth="0"
                title="Agent Lab signup"
              />
            ) : (
              <div class="signup__form-placeholder">
                <p class="signup__form-headline">Form coming soon.</p>
                <p>
                  Email{" "}
                  <a href={`mailto:${EMAIL}?subject=Agent%20Lab%20cohort`}>{EMAIL}</a>{" "}
                  with subject "Agent Lab" and we'll save you a seat.
                </p>
              </div>
            )
          }
        </div>
      </div>
    </div>
    <script async src="https://tally.so/widgets/embed.js"></script>
  </section>

  <style>
    /* ── manifesto intro ── */
    .manifesto__tagline { display: block; margin-bottom: 0.75rem; }
    .manifesto__lead { font-size: var(--text-3xl); max-width: 18ch; }
    .manifesto__body { margin-top: 1.5rem; font-size: var(--text-lg); line-height: 1.5; color: var(--color-ink-2); }
    .manifesto__body p + p { margin-top: 1.1rem; }
    .manifesto__body em { color: var(--color-clay-deep); font-style: normal; font-weight: 700; }
    .manifesto__body strong { color: var(--color-ink); font-weight: 800; }

    .manifesto__quotes { margin-top: 3rem; display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.5rem, 4vw, 3rem); }
    .ai__quote { margin: 0; padding: 0.25rem 0 0.25rem 1.25rem; border-left: 2px solid var(--color-clay); max-width: 48ch; }
    .ai__quote blockquote { margin: 0; font-family: var(--font-display); font-weight: 600; font-size: clamp(1.15rem, 2vw, 1.4rem); line-height: 1.35; color: var(--color-ink); letter-spacing: -0.01em; }
    .ai__quote figcaption { margin-top: 0.75rem; font-size: var(--text-meta); letter-spacing: 0.06em; color: var(--color-ink-3); }
    .ai__quote figcaption a { color: var(--color-clay); text-decoration: none; border-bottom: 1px solid color-mix(in srgb, var(--color-clay) 50%, transparent); padding-bottom: 1px; }
    .ai__quote figcaption a:hover { color: var(--color-clay-deep); border-color: var(--color-clay-deep); }
    .manifesto__retort { margin-top: 2.25rem; font-family: var(--font-display); font-weight: 700; font-size: clamp(1.4rem, 3vw, 2.1rem); letter-spacing: -0.02em; line-height: 1.1; color: var(--color-ink); }
    .manifesto__retort em { color: var(--color-clay); font-style: normal; }
    @media (max-width: 720px) { .manifesto__quotes { grid-template-columns: 1fr; } }

    /* ── triad ── */
    .triad__lead { font-size: var(--text-3xl); max-width: 16ch; }
    .triad__intro { margin-top: 1rem; color: var(--color-ink-2); font-size: var(--text-lg); line-height: 1.5; margin-bottom: 2.5rem; }
    .triad__list { list-style: none; margin: 0; padding: 0; border-top: var(--rule-strong); display: grid; grid-template-columns: repeat(3, 1fr); }
    .claim { padding: 2rem clamp(1rem, 2.5vw, 2rem) 2rem 0; border-bottom: var(--rule); }
    .claim + .claim { border-left: var(--rule); padding-left: clamp(1.5rem, 2.5vw, 2.5rem); }
    .claim__n { display: block; margin-bottom: 0.85rem; }
    .claim__title { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.5rem, 2.6vw, 2.1rem); letter-spacing: -0.02em; line-height: 1.02; max-width: 12ch; }
    .claim__body { margin-top: 0.75rem; color: var(--color-ink-2); line-height: 1.5; }
    @media (max-width: 820px) {
      .triad__list { grid-template-columns: 1fr; }
      .claim { padding: 1.5rem 0; }
      .claim + .claim { border-left: 0; padding-left: 0; }
    }

    /* ── lineage (dark, proof) ── */
    .lineage__lead { font-size: var(--text-3xl); color: var(--color-bone-on-night); max-width: 16ch; }
    .lineage__intro { margin-top: 1rem; color: #cabda6; font-size: var(--text-lg); line-height: 1.5; margin-bottom: 2.5rem; }
    .lineage__intro em { color: var(--color-clay); font-style: normal; font-weight: 700; }
    .lineage__strip { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(7, 1fr); gap: clamp(0.6rem, 1.2vw, 1rem); }
    .ly { display: flex; flex-direction: column; gap: 0.5rem; }
    .ly__plate { aspect-ratio: 3 / 4; background: var(--color-night); border: 1px solid var(--color-rule-night); }
    .ly__plate :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .ly__year { color: var(--color-clay); }
    .ly__cap { color: #d2c5af; font-size: 0.8125rem; line-height: 1.4; }
    .ly__cap :global(a) { color: var(--color-bone-on-night); text-decoration: none; border-bottom: 1px solid color-mix(in srgb, var(--color-clay) 65%, transparent); padding-bottom: 1px; transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out); }
    .ly__cap :global(a:hover) { color: var(--color-clay); border-color: var(--color-clay); }
    @media (max-width: 1100px) { .lineage__strip { grid-template-columns: repeat(4, 1fr); } }
    @media (max-width: 720px) { .lineage__strip { grid-template-columns: repeat(2, 1fr); } }

    /* ── cohort (schedule + facts) ── */
    .cohort__grid { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(2rem, 6vw, 5rem); align-items: start; }
    .cohort__lead { font-size: var(--text-3xl); max-width: 12ch; }
    .cohort__intro { margin-top: 1rem; color: var(--color-ink-2); font-size: var(--text-lg); line-height: 1.5; }
    .cohort__cta { margin-top: 2rem; }
    .facts { margin: 2rem 0 0; padding: 0; border-top: var(--rule); }
    .facts__row { display: grid; grid-template-columns: 7rem 1fr; gap: 1rem; padding: 0.85rem 0; border-bottom: var(--rule); align-items: baseline; }
    .facts__k { color: var(--color-ink-3); }
    .facts__v { color: var(--color-ink); font-size: 1.0625rem; line-height: 1.4; }
    .weeks { list-style: none; margin: 0; padding: 0; border-top: var(--rule-strong); }
    .week { display: grid; grid-template-columns: 4.5rem 9rem 1fr; gap: 1rem; padding: 0.95rem 0; border-bottom: var(--rule); align-items: baseline; }
    .week__date { font-family: var(--font-mono); font-size: var(--text-meta); color: var(--color-clay); }
    .week__title { color: var(--color-ink); font-weight: 500; line-height: 1.35; }
    .week--demo { background: var(--color-paper-2); }
    .week--demo .week__title { font-weight: 800; font-family: var(--font-display); letter-spacing: -0.01em; }
    @media (max-width: 880px) { .cohort__grid { grid-template-columns: 1fr; gap: 2.5rem; } }
    @media (max-width: 560px) {
      .week { grid-template-columns: 4rem 1fr; }
      .week__arc { grid-column: 2; order: 3; margin-top: 0.15rem; }
    }

    /* ── join: grants + tiers ── */
    .join__lead { font-size: var(--text-3xl); max-width: 18ch; }
    .join__intro { margin-top: 1rem; color: var(--color-ink-2); font-size: var(--text-lg); line-height: 1.5; }
    .grants { margin: 2.25rem 0 2.75rem; padding: clamp(1.5rem, 3vw, 2.25rem); background: var(--color-clay); color: var(--color-paper); display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
    .grants__badge { color: color-mix(in srgb, var(--color-paper) 82%, transparent) !important; margin-bottom: 0.6rem; }
    .grants__headline { font-size: clamp(1.6rem, 3.2vw, 2.4rem); color: var(--color-paper); max-width: 18ch; line-height: 1.02; }
    .grants__body { margin-top: 0.75rem; max-width: 54ch; color: color-mix(in srgb, var(--color-paper) 92%, transparent); line-height: 1.5; }
    .grants__cta { background: var(--color-paper); color: var(--color-clay-deep); border-color: var(--color-paper); flex-shrink: 0; }
    .grants__cta:hover { background: var(--color-ink); color: var(--color-paper); border-color: var(--color-ink); }

    /* The ladder: four cumulative rungs, free → full service. */
    .tiers { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(0.85rem, 1.6vw, 1.25rem); align-items: stretch; }
    .tier { position: relative; display: flex; flex-direction: column; padding: clamp(1.25rem, 1.8vw, 1.75rem); border: var(--rule); background: var(--color-paper); }
    .tier--free { background: var(--color-paper-2); border-style: dashed; }
    .tier--featured { border: 2px solid var(--color-clay); background: var(--color-paper-2); }
    .tier__flag { position: absolute; top: -0.7rem; left: clamp(1.25rem, 1.8vw, 1.75rem); background: var(--color-clay); color: var(--color-paper) !important; padding: 0.2rem 0.6rem; }
    .tier__rung { position: absolute; top: 1rem; right: 1.1rem; opacity: 0.65; }
    .tier__name { margin-bottom: 0.65rem; padding-right: 2rem; }
    .tier__price { display: flex; align-items: baseline; gap: 0.4rem; flex-wrap: wrap; }
    .tier__amount { font-family: var(--font-display); font-weight: 800; font-size: clamp(2rem, 3.2vw, 2.75rem); letter-spacing: -0.03em; line-height: 1; }
    .tier--free .tier__amount { color: var(--color-clay); }
    .tier__unit { color: var(--color-ink-3); font-size: var(--text-meta); }
    .tier__tagline { margin-top: 0.75rem; font-family: var(--font-display); font-weight: 700; font-size: 1.125rem; letter-spacing: -0.01em; display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
    .tier__abbr { font-family: var(--font-mono); font-size: 0.7rem; font-weight: 600; letter-spacing: 0.08em; color: var(--color-clay); border: 1px solid color-mix(in srgb, var(--color-clay) 45%, transparent); padding: 0.1rem 0.4rem; }
    .tier__body { margin-top: 0.65rem; color: var(--color-ink-2); line-height: 1.45; font-size: var(--text-sm); }
    .tier__features { list-style: none; margin: 1rem 0 1.5rem; padding: 0; display: grid; gap: 0.45rem; }
    .tier__features li { padding-left: 1.4rem; position: relative; color: var(--color-ink); line-height: 1.35; font-size: var(--text-sm); }
    .tier__features li::before { content: "✓"; position: absolute; left: 0; color: var(--color-clay); font-weight: 800; }
    .tier__cta { margin-top: auto; align-self: flex-start; }
    .tier__learn { display: inline-block; margin-top: 0.85rem; font-size: var(--text-meta); color: var(--color-ink-2); text-decoration: underline; text-decoration-color: var(--color-clay); text-decoration-style: dashed; text-underline-offset: 4px; }
    .tier__learn:hover { color: var(--color-clay); }
    @media (max-width: 980px) { .tiers { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 540px) { .tiers { grid-template-columns: 1fr; } }

    /* ── winter ── */
    .winter__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
    .winter__media { aspect-ratio: 5 / 4; }
    .winter__lead { font-size: var(--text-3xl); max-width: 16ch; margin-top: 0.5rem; }
    .winter__body { margin-top: 1rem; color: var(--color-ink-2); font-size: var(--text-lg); line-height: 1.5; margin-bottom: 1.75rem; }
