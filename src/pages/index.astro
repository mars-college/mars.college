---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Eyebrow from "../components/Eyebrow.astro";
import { PILLARS, HOME_FAQ } from "../data/site";

// FAQPage structured data — mirrors the on-page FAQ so answer engines can
// extract it directly.
// A @graph so one script carries both the FAQ and the season's public event.
const faqLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "FAQPage",
      mainEntity: HOME_FAQ.map((item) => ({
        "@type": "Question",
        name: item.q,
        acceptedAnswer: { "@type": "Answer", text: item.a },
      })),
    },
    {
      "@type": "Event",
      name: "Mars Electronica 2027",
      description:
        "Mars College's end-of-season exhibition: gallery openings, performances, final presentations, and the Mars AI Film Festival.",
      startDate: "2027-03-26",
      endDate: "2027-03-28",
      eventStatus: "https://schema.org/EventScheduled",
      eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
      location: {
        "@type": "Place",
        name: "Mars College",
        address: {
          "@type": "PostalAddress",
          addressLocality: "Bombay Beach",
          addressRegion: "CA",
          addressCountry: "US",
        },
      },
      organizer: { "@type": "Organization", name: "Mars College", url: "https://mars.college" },
    },
  ],
};

// Pillar plates — the five ways into Mars
import buildImg from "../assets/photos/build-curated/041_2026_20260130_170446_06ab8.jpg";
import decCardImg from "../assets/photos/dec-card.png"; // 3D-printer tinkering in the workshop
import learnImg from "../assets/photos/learn-workshop.jpg";
import colabImg from "../assets/photos/community-group.jpg";
import mmaImg from "../assets/photos/mma-card.jpg"; // band on the pallet-rack stage in Chiba

// Year-by-year aerials of the Mars campus / Chiba, 2020–2026.
import chiba2020 from "../assets/photos/chiba-years/chiba-2020.jpg";
import chiba2021 from "../assets/photos/chiba-years/chiba-2021.jpg";
import chiba2022 from "../assets/photos/chiba-years/chiba-2022-village.jpg";
import chiba2023 from "../assets/photos/chiba-years/chiba-2023.jpg";
import chiba2024 from "../assets/photos/chiba-years/chiba-2024.jpg";
import chiba2025 from "../assets/photos/chiba-years/chiba-2025.jpg";
import chiba2026 from "../assets/photos/chiba-years/chiba-2026.jpg";

// "Mars is hard" — the elements and the DIY of off-grid life.
import hardDust from "../assets/photos/marshard/dust.jpg";
import hardBuild from "../assets/photos/marshard/build.jpg";
import hardKitchen from "../assets/photos/marshard/kitchen.jpg";
import hardPower from "../assets/photos/marshard/power.jpg";
import hardWater from "../assets/photos/marshard/water.jpg";
import hardHeavy from "../assets/photos/marshard/heavy-forklift.jpg";

// Open calendar (moved from /learn): classes anyone can teach.
import pMusicTheory from "../assets/photos/learn/020_2026_dscf0028_1bd1c.jpg";
import pPortal2020 from "../assets/photos/learn/mc_crt-installation.jpg";
import pMcResearchLearn from "../assets/photos/learn/supp_marscollege_research-and-learn.jpg";
import pThunderProjection from "../assets/photos/learn/002_2026_dscf1586_ece64.jpg";
import pClaySubstack from "../assets/photos/learn/supp_substack_clay.jpeg";
import pClaySubstack2 from "../assets/photos/learn/supp_substack_clay2.jpeg";
import pClay2026Wheel from "../assets/photos/learn/supp_2026_clay_kickwheel.jpg";
import pClay2026Shelf from "../assets/photos/learn/supp_2026_clay_shelf.jpg";
import pWedding2022 from "../assets/photos/learn/mc_community-gathering.jpg";
import pMcLivecoding from "../assets/photos/learn/supp_marscollege_live-coding.jpg";
import pLivecodeIntro from "../assets/photos/learn/supp_2023_livecoding_intro.jpg";
import pForest2020 from "../assets/photos/learn/mc_geodesic-dome.jpg";
import pYogaDesert from "../assets/photos/learn/supp_2023_acroyoga_desert.jpg";
import pYogaClass2020 from "../assets/photos/learn/mc_yoga-class.jpg";
import pGym from "../assets/photos/learn/supp_2022_outdoor_gym.jpg";
import pHangarTalk from "../assets/photos/learn/049_2022_pxl_20220116_025716120_night_55447.jpg";
import pLaptopClass from "../assets/photos/learn/001_2022_img_0517_a1dd1.jpg";
import pMcMarzipanAI from "../assets/photos/learn/supp_marscollege_marzipan-aiart.jpeg";
import pMcHydroponics from "../assets/photos/learn/supp_marscollege_hydroponics.jpeg";
import pMcChibaGallery from "../assets/photos/learn/supp_marscollege_chiba-gallery.jpg";

const pillarImg: Record<string, any> = {
  DPW: buildImg,
  DEC: decCardImg,
  MIT: learnImg,
  "Co Lab": colabImg,
  MMA: mmaImg,
};

// One image per winter — the campus (and Chiba) rebuilt new each year.
const CHIBA_YEARS = [
  { year: "2020", img: chiba2020, cap: "The Portal, Mars's first structure" },
  { year: "2021", img: chiba2021, cap: "The first pallet-rack build rising on the open lake bed" },
  { year: "2022", img: chiba2022, cap: "The village strung along the lake bed below the desert mountains, murals and solar going up" },
  { year: "2023", img: chiba2023, cap: "Chiba under construction, solar panels going up" },
  { year: "2024", img: chiba2024, cap: "The village spread across the playa" },
  { year: "2025", img: chiba2025, cap: "Chiba and the surrounding camp" },
  { year: "2026", img: chiba2026, cap: "The muraled Chiba hall and the village ring" },
];

// Open-calendar gallery — mostly classes (indoor and outdoor), plus a few
// community moments (the 2022 wedding, the 2020 Portal and forest builds).
const OPEN_CAL_PHOTOS = [
  { img: pMusicTheory, alt: "Music theory class · 2026" },
  { img: pPortal2020, alt: "The Portal · 2020" },
  { img: pMcResearchLearn, alt: "Thunder talks are a weekly tradition that brings the whole community together." },
  { img: pThunderProjection, alt: "Watching thunder talks · 2026" },
  { img: pClaySubstack, alt: "Ceramics workshop at the Department of Emergent Civilization · 2026" },
  { img: pClaySubstack2, alt: "Ceramics circle on the desert lakebed" },
  { img: pClay2026Wheel, alt: "Throwing on the kick wheel at the Department of Emergent Civilization · 2026" },
  { img: pClay2026Shelf, alt: "Workshop shelf of unfired clay · 2026" },
  { img: pWedding2022, alt: "A wedding on Mars · 2022" },
  { img: pMcLivecoding, alt: "Live coders algo raving in 2024" },
  { img: pLivecodeIntro, alt: "Live Coding Club intro session · 2023" },
  { img: pForest2020, alt: "The forest · 2020" },
  { img: pYogaDesert, alt: "Acroyoga on the lake bed · 2023" },
  { img: pYogaClass2020, alt: "Yoga class · 2020" },
  { img: pGym, alt: "Outdoor gym on the playa · 2022" },
  { img: pHangarTalk, alt: "Outdoor evening seminar · 2022" },
  { img: pLaptopClass, alt: "Digital architecture class in the library · 2022" },
  { img: pMcMarzipanAI, alt: "Marzipan teaching AI art" },
  { img: pMcHydroponics, alt: "Hydroponics" },
  { img: pMcChibaGallery, alt: "Chiba Art Gallery" },
];

// Gallery list for the lightbox carousel.
const OC_GALLERY = OPEN_CAL_PHOTOS.map((p, i) => ({
  img: p.img,
  alt: p.alt,
  id: `oc-${i}`,
}));

// Year-by-year aerials also open in the lightbox (bigger view).
const VIL_GALLERY = CHIBA_YEARS.map((y, i) => ({
  img: y.img,
  alt: `${y.year} · ${y.cap}`,
  id: `vil-${i}`,
}));

// "Outsmart the superintelligence" — copied verbatim from /learn (Off-Grid AI).
const AI_VIDEO_SRC = "/learn-video/2025-mars-research.mp4";
const AI_VIDEO_POSTER = "/learn-video/2025-mars-research-poster.jpg";
const TOPICS = [
  {
    n: "01",
    title: "Sovereign AI",
    body: "Your coach, digital twin, chief of staff, guardian angel, or second brain. A local, open-source, self-hosted AI that answers only to you and supports your living, not the reverse.",
  },
  {
    n: "02",
    title: "Art with AI",
    body: "Film, music, performance, live code. AI as an instrument, not a cliche.",
  },
  {
    n: "03",
    title: "Earning a living",
    body: "How people using AI are making money now, and how you might.",
  },
];

// "Mars is hard" — a representative spread of off-grid life.
const HARD_PHOTOS = [
  { img: hardDust, cap: "Beat the elements", alt: "Two Martians out in a desert dust storm" },
  { img: hardBuild, cap: "Raise the racks", alt: "The crew assembling a pallet-rack structure at golden hour" },
  { img: hardKitchen, cap: "Feed the Martians", alt: "The 2026 camp kitchen at night, cooking and serving under string lights" },
  { img: hardPower, cap: "Electrify the village", alt: "The camp battery bank and inverter" },
  { img: hardWater, cap: "Water the desert", alt: "An IBC water tank hauled on a trailer" },
  { img: hardHeavy, cap: "Sculpt the Earth", alt: "A forklift parked by a half-built pallet-rack structure on the desert lake bed during the build" },
];
---

<BaseLayout
  title="Mars College — Off-grid college in the California desert"
  description="An annual pop-up off-grid college town cultivating the low-cost, high-tech lifestyle. Join us in 2027!"
  preloadImage="/video/mars-current-hero-poster.webp"
  jsonLd={faqLd}
>
  <Hero />

  <!-- ===================== THE VILLAGE, YEAR BY YEAR ===================== -->
  <section id="village" class="u-section village">
    <div class="u-shell village__head">
      <Eyebrow index="01" label="Seven years and counting" />
      <h2 class="village__lead u-display">An uncollege in the desert</h2>
      <p class="village__lede">
        Every winter since 2020, Mars College builds a temporary off-grid campus on
        a dry lake bed by the Salton Sea, near Bombay Beach, California. It's
        assembled mostly by-hand from pallet racks and plywood, powered by solar,
        with water, internet, and the other camp services figured out together, from
        first principles. For three months it runs like a full college town: classes,
        art, events, a co-op gallery, a film festival, and whatever else Martians come
        up with while we're there. Each spring it's torn down and the desert is left
        empty as it was found, until next year when we renew it again. Each season of
        Martians brings a new and unpredictable cohort: every age, nationality,
        background, and skill, all here for reasons of their own.
      </p>
    </div>
    <ol class="village__row">
      {
        CHIBA_YEARS.map((y, i) => (
          <li class="village__cell">
            <p class="village__year">{y.year}</p>
            <button
              type="button"
              class="village__plate u-plate lb"
              data-lb-id={`vil-${i}`}
              aria-label={`Enlarge aerial of Mars ${y.year}`}
            >
              <Image
                src={y.img}
                alt={`${y.year} · ${y.cap}`}
                widths={[400, 700, 1100]}
                sizes="(max-width: 640px) 50vw, (min-width: 641px) 33vw"
                format="webp"
                quality={64}
                loading="lazy"
              />
            </button>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- ===================== AN UNCOLLEGE ===================== -->
  <section class="u-section opencal">
    <div class="u-shell">
      <Eyebrow index="02" label="Life on Mars" />
      <h2 class="opencal__lead u-display">Everyone teaches, everyone learns</h2>
      <div class="opencal__intro u-measure">
        <p>
          Mars runs on an open calendar. Past terms have included creative AI, vibe
          coding, filmmaking, music theory, ceramics and clay, breadmaking,
          fermentation, creative writing, screenwriting, yoga, acroyoga, Thai
          bodywork, contact improv, geometry, philosophy, solar power literacy,
          vanlife skills, 3D printing, digital architecture, foraging, desert
          ecology, and much more.
        </p>
        <p>
          The end of the term is marked by a tradition we call Mars Electronica, a
          final week celebrating our work, which includes a film festival, art
          exhibition, and presentations for locals and Martians alike.
        </p>
      </div>

      <ul class="opencal__grid">
        {OPEN_CAL_PHOTOS.map((p, i) => (
          <li>
            <button
              type="button"
              class="opencal__cell u-plate lb"
              data-lb-id={`oc-${i}`}
              aria-label={`Open photo: ${p.alt}`}
            >
              <Image
                src={p.img}
                alt={p.alt}
                widths={[400, 700, 1000]}
                sizes="(max-width: 720px) 50vw, 22vw"
                format="webp"
                quality={62}
                loading="lazy"
              />
            </button>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ OUTSMART THE SUPERINTELLIGENCE (dark) ============ -->
  <section class="u-section is-night ai">
    <div class="u-shell">
      <Eyebrow index="03" label="Mars Institute of Technology (MIT)" />
      <h2 class="ai__lead u-display">Outsmart the superintelligence.</h2>
      <div class="ai__intro u-measure">
        <p set:html={`
          The year is 2033. <a href="https://www.anthropic.com/institute/recursive-self-improvement" target="_blank" rel="noopener">Recursively self-improving AGI</a> has taken hold of the economy.
          <a href="https://www.entrepreneur.com/business-news/ai-could-lead-to-mass-joblessness-within-the-next-5-years/496742" target="_blank" rel="noopener">Unemployment is at 90%</a>.
          <a href="https://www.inc.com/moses-jeanfrancois/san-francisco-rents-rose-by-22-percent-even-some-tech-workers-blaming-ai-boom/91351374" target="_blank" rel="noopener">Bay Area rent is $50,000 a month</a>. Sound crazy?
          It's the future
          <a href="https://fortune.com/2026/05/26/sam-altman-dario-amodei-walking-back-ai-jobs-apocalypse-prophecies-ipo/" target="_blank" rel="noopener">every frontier-AI CEO is openly predicting</a>, and the
          future <a href="https://marscollege.substack.com/p/study-creative-ai-at-mars-college" target="_blank" rel="noopener">we've been preparing for</a> since we started Mars College.
        `}></p>
        <p>
          Against the backdrop of impending societal collapse, we are studying what we
          call "off-grid AI engineering", the art of being a human in an AI-dominated
          world.
        </p>
      </div>

      <div class="ai__quotes">
        <figure class="ai__quote">
          <blockquote>"I think that AI will probably, most likely, sort of lead to the end of the world."</blockquote>
          <figcaption>
            — <a href="https://siepr.stanford.edu/news/what-point-do-we-decide-ais-risks-outweigh-its-promise" target="_blank" rel="noopener">Sam Altman</a>
          </figcaption>
        </figure>
        <figure class="ai__quote">
          <blockquote>"There's a 25% chance that things go really, really badly."</blockquote>
          <figcaption>
            — <a href="https://www.axios.com/2025/09/17/anthropic-dario-amodei-p-doom-25-percent" target="_blank" rel="noopener">Dario Amodei</a>
          </figcaption>
        </figure>
      </div>

      <figure class="ai__feature">
        <video
          class="ai__video"
          src={AI_VIDEO_SRC}
          poster={AI_VIDEO_POSTER}
          controls
          playsinline
          preload="none"
          aria-label="Mars 2025 trailer"
        ></video>
      </figure>

      <h2 class="ai__lead ai__lead--b u-display">Learn Off-Grid AI engineering</h2>
      <p class="ai__subhead u-measure">
        Here are the things every Off-Grid AI engineer learns to do at the Mars
        Institute of Technology (MIT).
      </p>
      <ol class="ai__topics">
        {TOPICS.map((t) => (
          <li class="ai__topic">
            <span class="ai__n u-index">{t.n}</span>
            <div>
              <h3 class="ai__title">{t.title}</h3>
              <p class="ai__body">{t.body}</p>
            </div>
          </li>
        ))}
      </ol>
      <a href="/mit" class="u-cta ai__enroll">
        Enroll in the Mars Institute of Technology <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <!-- ============ MARS IS HARD ============ -->
  <section id="hard" class="u-section marshard">
    <div class="u-shell">
      <Eyebrow index="04" label="Off-grid reality" />
      <h2 class="marshard__lead u-display">Help build Mars.</h2>
      <div class="marshard__intro u-measure">
        <p>
          Mars takes work. Wind, sun, and dust are constant, and nothing here comes
          ready-made. Food storage, power, internet, water, and waste, things usually
          taken for granted, all get worked out from first principles by Martians
          every year.
        </p>
        <p>
          Enter the <strong><a href="https://dpw.mars.college" data-goatcounter-click="outbound-dpw-intro" data-goatcounter-title="DPW (Help build Mars intro)">Mars Department of Public Works</a></strong>.
          DPW is the crew that builds and runs every physical system at Mars: power,
          water, shelter, gear. They arrive in November to bare desert and hand the
          village over to everybody else the first Monday of January. DPW members
          get housing for the season, meals, and the general Mars fee waived.
        </p>
        <p>
          There's deep expertise on the ground for every piece of it, and people who
          love to teach it. You don't have to arrive knowing how any of it works. You
          just have to come with an open mind, and a willingness to help.
        </p>
      </div>

      <ul class="marshard__grid">
        {HARD_PHOTOS.map((p) => (
          <li class="marshard__cell u-plate">
            <Image
              src={p.img}
              alt={p.alt}
              widths={[400, 700, 1000]}
              sizes="(max-width: 720px) 50vw, 33vw"
              format="webp"
              quality={62}
              loading="lazy"
            />
            <figcaption class="marshard__cap u-label">{p.cap}</figcaption>
          </li>
        ))}
      </ul>

      <div class="marshard__cta">
        <a
          href="https://dpw.mars.college"
          class="u-cta"
          data-goatcounter-click="outbound-dpw-cta"
          data-goatcounter-title="Apply to DPW (Help build Mars)"
        >
          Apply to the Mars Department of Public Works
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ===================== APPLY HERO ===================== -->
  <section id="apply" class="u-section is-night pillars">
    <div class="u-shell pillars__head">
      <Eyebrow index="05" label="Five ways into Mars College" />
      <h2 class="pillars__lead u-display">Apply to Mars College.</h2>
      <p class="pillars__intro u-measure">
        Joining Mars starts with applying to one of the camps or
        <a href="mailto:info@mars.college" class="pillars__inline">proposing a new one</a>.
      </p>
    </div>
    <div class="u-shell">
      <ol class="pillars__list">
        {
          PILLARS.map((p) => (
            <li class="pillar">
              <a
                href={p.href}
                class="pillar__link"
                data-goatcounter-click={p.ev}
                data-goatcounter-title={`${p.title} card`}
              >
                <div class="pillar__media u-plate">
                  <Image
                    src={pillarImg[p.title]}
                    alt={`${p.title} at Mars College`}
                    widths={[480, 760, 1000]}
                    sizes="(max-width: 900px) 100vw, 33vw"
                    format="webp"
                    quality={62}
                    loading="lazy"
                  />
                </div>
                <div class="pillar__text">
                  <h3 class="pillar__title">{p.title}</h3>
                  <p class="pillar__sub">{p.sub}</p>
                  <p class="pillar__blurb">{p.blurb}</p>
                  <span class="pillar__cta">
                    {p.cta} <span class="u-arrow" aria-hidden="true">→</span>
                  </span>
                </div>
              </a>
            </li>
          ))
        }
        {/* Sixth card — the open call. Deliberately not a photo: a dashed
            plate and a tent mark it as an empty slot rather than a camp that
            already exists. */}
        {
          (
            <li class="pillar pillar--open">
              <a
                href="mailto:info@mars.college?subject=Camp%20proposal%20for%202027"
                class="pillar__link"
                data-goatcounter-click="camp-propose"
                data-goatcounter-title="Propose a camp"
              >
                <div class="pillar__media pillar__open-plate">
                  <svg viewBox="0 0 48 48" aria-hidden="true" fill="none" stroke="currentColor"
                       stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M24 9 L43 39 H5 Z" />
                    <path d="M24 22 L33 39 H15 Z" />
                    <path d="M3 39 H45" />
                  </svg>
                </div>
                <div class="pillar__text">
                  <h3 class="pillar__title">Propose a camp</h3>
                  <p class="pillar__blurb">
                    Exceptional builders and organizers are invited to propose a
                    new camp for 2027. E-mail us at info@mars.college
                  </p>
                  <span class="pillar__cta">
                    Email us <span class="u-arrow" aria-hidden="true">→</span>
                  </span>
                </div>
              </a>
            </li>
          )
        }
      </ol>
    </div>
  </section>

  <!-- ===================== FAQ ===================== -->
  <section class="u-section faq">
    <div class="u-shell">
      <Eyebrow index="06" label="Frequently asked questions" />
      <ul class="faq__list">
        {HOME_FAQ.map((item, i) => (
          <li class="faq__item">
            <details>
              <summary>
                <span class="u-index">{String(i + 1).padStart(2, "0")}</span>
                <span class="faq__q">{item.q}</span>
                <span class="faq__chevron" aria-hidden="true">+</span>
              </summary>
              <p class="faq__a">{item.a}</p>
            </details>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ===================== LIGHTBOX ===================== -->
  <div
    id="lightbox"
    class="lb-box"
    role="dialog"
    aria-modal="true"
    aria-label="Photo gallery"
    hidden
  >
    <button type="button" class="lb-box__close" aria-label="Close gallery">×</button>
    <button type="button" class="lb-box__nav lb-box__nav--prev" aria-label="Previous">‹</button>
    <button type="button" class="lb-box__nav lb-box__nav--next" aria-label="Next">›</button>
    <figure class="lb-box__figure">
      <div class="lb-box__imgwrap">
        {[...VIL_GALLERY, ...OC_GALLERY].map((g) => (
          <Image
            src={g.img}
            alt={g.alt}
            widths={[900, 1400, 1920]}
            sizes="(max-width: 900px) 100vw, 90vw"
            format="webp"
            quality={60}
            loading="lazy"
            data-lb-slide={g.id}
          />
        ))}
      </div>
      <figcaption class="lb-box__cap">
        <span class="lb-box__cap-text"></span>
      </figcaption>
    </figure>
  </div>

  <script is:inline>
    (() => {
      const box = document.getElementById("lightbox");
      if (!box) return;
      const slides = Array.from(box.querySelectorAll("[data-lb-slide]"));
      const capText = box.querySelector(".lb-box__cap-text");
      const triggers = Array.from(document.querySelectorAll(".lb[data-lb-id]"));
      const order = slides.map((el) => el.dataset.lbSlide);
      const meta = {};
      triggers.forEach((t) => {
        const id = t.dataset.lbId;
        const img = t.querySelector("img");
        meta[id] = { cap: (img && img.alt) || "" };
      });
      let cur = 0;
      const show = (i) => {
        cur = (i + order.length) % order.length;
        slides.forEach((el, idx) => el.classList.toggle("is-active", idx === cur));
        const m = meta[order[cur]] || {};
        capText.textContent = m.cap || "";
      };
      const open = (id) => {
        const idx = order.indexOf(id);
        if (idx < 0) return;
        box.hidden = false;
        document.body.style.overflow = "hidden";
        show(idx);
      };
      const close = () => {
        box.hidden = true;
        document.body.style.overflow = "";
      };
      triggers.forEach((t) => {
        t.addEventListener("click", (e) => {
          e.preventDefault();
          open(t.dataset.lbId);
        });
      });
      box.querySelector(".lb-box__close").addEventListener("click", close);
      box.querySelector(".lb-box__nav--prev").addEventListener("click", () => show(cur - 1));
      box.querySelector(".lb-box__nav--next").addEventListener("click", () => show(cur + 1));
      box.addEventListener("click", (e) => {
        if (e.target === box) close();
      });
      document.addEventListener("keydown", (e) => {
        if (box.hidden) return;
        if (e.key === "Escape") close();
        if (e.key === "ArrowLeft") show(cur - 1);
        if (e.key === "ArrowRight") show(cur + 1);
      });
    })();
  </script>

