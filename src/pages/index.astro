---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Eyebrow from "../components/Eyebrow.astro";
import { PILLARS, APPLY_URL } from "../data/site";

// Pillar plates
import buildImg from "../assets/photos/build-sunset.jpg";
import learnImg from "../assets/photos/learn-workshop.jpg";
import thriveImg from "../assets/photos/community-group.jpg";

// Activities mosaic
import aDinner from "../assets/photos/activities/dinner.jpg";
import aEuc from "../assets/photos/activities/euc.jpg";
import aFireDome from "../assets/photos/activities/fire-dome.jpg";
import aAlgorave from "../assets/photos/activities/algorave.jpg";
import aMaker from "../assets/photos/activities/maker.jpg";
import aGroup from "../assets/photos/activities/group.jpg";
import aAerial from "../assets/photos/aerial-3.jpg";
import aPerformance from "../assets/photos/performance-moon.jpg";

// Mars 2027 closer
import nightGlow from "../assets/photos/night-glow.jpg";

const pillarImg: Record<string, any> = {
  Build: buildImg,
  Learn: learnImg,
  Thrive: thriveImg,
};

// Deterministic mosaic: two 2x2 feature plates anchor a 6-col contact sheet,
// the rest are 2x1. Tiles cleanly with no gaps at every breakpoint.
const activities = [
  { img: aDinner, cap: "Communal dinner", span: "feature" },
  { img: aEuc, cap: "Electric unicycles", span: "" },
  { img: aFireDome, cap: "Fire & dome", span: "" },
  { img: aAlgorave, cap: "Algorave", span: "" },
  { img: aGroup, cap: "The village", span: "feature" },
  { img: aMaker, cap: "Maker space", span: "" },
  { img: aAerial, cap: "Mars campus", span: "" },
  { img: aPerformance, cap: "Performance", span: "" },
];
---

<BaseLayout
  title="Mars College — Off-grid college built from scratch"
  description="Mars College is an off-grid pop-up college built from the ground up every winter in the California desert. Build Nov-Dec. Mars begins Jan 4."
>
  <Hero />

  <!-- ===================== PILLARS ===================== -->
  <section id="paths" class="u-section is-night pillars">
    <div class="u-shell">
      <ol class="pillars__list">
        {
          PILLARS.map((p) => (
            <li class="pillar">
              <div class="pillar__media u-plate">
                <Image
                  src={pillarImg[p.title]}
                  alt={`${p.title} at Mars College`}
                  widths={[480, 760, 1000]}
                  sizes="(max-width: 900px) 100vw, 33vw"
                  format="webp"
                  quality={68}
                  loading="lazy"
                />
              </div>
              <div class="pillar__text">
                <p class="pillar__index u-index">{p.index} / 03</p>
                <h3 class="pillar__title">{p.title}</h3>
                <p class="pillar__blurb">{p.blurb}</p>
                <a href={p.href} class="u-link pillar__cta">
                  {p.cta} <span class="u-arrow" aria-hidden="true">→</span>
                </a>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ===================== SOVEREIGN AI ===================== -->
  <section class="u-section sovereign">
    <div class="u-shell sovereign__grid">
      <div class="sovereign__text">
        <Eyebrow index="01" label="Sovereign AI" />
        <h2 class="sovereign__title u-display">Outsmart AGI.</h2>
        <p class="sovereign__lede">
          Run AI locally, on your own power, with tools you control. Personal
          agents, automation, art, income. The machine works for the human life,
          not the other way around.
        </p>
        <ul class="sovereign__points">
          <li>
            <span class="u-index">A</span>
            Run models and agents on hardware you control.
          </li>
          <li>
            <span class="u-index">B</span>
            Build a personal AI that answers only to you.
          </li>
          <li>
            <span class="u-index">C</span>
            Keep your data, work, and judgment in your hands.
          </li>
        </ul>
        <a href="/learn" class="u-link sovereign__cta">
          How we teach it <span class="u-arrow" aria-hidden="true">→</span>
        </a>
      </div>
      <figure class="sovereign__media u-plate">
        <Image
          src={aMaker}
          alt="A Martian working with gear inside the village"
          widths={[600, 900, 1200]}
          sizes="(max-width: 900px) 100vw, 45vw"
          format="webp"
          quality={70}
          loading="lazy"
        />
      </figure>
    </div>
  </section>

  <!-- ===================== ACTIVITIES ===================== -->
  <section class="u-section is-night activities">
    <div class="u-shell">
      <Eyebrow index="02" label="Life on Mars" />
      <div class="activities__head">
        <h2 class="activities__title u-display">
          Dinners. Algoraves. Unicycles. Campus at night.
        </h2>
      </div>
    </div>
    <div class="u-shell">
      <ul class="mosaic">
        {
          activities.map((a) => (
            <li
              class:list={[
                "mosaic__cell u-plate",
                { "is-feature": a.span === "feature" },
              ]}
            >
              <Image
                src={a.img}
                alt={a.cap}
                widths={[400, 700, 1000]}
                sizes="(max-width: 700px) 100vw, 30vw"
                format="webp"
                quality={66}
                loading="lazy"
              />
              <figcaption class="mosaic__cap u-label">{a.cap}</figcaption>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ===================== MARS 2027 CLOSER ===================== -->
  <section class="closer">
    <div class="closer__bg">
      <Image
        src={nightGlow}
        alt="The village glowing at night under a desert sky"
        widths={[768, 1280, 1920]}
        sizes="100vw"
        format="webp"
        quality={68}
        loading="lazy"
      />
      <div class="closer__scrim" aria-hidden="true"></div>
    </div>
    <div class="u-shell closer__content">
      <Eyebrow index="03" label="Mars 2027 · Season 8" />
      <h2 class="closer__title u-display">
        The next village starts now.
      </h2>
      <p class="closer__lede">
        Rolling admissions. AI cohort Aug 24. Build Nov-Dec. Mars begins Jan 4.
        Mars Electronica Mar 26-28. Materials take time. Apply early.
      </p>
      <div class="closer__actions">
        <a href={APPLY_URL} class="u-cta">
          Apply for 2027 <span aria-hidden="true">→</span>
        </a>
        <span class="closer__note u-label">Form coming soon. Substack for now.</span>
      </div>
    </div>
  </section>

  <style>
    /* ---- pillars ---- */
    .pillars__list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: clamp(1.5rem, 3vw, 2.5rem);
    }
    .pillar {
      display: flex;
      flex-direction: column;
    }
    .pillar__media {
      aspect-ratio: 4 / 5;
      margin-bottom: 1.25rem;
    }
    .pillar__media img {
      transition: transform 600ms var(--ease-out);
    }
    .pillar:hover .pillar__media img {
      transform: scale(1.03);
    }
    .pillar__index {
      display: block;
      margin-bottom: 0.5rem;
    }
    .pillar__title {
      font-family: var(--font-display);
      font-size: clamp(2.2rem, 3.6vw, 3rem);
      font-weight: 800;
      letter-spacing: -0.03em;
      line-height: 1;
      color: var(--color-bone-on-night);
    }
    .pillar__blurb {
      margin-top: 0.9rem;
      color: #d2c5af;
      font-size: var(--text-base);
      line-height: 1.5;
      max-width: 38ch;
    }
    .pillar__cta {
      margin-top: 1.25rem;
    }
    @media (max-width: 820px) {
      .pillars__list {
        grid-template-columns: 1fr;
        gap: 3rem;
      }
      .pillar {
        flex-direction: row;
        gap: 1.5rem;
        align-items: start;
      }
      .pillar__media {
        width: 40%;
        flex: none;
        margin-bottom: 0;
        aspect-ratio: 3 / 4;
      }
      .pillar__text {
        flex: 1;
      }
    }
    @media (max-width: 520px) {
      .pillar {
        flex-direction: column;
      }
      .pillar__media {
        width: 100%;
        aspect-ratio: 16 / 10;
      }
    }

    /* ---- sovereign ---- */
    .sovereign__grid {
      display: grid;
      grid-template-columns: 1fr 0.85fr;
      gap: clamp(2rem, 6vw, 5rem);
      align-items: center;
    }
    .sovereign__title {
      font-size: var(--text-3xl);
      margin-top: 0.5rem;
    }
    .sovereign__lede {
      margin-top: 1.5rem;
      font-size: var(--text-lg);
      line-height: 1.5;
      max-width: 46ch;
      color: var(--color-ink-2);
    }
    .sovereign__lede em {
      color: var(--color-clay);
      font-style: normal;
      font-weight: 700;
    }
    .sovereign__points {
      list-style: none;
      margin: 2rem 0 0;
      padding: 0;
      display: flex;
      flex-direction: column;
    }
    .sovereign__points li {
      display: grid;
      grid-template-columns: 2.5rem 1fr;
      gap: 0.5rem;
      align-items: baseline;
      padding: 1rem 0;
      border-top: var(--rule);
      max-width: 50ch;
      color: var(--color-ink);
    }
    .sovereign__cta {
      margin-top: 1.75rem;
    }
    .sovereign__media {
      aspect-ratio: 4 / 5;
    }
    @media (max-width: 820px) {
      .sovereign__grid {
        grid-template-columns: 1fr;
      }
      .sovereign__media {
        aspect-ratio: 16 / 10;
        order: -1;
      }
    }

    /* ---- activities mosaic ---- */
    .activities__head {
      max-width: 24ch;
      margin-bottom: 2.5rem;
    }
    .activities__title {
      font-size: var(--text-3xl);
      color: var(--color-bone-on-night);
    }
    .mosaic {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      grid-auto-rows: 10rem;
      grid-auto-flow: dense;
      gap: clamp(0.5rem, 1.2vw, 1rem);
    }
    .mosaic__cell {
      /* base 2x1: each plate spans 2 of 6 columns, one row */
      grid-column: span 2;
      grid-row: span 1;
    }
    .mosaic__cell :global(img) {
      transition: transform 700ms var(--ease-out);
    }
    .mosaic__cell:hover :global(img) {
      transform: scale(1.04);
    }
    .mosaic__cap {
      position: absolute;
      left: 0;
      bottom: 0;
      z-index: 2;
      margin: 0;
      padding: 0.65rem 0.75rem;
      color: var(--color-bone-on-night);
      background: linear-gradient(
        to top,
        rgba(20, 17, 14, 0.78),
        rgba(20, 17, 14, 0) 100%
      );
      width: 100%;
    }
    .mosaic__cell.is-feature {
      grid-column: span 2;
      grid-row: span 2;
    }
    @media (max-width: 820px) {
      .mosaic {
        grid-template-columns: repeat(4, 1fr);
        grid-auto-rows: 9rem;
      }
      .mosaic__cell {
        grid-column: span 2;
      }
      .mosaic__cell.is-feature {
        grid-column: span 4;
        grid-row: span 2;
      }
    }
    @media (max-width: 520px) {
      .mosaic {
        grid-template-columns: repeat(2, 1fr);
      }
      .mosaic__cell,
      .mosaic__cell.is-feature {
        grid-column: span 2;
        grid-row: span 1;
      }
    }

    /* ---- closer ---- */
    .closer {
      position: relative;
      color: var(--color-bone-on-night);
      overflow: hidden;
      isolation: isolate;
    }
    .closer__bg {
      position: absolute;
      inset: 0;
      z-index: -1;
    }
    .closer__bg img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .closer__scrim {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to right,
        rgba(20, 17, 14, 0.92) 0%,
        rgba(20, 17, 14, 0.78) 45%,
        rgba(20, 17, 14, 0.45) 100%
      );
    }
    .closer__content {
      padding-block: clamp(5rem, 12vw, 9rem);
      max-width: 50rem;
    }
    .closer__title {
      font-size: var(--text-3xl);
      line-height: 0.98;
      margin-top: 0.5rem;
    }
    .closer__lede {
      margin-top: 1.5rem;
      font-size: var(--text-lg);
      line-height: 1.5;
      max-width: 50ch;
      color: #e6dccb;
    }
    .closer__actions {
      margin-top: 2.25rem;
      display: flex;
      align-items: center;
      gap: 1.5rem;
      flex-wrap: wrap;
    }
    .closer__note {
      color: #b7a98f;
      text-transform: none;
      letter-spacing: 0.02em;
    }
  </style>
</BaseLayout>
