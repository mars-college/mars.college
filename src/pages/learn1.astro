---
// /learn1 — "The Catalog"
// Editorial brochure / college catalog feel. Clay palette dominant.
// Sections: Hero · Two programs (split) · AI spine (night) · Open calendar
// · Tracks grid · The week (grid) · The term (timeline) · Gallery · Scholarships · CTA
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Eyebrow from "../components/Eyebrow.astro";
import {
  LEARN_HERO_LEDE,
  AI_PROGRAM_TOPICS,
  AI_PROGRAM_LOCK_NOTE,
  AI_PROGRAM_REQUIREMENTS,
  AI_PROGRAM_BENEFITS,
  TRACKS,
  WEEK,
  TERM,
  COHORT,
  OPEN_CALENDAR,
  SCHOLARSHIPS,
} from "../data/learn-program";
import { APPLY_URL } from "../data/site";

// Photos
import heroImg from "../assets/photos/learn/004_2026_p1012535_96a9e.JPG"; // candlelit lecture
import classWide from "../assets/photos/learn/038_2022_img_4312_95dfd.jpg"; // circle in hangar
import classMusic from "../assets/photos/learn/020_2026_dscf0028_1bd1c.jpg"; // music theory class
import classThunder from "../assets/photos/learn/002_2026_dscf1586_ece64.jpg"; // thunder talks tiered
import classCelebrate from "../assets/photos/learn/050_2024_img_8542_bb32a.jpg"; // group celebrating
import yogaImg from "../assets/photos/learn/supp_2023_acroyoga_desert.jpg";
import clayImg from "../assets/photos/learn/supp_2022_clay_vessels.jpg";
import livecodeImg from "../assets/photos/learn/supp_2023_livecode_tidal.jpg";
import kitchenImg from "../assets/photos/learn/supp_2022_noodle_kitchen.jpg";
import workshopImg from "../assets/photos/learn/supp_2021_workshop_panoramic.jpg";
import chibaSunset from "../assets/photos/learn/supp_2023_chiba_sunset_deck.jpg";
import outdoorTalk from "../assets/photos/learn/013_2022_pxl_20220116_020317372_night_dd72d.jpg";
---

<BaseLayout
  title="Learn — Mars College 2027"
  description="The Mars College academic program: AI cohort, open calendar, tracks, and the rhythm of a three-month off-grid term."
>
  <PageHeader
    index="02"
    label="Learn"
    title="A pop-up college in the desert."
    lede={LEARN_HERO_LEDE}
    image={heroImg}
    imageAlt="An evening lecture at Mars College, audience seated before a projection"
  />

  <!-- ===================== TWO PROGRAMS ===================== -->
  <section class="u-section two">
    <div class="u-shell">
      <Eyebrow index="01" label="Two programs, one arc" />
      <div class="two__grid">
        <article class="two__col">
          <p class="u-index">Aug 24 – December</p>
          <h2 class="two__title u-display">The AI cohort.<br /><span class="muted">Online.</span></h2>
          <p class="two__body">
            Four months of weekly workshops over Zoom. Personal AI, agents,
            generative media, agentic coding. A hackathon at the midpoint.
            Demo day in December. Eden compute throughout.
          </p>
          <p class="two__body">
            For people who want the AI program but can't come to the desert in
            January — and for people who want a four-month head start before they
            do.
          </p>
        </article>
        <article class="two__col">
          <p class="u-index">Jan 4 – Mar 28</p>
          <h2 class="two__title u-display">The Mars term.<br /><span class="muted">In the desert.</span></h2>
          <p class="two__body">
            Three months off-grid in Bombay Beach. Ideas Week, three Moon shows,
            Thunder Talks every Wednesday, midterm declarations, Mars Electronica
            in late March.
          </p>
          <p class="two__body">
            Open calendar — anyone can teach. AI is the spine, but the term holds
            writers, ceramicists, musicians, builders, cooks, and movement teachers
            in the same camp.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ===================== AI SPINE (night) ===================== -->
  <section class="u-section is-night ai">
    <div class="u-shell">
      <Eyebrow index="02" label="The AI program — the spine" />
      <h2 class="ai__lead u-display">Five things every cohort Martian learns to do with AI.</h2>
      <p class="ai__intro u-measure">
        The pitch hasn't changed since 2022: use AI to expand your understanding
        of the things you already know and care about. The program isn't "about AI"
        so much as it's about wielding it on your own work.
      </p>

      <ol class="ai__topics">
        {AI_PROGRAM_TOPICS.map((t) => (
          <li class="ai__topic">
            <span class="ai__n u-index">{t.n}</span>
            <div class="ai__t">
              <h3 class="ai__title">{t.title}</h3>
              <p class="ai__body">{t.body}</p>
            </div>
          </li>
        ))}
      </ol>

      <div class="ai__split">
        <div class="ai__half">
          <p class="u-label u-label--clay">Requirements</p>
          <ul class="ai__list">
            {AI_PROGRAM_REQUIREMENTS.map((r) => <li>{r}</li>)}
          </ul>
        </div>
        <div class="ai__half">
          <p class="u-label u-label--clay">Comes with</p>
          <ul class="ai__list">
            {AI_PROGRAM_BENEFITS.map((b) => <li>{b}</li>)}
          </ul>
        </div>
      </div>

      <p class="ai__note">
        <span class="u-label u-label--clay">Note</span>
        {AI_PROGRAM_LOCK_NOTE}
      </p>
    </div>
  </section>

  <!-- ===================== OPEN CALENDAR ===================== -->
  <section class="u-section open">
    <div class="u-shell open__grid">
      <div class="open__text">
        <Eyebrow index="03" label={OPEN_CALENDAR.title} />
        <h2 class="open__lead u-display">If you want to teach it, add it to the calendar.</h2>
        <p class="open__body">{OPEN_CALENDAR.body}</p>
        <ol class="open__rules">
          {OPEN_CALENDAR.rules.map((r, i) => (
            <li><span class="u-index">{String(i + 1).padStart(2, "0")}</span>{r}</li>
          ))}
        </ol>
      </div>
      <figure class="open__media u-plate">
        <Image
          src={workshopImg}
          alt="A panoramic view of the Mars College workshop space mid-class"
          widths={[600, 900, 1200]}
          sizes="(max-width: 900px) 100vw, 42vw"
          format="webp"
          quality={70}
          loading="lazy"
        />
      </figure>
    </div>
  </section>

  <!-- ===================== TRACKS ===================== -->
  <section class="u-section--tight tracks">
    <div class="u-shell">
      <Eyebrow index="04" label="Tracks across the years" />
      <h2 class="tracks__lead u-display">What we've actually taught.</h2>
      <p class="tracks__intro u-measure">
        Some are full departments that ran the whole term. Some were one Wednesday afternoon. Both count.
      </p>
      <ul class="tracks__grid">
        {TRACKS.map((t) => (
          <li class="track">
            <p class="track__since u-index">Since {t.since}</p>
            <h3 class="track__name">{t.name}</h3>
            <p class="track__body">{t.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ===================== THE WEEK ===================== -->
  <section class="u-section is-night week">
    <div class="u-shell">
      <Eyebrow index="05" label="A typical week" />
      <h2 class="week__lead u-display">Monday to Sunday, more or less.</h2>
      <p class="week__intro u-measure">
        The calendar shifts week to week. What follows is the shape that holds
        across the term.
      </p>
      <table class="week__table">
        <thead>
          <tr><th></th><th>Morning</th><th>Midday</th><th>Evening</th></tr>
        </thead>
        <tbody>
          {WEEK.map((d) => (
            <tr>
              <th scope="row">{d.day}</th>
              <td>{d.morning}</td>
              <td>{d.midday}</td>
              <td>{d.evening}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- ===================== TERM TIMELINE ===================== -->
  <section class="u-section term">
    <div class="u-shell">
      <Eyebrow index="06" label="The term" />
      <h2 class="term__lead u-display">From Build Week to the desert returning.</h2>
      <ol class="term__list">
        {TERM.map((t) => (
          <li class:list={["term__item", `is-${t.kind}`]}>
            <span class="term__date">{t.date}</span>
            <div>
              <h3 class="term__label">{t.label}</h3>
              <p class="term__body">{t.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ===================== PHOTO GALLERY ===================== -->
  <section class="u-section--tight gallery">
    <div class="u-shell">
      <ul class="gallery__grid">
        {[
          { img: yogaImg, cap: "Acroyoga on the lake bed" },
          { img: clayImg, cap: "Ceramics, Saturn studio" },
          { img: livecodeImg, cap: "Live-coded music, projected" },
          { img: classMusic, cap: "Music theory" },
          { img: kitchenImg, cap: "Noodle bar at Chatsubo" },
          { img: classThunder, cap: "Thunder Talks" },
          { img: outdoorTalk, cap: "Ideas Week, outdoor" },
          { img: classCelebrate, cap: "After the show" },
          { img: chibaSunset, cap: "Sunset on the Chiba deck" },
        ].map((p) => (
          <li class="gallery__cell u-plate">
            <Image
              src={p.img}
              alt={p.cap}
              widths={[400, 700, 1000]}
              sizes="(max-width: 700px) 50vw, 28vw"
              format="webp"
              quality={66}
              loading="lazy"
            />
            <figcaption class="gallery__cap u-label">{p.cap}</figcaption>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ===================== SCHOLARSHIPS ===================== -->
  <section class="u-section">
    <div class="u-shell">
      <Eyebrow index="07" label="Scholarships, not tracks" />
      <h2 class="schol__lead u-display">Apply your work to one of four.</h2>
      <p class="schol__intro u-measure">
        Dedicated agents interview, coach, and release capital over the season.
      </p>
      <ul class="schol__grid">
        {SCHOLARSHIPS.map((s, i) => (
          <li class="schol">
            <span class="schol__n u-index">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="schol__title">{s.title}</h3>
            <p class="schol__body">{s.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ===================== CTA ===================== -->
  <section class="u-section--tight">
    <div class="u-shell cta-band">
      <p class="cta-band__text u-display">
        Bring the work you want to make.
      </p>
      <a href={APPLY_URL} class="u-cta">
        Apply for 2027 <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <style>
    .muted { color: var(--color-ink-3); }

    /* two */
    .two__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 6vw, 4rem); margin-top: 1rem; }
    .two__col { border-top: var(--rule-strong); padding-top: 1.5rem; }
    .two__title { font-size: clamp(2rem, 4vw, 3rem); margin-top: 0.5rem; line-height: 1; }
    .two__body { margin-top: 1rem; color: var(--color-ink-2); max-width: 40ch; }
    @media (max-width: 720px) { .two__grid { grid-template-columns: 1fr; } }

    /* ai */
    .ai__lead { font-size: var(--text-3xl); color: var(--color-bone-on-night); max-width: 24ch; }
    .ai__intro { margin-top: 1.25rem; color: #cabda6; font-size: var(--text-lg); }
    .ai__topics { list-style: none; margin: 2.5rem 0 0; padding: 0; border-top: 1px solid var(--color-rule-night); }
    .ai__topic { display: grid; grid-template-columns: 4rem 1fr; gap: clamp(1rem, 3vw, 2rem); padding: 1.25rem 0; border-bottom: 1px solid var(--color-rule-night); align-items: baseline; }
    .ai__title { font-family: var(--font-display); font-size: clamp(1.4rem, 2.4vw, 1.85rem); font-weight: 800; color: var(--color-bone-on-night); }
    .ai__body { margin-top: 0.3rem; color: #d2c5af; max-width: 52ch; }
    .ai__split { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4rem); margin-top: 2.5rem; }
    .ai__list { list-style: none; margin: 0.75rem 0 0; padding: 0; display: grid; gap: 0.6rem; color: var(--color-bone-on-night); }
    .ai__list li { padding-left: 1.1rem; position: relative; }
    .ai__list li::before { content: "→"; position: absolute; left: 0; color: var(--color-clay); }
    .ai__note { margin-top: 2.5rem; border-left: 2px solid var(--color-clay); padding: 0.25rem 0 0.25rem 1.25rem; color: #ece2d0; max-width: 60ch; font-size: var(--text-lg); }
    .ai__note .u-label { display: block; margin-bottom: 0.4rem; }
    @media (max-width: 640px) { .ai__split { grid-template-columns: 1fr; } .ai__topic { grid-template-columns: 1fr; gap: 0.3rem; } }

    /* open */
    .open__grid { display: grid; grid-template-columns: 1fr 0.8fr; gap: clamp(2rem, 6vw, 5rem); align-items: center; }
    .open__lead { font-size: clamp(1.9rem, 3.8vw, 2.8rem); max-width: 18ch; }
    .open__body { margin-top: 1.25rem; color: var(--color-ink-2); max-width: 46ch; font-size: var(--text-lg); line-height: 1.5; }
    .open__rules { list-style: none; margin: 2rem 0 0; padding: 0; display: grid; gap: 0; max-width: 50ch; }
    .open__rules li { display: grid; grid-template-columns: 2.75rem 1fr; gap: 0.5rem; padding: 1rem 0; border-top: var(--rule); align-items: baseline; }
    .open__media { aspect-ratio: 4 / 5; }
    @media (max-width: 820px) { .open__grid { grid-template-columns: 1fr; } .open__media { aspect-ratio: 16 / 10; order: -1; } }

    /* tracks */
    .tracks__lead { font-size: var(--text-3xl); max-width: 18ch; }
    .tracks__intro { margin-top: 1rem; color: var(--color-ink-2); margin-bottom: 2.5rem; }
    .tracks__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; border-top: var(--rule); border-left: var(--rule); }
    .track { padding: 1.5rem; border-right: var(--rule); border-bottom: var(--rule); }
    .track__since { display: block; margin-bottom: 0.4rem; }
    .track__name { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.15rem, 2vw, 1.45rem); letter-spacing: -0.02em; }
    .track__body { margin-top: 0.6rem; color: var(--color-ink-2); }
    @media (max-width: 920px) { .tracks__grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 560px) { .tracks__grid { grid-template-columns: 1fr; } }

    /* week */
    .week__lead { font-size: var(--text-3xl); color: var(--color-bone-on-night); max-width: 22ch; }
    .week__intro { margin-top: 1rem; color: #cabda6; margin-bottom: 2.5rem; }
    .week__table { width: 100%; border-collapse: collapse; color: var(--color-bone-on-night); font-size: var(--text-base); }
    .week__table th, .week__table td { padding: 1rem 0.75rem; text-align: left; border-bottom: 1px solid var(--color-rule-night); vertical-align: top; }
    .week__table thead th { font-family: var(--font-body); font-size: var(--text-meta); letter-spacing: 0.16em; text-transform: uppercase; color: #b7a98f; font-weight: 700; border-bottom: 1.5px solid var(--color-bone-on-night); }
    .week__table tbody th { font-family: var(--font-display); font-weight: 800; font-size: 1.4rem; width: 4.5rem; }
    .week__table tbody td { color: #d2c5af; }
    @media (max-width: 720px) {
      .week__table thead { display: none; }
      .week__table tbody tr { display: grid; grid-template-columns: 4rem 1fr; gap: 0.25rem 1rem; padding: 1rem 0; border-bottom: 1px solid var(--color-rule-night); }
      .week__table tbody th { padding: 0; border: 0; }
      .week__table tbody td { padding: 0; border: 0; }
      .week__table tbody td::before { content: attr(data-label); display: block; font-size: 0.75rem; letter-spacing: 0.16em; text-transform: uppercase; color: #b7a98f; }
    }

    /* term */
    .term__lead { font-size: var(--text-3xl); max-width: 22ch; margin-bottom: 2.5rem; }
    .term__list { list-style: none; margin: 0; padding: 0; border-top: var(--rule-strong); }
    .term__item { display: grid; grid-template-columns: 10rem 1fr; gap: clamp(1rem, 3vw, 2.5rem); padding: 1.5rem 0; border-bottom: var(--rule); align-items: baseline; }
    .term__item.is-online { background: linear-gradient(to right, color-mix(in srgb, var(--color-clay) 8%, transparent), transparent 30%); }
    .term__item.is-build { color: var(--color-ink-2); }
    .term__date { font-family: var(--font-mono); font-size: var(--text-meta); color: var(--color-clay); letter-spacing: 0.04em; }
    .term__label { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.2rem, 2.4vw, 1.6rem); letter-spacing: -0.02em; }
    .term__body { margin-top: 0.4rem; color: var(--color-ink-2); max-width: 56ch; }
    @media (max-width: 560px) { .term__item { grid-template-columns: 1fr; gap: 0.3rem; } }

    /* gallery */
    .gallery__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); grid-auto-rows: 14rem; gap: clamp(0.5rem, 1.2vw, 1rem); }
    .gallery__cell { position: relative; overflow: hidden; }
    .gallery__cell :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 700ms var(--ease-out); }
    .gallery__cell:hover :global(img) { transform: scale(1.04); }
    .gallery__cap { position: absolute; left: 0; bottom: 0; padding: 0.6rem 0.75rem; color: var(--color-paper); background: linear-gradient(to top, rgba(20,17,14,0.78), transparent); width: 100%; }
    @media (max-width: 720px) { .gallery__grid { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 11rem; } }
    @media (max-width: 460px) { .gallery__grid { grid-template-columns: 1fr; grid-auto-rows: 14rem; } }

    /* scholarships */
    .schol__lead { font-size: clamp(1.9rem, 4vw, 3rem); max-width: 18ch; }
    .schol__intro { margin-top: 1rem; color: var(--color-ink-2); margin-bottom: 2.5rem; }
    .schol__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0; border-top: var(--rule); border-left: var(--rule); }
    .schol { padding: clamp(1.5rem, 3vw, 2.25rem); border-right: var(--rule); border-bottom: var(--rule); }
    .schol__n { display: block; margin-bottom: 0.75rem; }
    .schol__title { font-family: var(--font-display); font-size: clamp(1.4rem, 2.6vw, 1.9rem); font-weight: 800; }
    .schol__body { margin-top: 0.6rem; color: var(--color-ink-2); max-width: 44ch; }
    @media (max-width: 640px) { .schol__grid { grid-template-columns: 1fr; } }

    /* cta */
    .cta-band { display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap; border-top: var(--rule-strong); padding-top: 2.5rem; }
    .cta-band__text { font-size: clamp(1.6rem, 3.4vw, 2.6rem); max-width: 20ch; }
  </style>
</BaseLayout>
