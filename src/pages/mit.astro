---
// /mit — Mars Institute of Technology (MIT). Derived from /learn with the
// AI camp rebranded as the Mars Institute of Technology; "Off-Grid AI
// Engineering" remains the name of the course. Adds an emblem section
// (the MIT seal) right under the page header.
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Eyebrow from "../components/Eyebrow.astro";
import { EMAIL, TALLY_APPLY_FORM_ID } from "../data/site";

// Hero — DSCF1587, Thunder Talks 2026: chess engines and charts projected in
// the Chiba hangar. Full-res original also at
// media/posts/2026 Recap article (duplicates)/DSCF1587.jpg
import heroImg from "../assets/photos/learn/005_2026_dscf1587_2f9fb.jpg";

// The MIT emblem (seal).
import emblemImg from "../assets/brand/mit-emblem.png";

// AI history grid (2019 → 2027)
import aiHist2019 from "../assets/photos/learn/ai-history/2019-bbgan.png";
import aiHist2020 from "../assets/photos/learn/ai-history/2020-little-martians.jpg";
import aiHist2021 from "../assets/photos/learn/ai-history/2022-mars-bots.jpg";
import aiHist2022 from "../assets/photos/learn/ai-history/2022-ba-sing-se.png";
import aiHist2023 from "../assets/photos/learn/ai-history/2023-desert-nomads.png";
import aiHist2024 from "../assets/photos/learn/ai-history/2024-film-festival.jpg";
import aiHist2025 from "../assets/photos/learn/ai-history/2025-painted-canyons.jpg";
import aiHist2026 from "../assets/photos/learn/ai-history/2026-finals-presentation.jpg";
// Featured video for the §04 Off-Grid AI close (lives in /public).
const AI_VIDEO_SRC = "/learn-video/2025-mars-research.mp4";
const AI_VIDEO_POSTER = "/learn-video/2025-mars-research-poster.jpg";

// Pillar photos.
import pillarLab from "../assets/photos/aerial-2.jpg";
import pillarGallery from "../assets/photos/learn/gallery-2026-opening.jpg";

// Topic list inlined here (replaces AI_PROGRAM_TOPICS from shared data,
// so the candidate pages /learn1–4 are not affected by these edits).
const TOPICS = [
  {
    n: "01",
    title: "Personal AI",
    body: "A coach, digital twin, chief of staff, guardian angel, second brain. An agent that knows you and answers only to you.",
  },
  {
    n: "02",
    title: "Off-Grid Agents",
    body: "Open-source, self-hosted, local models. A stack that doesn't go down when the cloud does.",
  },
  {
    n: "03",
    title: "Art with AI",
    body: "Film, music, performance, live code. AI as an instrument, not a style.",
  },
  {
    n: "04",
    title: "Earning a living",
    body: "How people using AI are making money now, and how you might.",
  },
];

// Semester timeline used in §02 Upcoming programs.
const MARS_COLLEGE_TIMELINE = [
  { date: "Nov – Dec", label: "DPW builds Mars campus", href: "/build" },
  { date: "Jan 4", label: "Mars College begins" },
  { date: "Jan 11 – 17", label: "Ideas Week" },
  { date: "Wed nights", label: "Thunder Talks · weekly" },
  { date: "Jan · Feb · Mar", label: "Moons of Mars · 3 gallery shows" },
  { date: "Feb 13 – 15", label: "Declaration Days · midterm" },
  { date: "Mar 26 – 28", label: "Mars Electronica · finals" },
  { date: "April", label: "Unbuild" },
];

// Three-pillars block — what the Mars Institute of Technology is.
const PILLARS = [
  {
    n: "01",
    title: "An off-grid applied research lab",
    body: "MIT is part camp, part academy that builds a gallery and engineering school dedicated to technological self-reliance.",
    img: pillarLab,
    alt: "Drone view of the multi-story pallet-rack campus at Mars — plywood mezzanines, solar panels, and open desert behind",
  },
  {
    n: "02",
    title: "Outsmart the superintelligence",
    body: "Classes on AI tools and skills, for art, knowledge, productivity, and commerce.",
    img: pMcMarzipanAI,
    alt: "Marzipan teaching AI art at Mars — Burroughs Quotes screen with AI-generated mandala imagery",
  },
  {
    n: "03",
    title: "Learning by making",
    body: "The semester culminates with a group exhibition, film festival, and conference.",
    img: pillarGallery,
    alt: "Visitors viewing video works on wall-mounted screens at the Chiba gallery opening, Mars 2026",
  },
];

// AI history — eight years of AI studies on Mars, 2019 → 2027, shown as a
// 3×3 gallery grid. Captions accept inline HTML so we can link out to source
// posts, model homepages, and project pages.
const AI_HISTORY = [
  {
    year: "2019",
    img: aiHist2019,
    alt: "BBGAN — early generative AI video trained on Bombay Beach",
    captionHtml: `<a href="https://x.com/Mars_College/status/1440013890369187842" target="_blank" rel="noopener">BBGAN</a> at Bombay Beach Biennale, early generative video trained on town and desert.`,
  },
  {
    year: "2020",
    img: aiHist2020,
    alt: "A photogrammetry scan of a Little Martians ceramic face open in a 3D viewport",
    captionHtml: `<a href="https://abraham.ai" target="_blank" rel="noopener">Abraham</a>, <a href="https://www.instagram.com/stories/highlights/17849566153934165/" target="_blank" rel="noopener">The Portal</a>, and <a href="https://marscollege.substack.com/p/little-martians-from-ceramics-to" target="_blank" rel="noopener">Little Martians</a>.`,
  },
  {
    year: "2021",
    img: aiHist2021,
    alt: "Mars Bots and Mulabonding — AI art series, SolarPunk Strength",
    captionHtml: `<a href="https://marscollege.substack.com/p/machine-learning-and-feedback-in" target="_blank" rel="noopener">First creative AI class</a>, and <a href="https://marscollege.substack.com/p/telepresence-completes-the-metaverse" target="_blank" rel="noopener">telepresence robots</a>.`,
  },
  {
    year: "2022",
    img: aiHist2022,
    alt: "Plate from the Mulabonding book — AI-generated animals and figures linked by ribboned paths, illustrating Ba Sing Se's line \"All beings have different paths, different time ways\"",
    captionHtml: `<a href="https://marscollege.substack.com/p/the-fifth-element" target="_blank" rel="noopener">Mars Bots</a> and <a href="https://vault.jmill.dev/project/Mulabonding" target="_blank" rel="noopener">Mulabonding</a>. GPT-3 house bots and the cohort AI art they generated.`,
  },
  {
    year: "2023",
    img: aiHist2023,
    alt: "Three shrouded desert nomads on glowing electric unicycles in a red rock canyon — AI artwork from the Mars bots channel, 2023",
    captionHtml: `<a href="https://marscollege.substack.com/p/study-creative-ai-at-mars-college" target="_blank" rel="noopener">Creative AI major</a> launched.`,
  },
  {
    year: "2024",
    img: aiHist2024,
    alt: "Outdoor projection of the first AI Film Festival at Bombay Beach",
    captionHtml: `First <a href="https://marscollege.substack.com/p/creative-ai-at-mars-college-2026" target="_blank" rel="noopener">AI Film Festival</a>.`,
  },
  {
    year: "2025",
    img: aiHist2025,
    alt: "A giant AI-generated face projected onto a canyon wall at night, cars parked on the desert floor below — Painted Canyons, 2025",
    captionHtml: `<a href="https://marscollege.substack.com/p/ai-agents-class" target="_blank" rel="noopener">Personal agents</a> for every Martian. First gallery, and <a href="https://ygormarotta.substack.com/p/painted-canyons" target="_blank" rel="noopener">Painted Canyons</a>.`,
  },
  {
    year: "2026",
    img: aiHist2026,
    alt: "Mars 2026 finals presentation — projected geometric diagrams between pallet-rack columns",
    captionHtml: `<a href="https://marscollege.substack.com/p/creative-ai-at-mars-college-2026" target="_blank" rel="noopener">AI Camp</a>, <a href="https://marscollege.substack.com/p/recap-of-mars-2026" target="_blank" rel="noopener">second gallery</a>.`,
  },
  {
    year: "2027",
    img: emblemImg,
    alt: "The seal of the Mars Institute of Technology — Mens et Terra, established 2020",
    captionHtml: `Launch of the <strong>Mars Institute of Technology</strong>.`,
  },
];

// Justified masonry rows: 3 per row, each image at its native aspect ratio,
// scaled to a shared row height so every row spans the full viewport width.
const HIST = AI_HISTORY.map((h, i) => ({
  ...h,
  id: `hist-${i}`,
  ar: Number((h.img.width / h.img.height).toFixed(4)),
}));
const HIST_ROWS = [HIST.slice(0, 3), HIST.slice(3, 6), HIST.slice(6, 9)];

// "Learn AI through art" — AI artworks + the working gallery in Chiba.
import pMcMarzipanAI from "../assets/photos/learn/supp_marscollege_marzipan-aiart.jpeg";
import pMcChibaGallery from "../assets/photos/learn/supp_marscollege_chiba-gallery.jpg";
import pGalInterior from "../assets/photos/learn/gallery/interior.jpg";
import pGalViewing from "../assets/photos/learn/gallery/viewing.jpg";
import pGalScreens from "../assets/photos/learn/gallery/screens.jpg";
import pGalScreensRow from "../assets/photos/learn/gallery/screens-row.jpg";
import pGalAiArt from "../assets/photos/learn/gallery/ai-art.jpg";
// The Film Festival — full-bleed background: the 2026 AI Film Festival
// screening at the Bombay Beach Arts Center, under the fish sculpture.
import mffBg from "../assets/photos/learn/electronica/bbac-screening-2026.jpg";

// Feature image for the "Learn AI through art" section.
const ART_HERO = pGalInterior;

// "The gallery" — the working gallery in Chiba + AI artworks, as a carousel.
const ART_PHOTOS = [
  { img: pMcChibaGallery, alt: "Hanging work in the Chiba Art Gallery — a wall of AI portraits under LED strip light" },
  { img: pGalViewing, alt: "Martians viewing AI video work on the gallery wall · 2026" },
  { img: pGalAiArt, alt: "An AI artwork series shown in the gallery · 2026" },
  { img: pGalScreens, alt: "AI art panels and screens mounted on the gallery wall · 2026" },
  { img: pGalScreensRow, alt: "A row of screens running generative work · 2026" },
];

// The §04 feature image is a lightbox slide of its own, so it opens like the
// carousel cells do.
const ART_HERO_ALT =
  "The AI gallery inside the Chiba hangar — screens mounted on pallet racks · 2026";

// Combined gallery list for the lightbox carousel (history, feature, then art).
const GALLERY = [
  ...AI_HISTORY.map((h, i) => ({ img: h.img, alt: h.alt, id: `hist-${i}` })),
  { img: ART_HERO, alt: ART_HERO_ALT, id: "art-hero" },
  ...ART_PHOTOS.map((p, i) => ({ img: p.img, alt: p.alt, id: `art-${i}` })),
];

// Filter the term to IRL beats only — online cohort gets its own section.

// Course schema for the AI program (search rich results).
const courseLd = {
  "@context": "https://schema.org",
  "@type": "Course",
  name: "Off-Grid AI Engineering",
  description:
    "The flagship course of the Mars Institute of Technology (MIT): build sovereign, off-grid AI — personal AI agents, art with AI, and earning a living with AI. An online cohort plus a winter term at Mars College in the California desert.",
  provider: {
    "@type": "EducationalOrganization",
    name: "Mars Institute of Technology",
    parentOrganization: {
      "@type": "EducationalOrganization",
      name: "Mars College",
    },
    sameAs: "https://mars.college",
  },
  url: "https://mars.college/mit",
  hasCourseInstance: [
    { "@type": "CourseInstance", courseMode: "Online", name: "Off-Grid AI online cohort" },
    {
      "@type": "CourseInstance",
      courseMode: "Onsite",
      name: "Mars College winter term",
      location: { "@type": "Place", name: "Bombay Beach, California" },
    },
  ],
};
---

<BaseLayout
  title="Mars Institute of Technology (MIT) — Mars College"
  description="The Mars Institute of Technology (MIT) is the AI school of Mars College. Study Off-Grid AI Engineering: build sovereign personal AI agents, make art with AI, and earn a living with AI. An online cohort and a winter term in the California desert."
  jsonLd={courseLd}
>
  <!-- ============ HEADER: hero image + emblem, combined ============ -->
  <header class="mith is-night">
    <div class="mith__bg">
      <Image
        src={heroImg}
        alt="A Thunder Talk in the Chiba hangar at night — a presenter with a microphone in front of a projection of chess engines and live charts, audience watching from the dark"
        widths={[768, 1280, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        format="webp"
        quality={68}
        class="mith__img"
      />
      <div class="mith__scrim" aria-hidden="true"></div>
    </div>
    <div class="mith__content">
      <Eyebrow label="MIT" />
      <h1 class="mith__sr-title">Mars Institute of Technology</h1>
      <div class="mith__crest">
        <Image
          src={emblemImg}
          alt="The seal of the Mars Institute of Technology — two engraved figures flank a pedestal reading Vanlife and Superintelligence over the year 2020, above the motto Mens et Terra"
          widths={[360, 600, 900]}
          sizes="(max-width: 640px) 50vw, 18vw"
          format="webp"
          quality={78}
          loading="eager"
          class="mith__seal u-rise"
        />
        <div class="mith__say">
          <p class="mith__lede u-rise" style="animation-delay:120ms">
            The camp of future technology at Mars. Art gallery, film academy,
            and boot camp for off-grid AI engineering.
          </p>
          <a href="#apply" class="mith__cta u-rise" style="animation-delay:200ms">
            Apply to MIT <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </header>

  <!-- ===================== THREE PILLARS ===================== -->
  <section class="u-section pillars">
    <div class="u-shell">
      <Eyebrow index="01" label="What Mars Institute of Technology is" />
      <ol class="pillars__list">
        {PILLARS.map((p) => (
          <li class="pillar">
            <div class="pillar__media u-plate">
              <Image
                src={p.img}
                alt={p.alt}
                widths={[400, 700, 1000]}
                sizes="(max-width: 820px) 100vw, 30vw"
                format="webp"
                quality={64}
                loading="lazy"
              />
            </div>
            <span class="pillar__n u-index">{p.n}</span>
            <h3 class="pillar__title">{p.title}</h3>
            <p class="pillar__body">{p.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ===================== EIGHT YEARS OF MARS ===================== -->
  <section id="history" class="u-section is-night aihist">
    <div class="u-shell">
      <Eyebrow index="02" label="Mars Institute of Technology — at Mars since the beginning" />
      <h2 class="aihist__lead u-display">Eight years of AI on Mars.</h2>
      <p class="aihist__intro u-measure" set:html={`
        AI studies on Mars date back to
        <a href="https://x.com/genekogan/status/1165684548241416193" target="_blank" rel="noopener">before Mars College had its name</a>.
        Starting as a creative AI class in the desert, and evolving from major
        to department to institute, Martians predict and invoke the future
        through bots, films, zines, galleries, and installations.
      `}></p>

    </div>

    <div class="aihist__mason">
      {HIST_ROWS.map((row) => (
        <ol class="aihist__row">
          {row.map((h) => (
            <li class="aiyr" style={`flex: ${h.ar} 1 0%`}>
              <button
                type="button"
                class="aiyr__plate u-plate lb"
                data-lb-id={h.id}
                aria-label={`Open photo: ${h.alt}`}
                style={`aspect-ratio: ${h.ar}`}
              >
                <Image
                  src={h.img}
                  alt={h.alt}
                  widths={[500, 900, 1400]}
                  sizes="(max-width: 640px) 100vw, 40vw"
                  format="webp"
                  quality={66}
                  loading="lazy"
                />
              </button>
              <p class="aiyr__year u-index">{h.year}</p>
              <p class="aiyr__cap" set:html={h.captionHtml}></p>
            </li>
          ))}
        </ol>
      ))}
    </div>
  </section>

  <!-- ===================== UPCOMING PROGRAMS ===================== -->
  <section class="u-section compare">
    <div class="u-shell">
      <Eyebrow index="03" label="How it works" />
      <h2 class="compare__lead u-display">MIT Curriculum</h2>
      <p class="compare__intro u-measure">
        The calendar and program for MIT.
      </p>

      <div class="compare__cols">
        <article class="compare__col">
          <p class="compare__col-tag u-label">What you give</p>
          <ul class="compare__list">
            <li>A lightning talk during Ideas Week.</li>
            <li>Contribute to galleries and Mars Electronica.</li>
            <li>Organize a workshop, screening, or study group of your own.</li>
            <li>Basic chores in shared spaces.</li>
          </ul>
          <p class="compare__col-tag u-label compare__col-tag--second">What you get</p>
          <ul class="compare__list">
            <li>Compute grant for AI projects.</li>
            <li>Space: screens, projectors, materials to create with.</li>
            <li>Access to housing inside the MIT buildings.</li>
          </ul>
        </article>

        <article class="compare__col">
          <p class="compare__col-tag u-label">In the desert · Jan – Mar</p>
          <h3 class="compare__col-name u-display">The semester</h3>
          <p class="compare__col-meta">3 months on-site · Mars</p>
          <ol class="ptl">
            {MARS_COLLEGE_TIMELINE.map((t) => (
              <li class="ptl__item">
                <span class="ptl__date">{t.date}</span>
                {t.href ? (
                  <a href={t.href} class="ptl__label ptl__label--link">{t.label}</a>
                ) : (
                  <span class="ptl__label">{t.label}</span>
                )}
              </li>
            ))}
          </ol>
        </article>
      </div>
    </div>
  </section>

  <!-- ===================== LEARN AI THROUGH ART ===================== -->
  <section class="u-section is-night art">
    <div class="u-shell">
      <Eyebrow index="04" label="The gallery" />
      <h2 class="art__lead u-display">The gallery ties the school together.</h2>
      <p class="art__intro u-measure">
        The Mars semester is anchored to monthly group exhibitions in a shared
        gallery we build in the open desert.
      </p>

      <button
        type="button"
        class="art__feature u-plate lb"
        data-lb-id="art-hero"
        aria-label={`Open photo: ${ART_HERO_ALT}`}
      >
        <Image
          src={ART_HERO}
          alt={ART_HERO_ALT}
          widths={[760, 1200, 1800]}
          sizes="100vw"
          format="webp"
          quality={64}
          loading="lazy"
        />
      </button>

      <div class="art__carousel" id="art-carousel">
        <ul class="art__track">
          {ART_PHOTOS.map((p, i) => (
            <li class="art__slide">
              <button
                type="button"
                class="art__cell u-plate lb"
                data-lb-id={`art-${i}`}
                aria-label={`Open photo: ${p.alt}`}
              >
                <Image
                  src={p.img}
                  alt={p.alt}
                  widths={[400, 700, 1000]}
                  sizes="(max-width: 720px) 80vw, 32vw"
                  format="webp"
                  quality={62}
                  loading="lazy"
                />
              </button>
            </li>
          ))}
        </ul>
        <button type="button" class="art__nav art__nav--prev" aria-label="Previous photos">‹</button>
        <button type="button" class="art__nav art__nav--next" aria-label="Next photos">›</button>
      </div>

    </div>
  </section>

  <!-- ===================== THE FILM FESTIVAL ===================== -->
  <section class="is-night mff">
    <div class="mff__bg">
      <Image
        src={mffBg}
        alt="The 2026 AI Film Festival screened outdoors at the Bombay Beach Arts Center — audience in folding chairs under the recycled-metal fish sculpture, palm tree beside the glowing screen"
        widths={[768, 1280, 1920]}
        sizes="100vw"
        format="webp"
        quality={62}
        loading="lazy"
        class="mff__img"
      />
      <div class="mff__scrim" aria-hidden="true"></div>
    </div>
    <div class="u-shell mff__content">
      <Eyebrow index="05" label="Mars Electronica · finals" />
      <h2 class="mff__lead u-display">The Film Festival.</h2>
      <div class="mff__bottom">
        <p class="mff__sub">
          The fourth annual AI Film Festival will be screened during Mars
          Electronica, our year end celebration.
        </p>
        <a href="/mff" class="u-cta">
          Learn more about our AI Film Festival <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ===================== OFF-GRID AI PROGRAM ===================== -->
  <section class="u-section ai">
    <div class="u-shell">
      <Eyebrow index="06" label="Outsmart the superintelligence" />
      <h2 class="ai__lead u-display">Off-Grid AI Engineering.</h2>
      <div class="ai__intro u-measure">
        <p>
          MIT is dedicated to cultivating technological self-reliance, and
          harnessing AI to support your lifestyle, not your employer. Here's
          what we work on.
        </p>
      </div>

      <ol class="ai__topics">
        {TOPICS.map((t) => (
          <li class="ai__topic">
            <span class="ai__n u-index">{t.n}</span>
            <div>
              <h3 class="ai__title">{t.title}</h3>
              <p class="ai__body">{t.body}</p>
            </div>
          </li>
        ))}
      </ol>

      <div class="ai__quotes">
        <figure class="ai__quote">
          <blockquote>"I think that AI will probably, most likely, sort of lead to the end of the world."</blockquote>
          <figcaption>
            — <a href="https://siepr.stanford.edu/news/what-point-do-we-decide-ais-risks-outweigh-its-promise" target="_blank" rel="noopener">Sam Altman</a>
          </figcaption>
        </figure>
        <figure class="ai__quote">
          <blockquote>"There's a 25% chance that things go really, really badly."</blockquote>
          <figcaption>
            — <a href="https://www.axios.com/2025/09/17/anthropic-dario-amodei-p-doom-25-percent" target="_blank" rel="noopener">Dario Amodei</a>
          </figcaption>
        </figure>
      </div>

      <div class="ai__intro ai__scenario u-measure">
        <p set:html={`
          The year is 2033. Superintelligence has taken hold of the economy.
          <a href="https://www.entrepreneur.com/business-news/ai-could-lead-to-mass-joblessness-within-the-next-5-years/496742" target="_blank" rel="noopener">Unemployment is at 90%</a>.
          <a href="https://www.inc.com/moses-jeanfrancois/san-francisco-rents-rose-by-22-percent-even-some-tech-workers-blaming-ai-boom/91351374" target="_blank" rel="noopener">Bay Area rent is $50,000 a month</a>. Sound crazy?
          It's the future
          <a href="https://fortune.com/2026/05/26/sam-altman-dario-amodei-walking-back-ai-jobs-apocalypse-prophecies-ipo/" target="_blank" rel="noopener">every frontier-AI CEO is openly predicting</a>, and the
          future <a href="https://marscollege.substack.com/p/study-creative-ai-at-mars-college" target="_blank" rel="noopener">we've been preparing for</a> since we started Mars College.
        `}></p>
      </div>

      <figure class="ai__feature">
        <video
          class="ai__video"
          src={AI_VIDEO_SRC}
          poster={AI_VIDEO_POSTER}
          controls
          playsinline
          preload="none"
          aria-label="Mars 2025 trailer"
        ></video>
      </figure>
    </div>
  </section>

  <!-- ===================== APPLY ===================== -->
  <section id="apply" class="u-section is-night cohort">
    <div class="u-shell cohort__grid">
      <div class="cohort__text">
        <Eyebrow index="07" label="Apply · rolling admissions" />
        <h2 class="cohort__lead u-display">Apply to MIT.</h2>
        <p class="cohort__intro u-measure">
          One application for the Mars Institute of Technology. Tell us who you
          are and what you'd build in the desert. We read them as they come in.
        </p>
        <ul class="cohort__list">
          <li>Rolling admissions · the earlier the better</li>
          <li>The term runs Jan 4 – Mar 28 at Mars</li>
          <li>Questions? <a href={`mailto:${EMAIL}?subject=MIT%20application`} class="cohort__form-link">{EMAIL}</a></li>
        </ul>
      </div>

      <div class="cohort__form">
