    .aihist__lead { font-size: var(--text-3xl); color: var(--color-bone-on-night); max-width: 18ch; }
    .aihist__intro { margin-top: 1rem; color: #cabda6; font-size: var(--text-lg); line-height: 1.5; margin-bottom: 2.5rem; }
    /* full-bleed justified masonry: rows span 100% of the viewport; within a
       row every image shares one height (flex-grow = aspect ratio), so row
       heights vary with the photos in them */
    .aihist__mason { margin-top: clamp(1.5rem, 3vw, 2.5rem); display: flex; flex-direction: column; gap: clamp(0.4rem, 0.8vw, 0.75rem); }
    .aihist__row { list-style: none; margin: 0; padding: 0; display: flex; gap: clamp(0.4rem, 0.8vw, 0.75rem); }
    .aiyr { min-width: 0; display: flex; flex-direction: column; gap: 0.5rem; }
    .aiyr__year { padding-inline: clamp(0.6rem, 1.2vw, 1rem); }
    .aiyr__cap { padding-inline: clamp(0.6rem, 1.2vw, 1rem); }
    .aiyr__plate { background: var(--color-night); border: 1px solid var(--color-rule-night); padding: 0; cursor: zoom-in; display: block; width: 100%; transition: border-color var(--dur-fast) var(--ease-out); }
    .aiyr__plate :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 600ms var(--ease-out); }
    .aiyr__plate:hover, .aiyr__plate:focus-visible { border-color: var(--color-clay); }
    .aiyr__plate:hover :global(img), .aiyr__plate:focus-visible :global(img) { transform: scale(1.05); }
    .aiyr__plate:focus-visible { outline: 2px solid var(--color-clay); outline-offset: 2px; }
    .aiyr__year { color: var(--color-clay); display: block; font-size: 1rem; }
    .aiyr__cap { color: #d2c5af; font-size: 0.875rem; line-height: 1.45; max-width: 44ch; }
    .aiyr__cap :global(strong) { color: var(--color-bone-on-night); }
    .aihist__intro { margin-bottom: 0; }
    .aiyr__cap :global(a) { color: var(--color-bone-on-night); text-decoration: none; border-bottom: 1px solid color-mix(in srgb, var(--color-clay) 65%, transparent); padding-bottom: 1px; transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out); }
    .aiyr__cap :global(a:hover) { color: var(--color-clay); border-color: var(--color-clay); }
    @media (max-width: 640px) {
      .aihist__row { flex-direction: column; }
      .aiyr { flex: none !important; }
    }

    /* "The year is 2033" scenario — sits between the quotes and the video */
    .ai__scenario { margin-top: 2.5rem; }

    /* Featured video at the end of §04 Off-Grid AI */
    .ai__feature { margin: 3rem 0 0; }
    .ai__video { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; background: var(--color-night); border: 1px solid var(--color-rule); }
    .ai__feature-cap { display: block; margin-top: 0.85rem; color: var(--color-ink-3); }

    /* ─── lightbox ─── */
    .lb-box { position: fixed; inset: 0; z-index: 100; background: rgba(10, 8, 6, 0.95); display: flex; align-items: center; justify-content: center; }
    .lb-box[hidden] { display: none; }
    .lb-box__figure { margin: 0; max-width: min(94vw, 1400px); max-height: 88vh; display: flex; flex-direction: column; align-items: center; gap: 1rem; }
    .lb-box__imgwrap { position: relative; width: 100%; max-height: 76vh; display: flex; align-items: center; justify-content: center; }
    .lb-box__imgwrap :global(img) { display: none; max-width: 100%; max-height: 76vh; width: auto; height: auto; object-fit: contain; }
    .lb-box__imgwrap :global(img.is-active) { display: block; }
    .lb-box__cap { text-align: center; color: var(--color-bone-on-night); font-family: var(--font-body); font-size: var(--text-meta); display: flex; flex-direction: column; gap: 0.2rem; }
    .lb-box__cap-text { font-style: italic; }
    .lb-box__cap-meta { letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-clay); font-weight: 700; }
    .lb-box__close, .lb-box__nav { position: absolute; background: transparent; color: var(--color-bone-on-night); border: 1.5px solid color-mix(in srgb, var(--color-bone-on-night) 40%, transparent); width: 3rem; height: 3rem; cursor: pointer; font-family: var(--font-display); font-size: 1.5rem; line-height: 1; display: flex; align-items: center; justify-content: center; transition: border-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out); }
    .lb-box__close:hover, .lb-box__nav:hover { color: var(--color-clay); border-color: var(--color-clay); }
    .lb-box__close { top: 1.25rem; right: 1.25rem; }
