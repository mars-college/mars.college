  <script is:inline>
    (() => {
      const wrap = document.getElementById("art-carousel");
      if (!wrap) return;
      const track = wrap.querySelector(".art__track");
      const step = () => {
        const slide = track.querySelector(".art__slide");
        const gap = parseFloat(getComputedStyle(track).gap) || 16;
        return slide.getBoundingClientRect().width + gap;
      };
      wrap.querySelector(".art__nav--prev").addEventListener("click", () =>
        track.scrollBy({ left: -step(), behavior: "smooth" })
      );
      wrap.querySelector(".art__nav--next").addEventListener("click", () =>
        track.scrollBy({ left: step(), behavior: "smooth" })
      );
    })();
  </script>

  <script is:inline>
    (() => {
      const box = document.getElementById("lightbox");
      if (!box) return;
      const slides = Array.from(box.querySelectorAll("[data-lb-slide]"));
      const capText = box.querySelector(".lb-box__cap-text");
      const capMeta = box.querySelector(".lb-box__cap-meta");
      const triggers = Array.from(document.querySelectorAll(".lb[data-lb-id]"));
      // id → index in slides
      const order = slides.map((el) => el.dataset.lbSlide);
      // For caption lookup: id → { cap, track } from data attrs on the trigger.
      const meta = {};
      triggers.forEach((t) => {
        const id = t.dataset.lbId;
        const img = t.querySelector("img");
        meta[id] = {
          cap: (img && img.alt) || "",
          track: "",
        };
      });
      let cur = 0;
      const show = (i) => {
        cur = (i + order.length) % order.length;
        slides.forEach((el, idx) => el.classList.toggle("is-active", idx === cur));
        const id = order[cur];
        const m = meta[id] || {};
        capText.textContent = m.cap || "";
        capMeta.textContent = m.track || "";
      };
      const open = (id) => {
        const idx = order.indexOf(id);
        if (idx < 0) return;
        box.hidden = false;
        document.body.style.overflow = "hidden";
        show(idx);
      };
      const close = () => {
        box.hidden = true;
        document.body.style.overflow = "";
      };
      triggers.forEach((t) => {
        t.addEventListener("click", (e) => {
          e.preventDefault();
          open(t.dataset.lbId);
        });
      });
      box.querySelector(".lb-box__close").addEventListener("click", close);
      box.querySelector(".lb-box__nav--prev").addEventListener("click", () => show(cur - 1));
      box.querySelector(".lb-box__nav--next").addEventListener("click", () => show(cur + 1));
      box.addEventListener("click", (e) => {
        if (e.target === box) close();
      });
      document.addEventListener("keydown", (e) => {
        if (box.hidden) return;
        if (e.key === "Escape") close();
        if (e.key === "ArrowLeft") show(cur - 1);
        if (e.key === "ArrowRight") show(cur + 1);
      });
    })();
  </script>

  <style>
    /* ─── combined header: hero image + emblem ─── */
    /* --seal-w is the single source of truth for emblem size; the media
       queries below override it per breakpoint. */
    /* --seal-max is a hard ceiling: the seal never grows past it, so it can't
       creep across the frame and cover the teacher in the hero photo. */
    .mith { position: relative; overflow: hidden; isolation: isolate; --seal-max: 550px; --seal-w: min(clamp(12rem, 18vw, 17rem), var(--seal-max)); }
    .mith__bg { position: absolute; inset: 0; z-index: -1; }
    /* Left-anchored crop: as the viewport narrows, the right side of the
       photo is trimmed first, keeping the teacher + projection in view.
       The x-position steps up on small screens so the crop stops at the
       projector's right edge (~55% of the frame). */
    .mith__img { width: 100%; height: 100%; object-fit: cover; object-position: 0% 32%; }
    @media (max-width: 700px) { .mith__img { object-position: 18% 32%; } }
    @media (max-width: 460px) { .mith__img { object-position: 25% 32%; } }
    /* darkest in the bottom-left corner where the seal + text sit; the
       projected screens (upper area) stay clear */
