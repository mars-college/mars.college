    /* Crest rail: big seal with the tagline stacked beneath it. */
    .mith__crest { margin-top: auto; display: flex; flex-direction: column; align-items: flex-start; gap: clamp(1.1rem, 2vw, 1.6rem); max-width: clamp(16rem, 27vw, 23rem); }
    /* Desktop: one tight left-justified rail — MIT label, emblem, text —
       vertically centered as a group. Mobile keeps label top / crest bottom. */
    @media (min-width: 641px) {
      /* The rail hugs the TOP of the header — no dead space above "MIT" —
