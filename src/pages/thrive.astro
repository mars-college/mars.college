---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Eyebrow from "../components/Eyebrow.astro";
import {
  COSTS,
  EARN_BACK,
  SHARED_AMENITIES,
  RETURNING_SERVICES,
  APPLY_URL,
} from "../data/site";

import headerImg from "../assets/photos/community-market.jpg";
import dinnerImg from "../assets/photos/activities/dinner.jpg";
---

<BaseLayout noindex={true}
  title="Thrive — Desert Nomad Economics · Mars College 2027"
  description="Desert nomad economics for Mars 2027: about $1,500 for the season, with micro-businesses and grants to earn it back."
>
  <PageHeader
    index="03"
    label="Thrive — Desert Nomad Economics"
    title="Live well off-grid for about $1,500."
    lede="What it costs, what's shared, and how Martians earn it back."
    image={headerImg}
    imageAlt="The community market at Mars College"
  />

  <!-- Money out -->
  <section class="u-section">
    <div class="u-shell">
      <Eyebrow index="01" label="What it costs" />
      <ul class="costs">
        {
          COSTS.map((c, i) => (
            <li class="cost">
              <span class="cost__n u-index">{String(i + 1).padStart(2, "0")}</span>
              <span class="cost__amount">{c.amount}</span>
              <div class="cost__detail">
                <h2 class="cost__title">{c.title}</h2>
                <p class="cost__body">{c.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
      <p class="costs__total">
        <span class="u-label">Roughly</span>
        <span class="costs__sum">$1,500</span>
        <span class="costs__cap">for three months off-grid. Mostly prepaid, much of it earnable.</span>
      </p>
    </div>
  </section>

  <!-- Money back -->
  <section class="u-section is-night">
    <div class="u-shell">
      <Eyebrow index="02" label="Earning it back" />
      <h2 class="earn__lead u-display">Mars pays its citizens to run Mars.</h2>
      <p class="earn__intro">
        Treasury, camps, and grants pay people who provide what the village needs.
      </p>
      <ul class="earn__grid">
        {
          EARN_BACK.map((e) => (
            <li class="earn">
              <h3 class="earn__title">{e.title}</h3>
              <p class="earn__body">{e.body}</p>
              <span class="earn__action u-label u-label--clay">{e.action} →</span>
            </li>
          ))
        }
      </ul>
      <p class="earn__warn u-label">
        Grants open in July, close December 1 — but many pay out in DPW credits,
        and materials have lead times. A late grant can't buy what's already too
        late to order.
      </p>
    </div>
  </section>

  <!-- Shared + returning -->
  <section class="u-section">
    <div class="u-shell shared__grid">
      <div class="shared__col">
        <Eyebrow index="03" label="Shared by Treasury" />
        <p class="shared__intro">
          Funded for everyone.
        </p>
        <ul class="taglist">
          {SHARED_AMENITIES.map((s) => <li>{s}</li>)}
        </ul>
      </div>

      <figure class="shared__media u-plate">
        <Image
          src={dinnerImg}
          alt="A communal dinner at Mars College"
          widths={[500, 800, 1100]}
          sizes="(max-width: 900px) 100vw, 40vw"
          format="webp"
          quality={70}
          loading="lazy"
        />
      </figure>

      <div class="shared__col">
        <Eyebrow index="04" label="Returning in 2027" />
        <p class="shared__intro">
          Coming back if providers apply.
        </p>
        <ul class="taglist">
          {RETURNING_SERVICES.map((s) => <li>{s}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- The shape -->
  <section class="u-section--tight">
    <div class="u-shell shape">
      <p class="shape__text u-display">
        Three months off-grid. Then unbuild. Carry the method home.
      </p>
      <div class="shape__cta">
        <a href={APPLY_URL} class="u-cta">
          Apply for 2027 <span aria-hidden="true">→</span>
        </a>
        <span class="u-label shape__note">Rolling admissions · form coming soon</span>
      </div>
    </div>
  </section>

  <style>
    .costs {
      list-style: none;
      margin: 0;
      padding: 0;
      border-top: var(--rule-strong);
    }
    .cost {
      display: grid;
      grid-template-columns: 3rem 12rem 1fr;
      gap: clamp(1rem, 3vw, 2.5rem);
      padding: clamp(1.5rem, 3vw, 2.25rem) 0;
      border-bottom: var(--rule);
      align-items: baseline;
    }
    .cost__n {
      font-size: var(--text-sm);
    }
    .cost__amount {
      font-family: var(--font-display);
      font-size: clamp(1.8rem, 4vw, 2.8rem);
      font-weight: 800;
      color: var(--color-clay);
      line-height: 1;
    }
    .cost__title {
      font-family: var(--font-display);
      font-size: clamp(1.3rem, 2.4vw, 1.7rem);
      font-weight: 800;
    }
    .cost__body {
      margin-top: 0.4rem;
      color: var(--color-ink-2);
      max-width: 52ch;
    }
    @media (max-width: 700px) {
      .cost {
        grid-template-columns: 1fr;
        gap: 0.4rem;
      }
    }
    .costs__total {
      display: flex;
      align-items: baseline;
      gap: 1rem;
      flex-wrap: wrap;
      margin-top: 2rem;
    }
    .costs__sum {
      font-family: var(--font-display);
      font-size: clamp(2.4rem, 6vw, 4rem);
      font-weight: 800;
      line-height: 1;
    }
    .costs__cap {
      color: var(--color-ink-2);
      max-width: 36ch;
      font-size: var(--text-base);
    }

    /* earn */
    .earn__lead {
      font-size: clamp(1.9rem, 4vw, 3rem);
    }
    .earn__intro {
      margin-top: 1rem;
      color: #cabda6;
      max-width: 50ch;
      margin-bottom: 2.5rem;
    }
    .earn__grid {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
      border-top: 1px solid var(--color-rule-night);
      border-left: 1px solid var(--color-rule-night);
    }
    .earn {
      padding: clamp(1.5rem, 3vw, 2.25rem);
      border-right: 1px solid var(--color-rule-night);
      border-bottom: 1px solid var(--color-rule-night);
    }
    .earn__title {
      font-family: var(--font-display);
      font-size: clamp(1.4rem, 2.6vw, 2rem);
      font-weight: 800;
      color: var(--color-bone-on-night);
    }
    .earn__body {
      margin-top: 0.6rem;
      color: #cabda6;
      max-width: 42ch;
    }
    .earn__action {
      display: inline-block;
      margin-top: 1.25rem;
    }
    .earn__warn {
      margin-top: 1.75rem;
      text-transform: none;
      letter-spacing: 0.02em;
      color: #9c8e76;
      max-width: 56ch;
      line-height: 1.55;
    }
    @media (max-width: 640px) {
      .earn__grid {
        grid-template-columns: 1fr;
      }
    }

    /* shared + returning */
    .shared__grid {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: clamp(2rem, 5vw, 4rem);
      align-items: start;
    }
    .shared__intro {
      margin-top: -0.5rem;
      color: var(--color-ink-2);
      margin-bottom: 1.5rem;
    }
    .shared__media {
      aspect-ratio: 3 / 4;
    }
    .taglist {
      list-style: none;
      margin: 0;
      padding: 0;
      border-top: var(--rule);
    }
    .taglist li {
      padding: 0.8rem 0;
      border-bottom: var(--rule);
      font-family: var(--font-body);
      font-size: var(--text-base);
      font-weight: 500;
      color: var(--color-ink);
    }
    @media (max-width: 860px) {
      .shared__grid {
        grid-template-columns: 1fr 1fr;
      }
      .shared__media {
        grid-row: span 1;
        grid-column: 1 / -1;
        aspect-ratio: 16 / 9;
        order: 3;
      }
    }
    @media (max-width: 560px) {
      .shared__grid {
        grid-template-columns: 1fr;
      }
    }

    /* shape */
    .shape {
      border-top: var(--rule-strong);
      padding-top: 2.5rem;
    }
    .shape__text {
      font-size: clamp(1.7rem, 3.6vw, 2.8rem);
      max-width: 28ch;
      line-height: 1.1;
    }
    .shape__cta {
      margin-top: 2rem;
      display: flex;
      align-items: center;
      gap: 1.25rem;
      flex-wrap: wrap;
    }
    .shape__note {
      color: var(--color-ink-3);
    }
  </style>
</BaseLayout>
