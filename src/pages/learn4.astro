---
// /learn4 — "Day in the Life"
// Opens with the week-grid as the lede. Photos illustrate specific days.
// Then tracks, AI program, season tentpoles, off-season cohort.
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Eyebrow from "../components/Eyebrow.astro";
import {
  AI_PROGRAM_TOPICS,
  AI_PROGRAM_LOCK_NOTE,
  TRACKS,
  WEEK,
  TERM,
  COHORT,
  QUOTES,
} from "../data/learn-program";
import { APPLY_URL } from "../data/site";

// Day-keyed photos
import heroImg from "../assets/photos/learn/045_2024_2026_p1036172_1.JPG";
import dayMon from "../assets/photos/learn/supp_2023_acroyoga_desert.jpg"; // Marsbod yoga
import dayTue from "../assets/photos/learn/supp_2022_clay_vessels.jpg"; // ceramics
import dayWed from "../assets/photos/learn/002_2026_dscf1586_ece64.jpg"; // Thunder Talks
import dayThu from "../assets/photos/learn/020_2026_dscf0028_1bd1c.jpg"; // music theory
import dayFri from "../assets/photos/learn/supp_2023_livecode_tidal.jpg"; // livecode
import daySat from "../assets/photos/learn/050_2024_img_8542_bb32a.jpg"; // celebration
import daySun from "../assets/photos/learn/supp_2022_noodle_kitchen.jpg"; // noodle bar

import circleImg from "../assets/photos/learn/038_2022_img_4312_95dfd.jpg";
import outdoorImg from "../assets/photos/learn/013_2022_pxl_20220116_020317372_night_dd72d.jpg";
import workshopImg from "../assets/photos/learn/supp_2021_workshop_panoramic.jpg";

const dayPhotos: Record<string, any> = {
  Mon: dayMon, Tue: dayTue, Wed: dayWed, Thu: dayThu,
  Fri: dayFri, Sat: daySat, Sun: daySun,
};

const tentpoles = TERM.filter((t) => ["term", "build"].includes(t.kind));
---

<BaseLayout noindex={true}
  title="Learn — Mars College 2027"
  description="A day in the life at Mars College, multiplied by 90. Plus the AI program, the open calendar, and the off-season online cohort."
>
  <PageHeader
    index="02"
    label="Learn · A day in the life"
    title="A day in the life. Multiplied by 90."
    lede="What you actually do at Mars College: yoga at sunrise, AI lab at noon, Thunder Talks Wednesday, algorave Saturday. Multiply by ninety days."
    image={heroImg}
    imageAlt="Mars College class at night with audience lit by colorful projection"
  />

  <!-- ===================== THE WEEK ===================== -->
  <section class="u-section week">
    <div class="u-shell">
      <Eyebrow index="01" label="The week" />
      <h2 class="week__lead u-display">Seven days in the desert.</h2>
      <p class="week__intro u-measure">
        The calendar shifts week to week — that's the open-calendar point. But
        the shape that holds is roughly this. Wednesday nights are <em>always</em>
        Thunder Talks. Mornings are <em>almost always</em> Marsbod. The rest is
        whatever Martians put on the calendar.
      </p>

      <ol class="ditl">
        {WEEK.map((d) => (
          <li class="ditl__day">
            <div class="ditl__photo u-plate">
              <Image
                src={dayPhotos[d.day]}
                alt={`${d.day} at Mars College — ${d.evening}`}
                widths={[500, 800, 1100]}
                sizes="(max-width: 720px) 100vw, 33vw"
                format="webp"
                quality={68}
                loading="lazy"
              />
            </div>
            <div class="ditl__text">
              <h3 class="ditl__name">{d.day}</h3>
              <dl>
                <dt>Morning</dt><dd>{d.morning}</dd>
                <dt>Midday</dt><dd>{d.midday}</dd>
                <dt>Evening</dt><dd>{d.evening}</dd>
              </dl>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Pull quote -->
  <section class="u-section--tight quote">
    <div class="u-shell quote__shell">
      <blockquote>
        <p class="u-display">{QUOTES[1].text}</p>
        <cite>— {QUOTES[1].source}</cite>
      </blockquote>
    </div>
  </section>

  <!-- ===================== TRACKS ===================== -->
  <section class="u-section is-night tracks">
    <div class="u-shell">
      <Eyebrow index="02" label="Tracks" />
      <h2 class="tracks__lead u-display">What gets put on the calendar.</h2>
      <p class="tracks__intro u-measure">
        Some of these are full departments. Some are one Wednesday. Both count.
      </p>
      <ul class="tracks__list">
        {TRACKS.map((t) => (
          <li class="trk">
            <h3 class="trk__name">
              {t.name}
              <span class="trk__since">since {t.since}</span>
            </h3>
            <p class="trk__body">{t.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ===================== AI PROGRAM ===================== -->
  <section class="u-section ai">
    <div class="u-shell ai__grid">
      <div>
        <Eyebrow index="03" label="The AI program — the spine" />
        <h2 class="ai__lead u-display">Five things every cohort Martian learns.</h2>
        <p class="ai__intro u-measure">
          The Creative AI program has run every year since 2022. The pitch:
          use AI to expand your understanding of the things you already know and
          care about. The program is not "about AI" so much as it's about wielding
          it on your own work.
        </p>
        <ol class="ai__topics">
          {AI_PROGRAM_TOPICS.map((t) => (
            <li>
              <span class="u-index">{t.n}</span>
              <h3>{t.title}</h3>
              <p>{t.body}</p>
            </li>
          ))}
        </ol>
        <p class="ai__note">
          <span class="u-label u-label--clay">Note</span>
          {AI_PROGRAM_LOCK_NOTE}
        </p>
      </div>
      <figure class="ai__media u-plate">
        <Image
          src={workshopImg}
          alt="A panoramic view inside the Mars College workshop"
          widths={[600, 900, 1200]}
          sizes="(max-width: 900px) 100vw, 40vw"
          format="webp"
          quality={70}
          loading="lazy"
        />
      </figure>
    </div>
  </section>

  <!-- ===================== SEASON TENTPOLES ===================== -->
  <section class="u-section is-night tent">
    <div class="u-shell">
      <Eyebrow index="04" label="Tentpoles of the season" />
      <h2 class="tent__lead u-display">Five beats hold the term together.</h2>
      <ol class="tent__list">
        <li>
          <span class="tent__n u-index">01</span>
          <h3>Build Week</h3>
          <p>Nov–Dec. The whole village goes up from pallet racks and plywood. Roof over the kitchen. Power on the panels. Calendar populated.</p>
        </li>
        <li>
          <span class="tent__n u-index">02</span>
          <h3>Ideas Week</h3>
          <p>Jan 11–17. Everyone gives a lightning talk. Newcomers introduce themselves; veterans re-pitch. Collaborators get found. Threads form.</p>
        </li>
        <li>
          <span class="tent__n u-index">03</span>
          <h3>Moons of Mars</h3>
          <p>One gallery show per month. January, February, March. Open openings, fresh work between each — no recycling.</p>
        </li>
        <li>
          <span class="tent__n u-index">04</span>
          <h3>Declaration Days</h3>
          <p>Feb 13–15. Midterm. Show what you've got. Declare intentions for the second half. AI hackathon for the cohort.</p>
        </li>
        <li>
          <span class="tent__n u-index">05</span>
          <h3>Mars Electronica</h3>
          <p>Mar 26–28. Gallery opening, AI Film Festival, algorave, performances. The release party. Public-facing. Not graded.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ===================== OFF-SEASON COHORT ===================== -->
  <section class="u-section offs">
    <div class="u-shell offs__grid">
      <div>
        <Eyebrow index="05" label="The off-season — online" />
        <h2 class="offs__lead u-display">A four-month head start.</h2>
        <p class="offs__intro u-measure">{COHORT.blurb}</p>
        <ul class="offs__list">
          {COHORT.bullets.map((b) => (
            <li>
              <h3>{b.title}</h3>
              <p>{b.body}</p>
            </li>
          ))}
        </ul>
      </div>
      <aside class="offs__sched">
        <p class="u-label u-label--clay">Online cohort calendar</p>
        <ol>
          <li><span>Aug 24</span><span>Cohort begins</span></li>
          <li><span>Sep – Oct</span><span>Weekly workshops</span></li>
          <li><span>Mid-cohort</span><span>Hackathon weekend</span></li>
          <li><span>Nov – Dec</span><span>Project work + office hours</span></li>
          <li><span>December</span><span>Demo day</span></li>
          <li><span>Jan 4</span><span>Optional crossover to the desert</span></li>
        </ol>
      </aside>
    </div>
  </section>

  <!-- Closing photo strip -->
  <section class="u-section--tight strip">
    <div class="u-shell">
      <ul class="strip__row">
        <li class="u-plate"><Image src={circleImg} alt="Hangar circle" widths={[400,700,1000]} sizes="33vw" format="webp" quality={66} loading="lazy" /></li>
        <li class="u-plate"><Image src={outdoorImg} alt="Outdoor ideas-week talk" widths={[400,700,1000]} sizes="33vw" format="webp" quality={66} loading="lazy" /></li>
        <li class="u-plate"><Image src={daySat} alt="Mars Electronica" widths={[400,700,1000]} sizes="33vw" format="webp" quality={66} loading="lazy" /></li>
      </ul>
    </div>
  </section>

  <!-- ===================== CTA ===================== -->
  <section class="u-section--tight">
    <div class="u-shell cta-band">
      <p class="cta-band__text u-display">
        Multiply ninety days. Bring the work you want to make.
      </p>
      <a href={APPLY_URL} class="u-cta">
        Apply for 2027 <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <style>
    /* week */
    .week__lead { font-size: var(--text-3xl); max-width: 18ch; }
    .week__intro { margin-top: 1rem; color: var(--color-ink-2); margin-bottom: 2.5rem; }
    .week__intro em { color: var(--color-clay); font-style: italic; font-weight: 700; }
    .ditl { list-style: none; padding: 0; margin: 0; display: grid; gap: 0; border-top: var(--rule-strong); }
    .ditl__day { display: grid; grid-template-columns: 16rem 1fr; gap: clamp(1.25rem, 3vw, 2.5rem); padding: 1.5rem 0; border-bottom: var(--rule); align-items: center; }
    .ditl__day:nth-child(even) { grid-template-columns: 1fr 16rem; }
    .ditl__day:nth-child(even) .ditl__photo { order: 2; }
    .ditl__day:nth-child(even) .ditl__text { order: 1; }
    .ditl__photo { aspect-ratio: 4 / 3; }
    .ditl__name { font-family: var(--font-display); font-weight: 800; font-size: clamp(2.2rem, 4vw, 3.2rem); letter-spacing: -0.03em; line-height: 1; color: var(--color-clay); }
    .ditl__text dl { display: grid; grid-template-columns: 6rem 1fr; gap: 0.4rem 1rem; margin-top: 1rem; }
    .ditl__text dt { font-family: var(--font-body); font-size: 0.8rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-ink-3); font-weight: 700; padding-top: 0.15rem; }
    .ditl__text dd { color: var(--color-ink); margin: 0; }
    @media (max-width: 720px) {
      .ditl__day, .ditl__day:nth-child(even) { grid-template-columns: 1fr; }
      .ditl__day:nth-child(even) .ditl__photo { order: 0; }
      .ditl__day:nth-child(even) .ditl__text { order: 0; }
      .ditl__text dl { grid-template-columns: 5rem 1fr; }
    }

    /* quote */
    .quote__shell { max-width: 70ch; margin-inline: auto; }
    .quote blockquote { border-top: var(--rule-strong); border-bottom: var(--rule-strong); padding: 2rem 0; text-align: center; }
    .quote blockquote p { font-size: clamp(1.4rem, 2.6vw, 2rem); line-height: 1.3; color: var(--color-clay-deep); font-weight: 700; letter-spacing: -0.01em; }
    .quote blockquote cite { display: block; margin-top: 1rem; font-style: normal; font-size: var(--text-meta); letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-ink-3); }

    /* tracks (night) */
    .tracks__lead { font-size: var(--text-3xl); color: var(--color-bone-on-night); max-width: 22ch; }
    .tracks__intro { margin-top: 1rem; color: #cabda6; margin-bottom: 2rem; }
    .tracks__list { list-style: none; margin: 0; padding: 0; }
    .trk { padding: 1.1rem 0; border-bottom: 1px solid var(--color-rule-night); display: grid; grid-template-columns: minmax(15rem, 22rem) 1fr; gap: 1rem 2rem; align-items: baseline; }
    .trk__name { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.3rem, 2vw, 1.6rem); letter-spacing: -0.02em; color: var(--color-bone-on-night); }
    .trk__since { font-family: var(--font-mono); font-size: var(--text-meta); color: var(--color-clay); font-weight: 500; margin-left: 0.6rem; }
    .trk__body { color: #d2c5af; max-width: 60ch; }
    @media (max-width: 720px) { .trk { grid-template-columns: 1fr; gap: 0.4rem; } }

    /* ai */
    .ai__grid { display: grid; grid-template-columns: 1.3fr 0.7fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
    .ai__lead { font-size: clamp(2rem, 4vw, 3rem); max-width: 22ch; }
    .ai__intro { margin-top: 1rem; color: var(--color-ink-2); font-size: var(--text-lg); line-height: 1.5; }
    .ai__topics { list-style: none; margin: 2rem 0 0; padding: 0; border-top: var(--rule-strong); }
    .ai__topics li { padding: 1rem 0; border-bottom: var(--rule); display: grid; grid-template-columns: 3rem 1fr; gap: 0.5rem 1rem; align-items: baseline; }
    .ai__topics li .u-index { color: var(--color-clay); }
    .ai__topics li h3 { font-family: var(--font-display); font-weight: 800; font-size: 1.35rem; }
    .ai__topics li p { color: var(--color-ink-2); grid-column: 2; margin-top: 0.2rem; max-width: 55ch; }
    .ai__media { aspect-ratio: 3 / 4; }
    .ai__note { margin-top: 1.5rem; border-left: 2px solid var(--color-clay); padding: 0.25rem 0 0.25rem 1.25rem; max-width: 60ch; font-size: 1.05rem; }
    .ai__note .u-label { display: block; margin-bottom: 0.4rem; }
    @media (max-width: 820px) { .ai__grid { grid-template-columns: 1fr; } .ai__media { aspect-ratio: 16 / 10; } }

    /* tent */
    .tent__lead { font-size: var(--text-3xl); color: var(--color-bone-on-night); max-width: 22ch; }
    .tent__list { list-style: none; margin: 2rem 0 0; padding: 0; counter-reset: tent; }
    .tent__list li { padding: 1.5rem 0; border-bottom: 1px solid var(--color-rule-night); display: grid; grid-template-columns: 5rem 1fr; gap: 0.5rem 2rem; align-items: baseline; }
    .tent__n { color: var(--color-clay); }
    .tent__list li h3 { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.4rem, 2.4vw, 1.85rem); color: var(--color-bone-on-night); }
    .tent__list li p { color: #d2c5af; grid-column: 2; margin-top: 0.3rem; max-width: 60ch; }
    @media (max-width: 560px) { .tent__list li { grid-template-columns: 1fr; gap: 0.3rem; } .tent__list li p { grid-column: 1; } }

    /* off-season */
    .offs__grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
    .offs__lead { font-size: clamp(1.9rem, 4vw, 3rem); max-width: 18ch; }
    .offs__intro { margin-top: 1rem; color: var(--color-ink-2); font-size: var(--text-lg); }
    .offs__list { list-style: none; margin: 2rem 0 0; padding: 0; }
    .offs__list li { padding: 1.1rem 0; border-bottom: var(--rule); }
    .offs__list h3 { font-family: var(--font-display); font-weight: 800; font-size: 1.15rem; }
    .offs__list p { margin-top: 0.4rem; color: var(--color-ink-2); }
    .offs__sched { background: var(--color-night); color: var(--color-bone-on-night); padding: 1.5rem; }
    .offs__sched ol { list-style: none; padding: 0; margin: 1rem 0 0; }
    .offs__sched li { display: grid; grid-template-columns: 7rem 1fr; gap: 0.5rem; padding: 0.65rem 0; border-bottom: 1px solid var(--color-rule-night); }
    .offs__sched li span:first-child { font-family: var(--font-mono); font-size: var(--text-meta); color: var(--color-clay); }
    @media (max-width: 820px) { .offs__grid { grid-template-columns: 1fr; } }

    /* strip */
    .strip__row { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(0.5rem, 1.2vw, 1rem); }
    .strip__row li { aspect-ratio: 4 / 3; overflow: hidden; }
    .strip__row li :global(img) { width: 100%; height: 100%; object-fit: cover; }
    @media (max-width: 640px) { .strip__row { grid-template-columns: 1fr; } }

    /* cta */
    .cta-band { display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap; border-top: var(--rule-strong); padding-top: 2.5rem; }
    .cta-band__text { font-size: clamp(1.6rem, 3.4vw, 2.6rem); max-width: 26ch; }
  </style>
</BaseLayout>
