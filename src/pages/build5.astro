---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Eyebrow from "../components/Eyebrow.astro";
import {
  BUILD_SCHEDULE,
  BUILD_FAQ,
  TALLY_BUILD_FORM_ID,
  BUILD_SUBSTACK_URL,
  APPLY_URL,
} from "../data/site";

// Hero — the money shot
import hero from "../assets/photos/build-curated/047_2026_img_1144_2f1d9.jpg";

// The arc — four phases (FIXED: phase 1 & 4 are now truly bare playa)
import phaseBare from "../assets/photos/build-curated/bare-playa-survey-2025.jpg";
import phaseSkeleton from "../assets/photos/build-curated/005_2025_2026_pxl_20251112_235328377_bb796.jpg";
import phaseFinished from "../assets/photos/aerial-3.jpg";
import phaseReturned from "../assets/photos/build-curated/bare-playa-sunset-2020.jpg";

// What gets built — structures (with year captions)
import strAmph from "../assets/photos/build-curated/047_2025_img_8497_70ffe.jpg";
import strPavilion from "../assets/photos/build-curated/035_2025_2026_rn_image_picker_lib_temp_b98e501f_86f0_478_dc559.jpg";
import strGallery from "../assets/photos/build/mural-solar.jpg";
import strProjWall from "../assets/photos/build/solar-pyramid.jpg";

// DPW intro section
import dpwHero from "../assets/photos/build-curated/010_2026_image3_0db2d.jpg";

// Closer
import closer from "../assets/photos/build-curated/021_2025_2026_img_20251116_161732_63192.jpg";

const arc = [
  { img: phaseBare, cap: "Bare playa. October.", note: "Site survey before build begins." },
  { img: phaseSkeleton, cap: "Skeleton up. November.", note: "Pallet racks rise. Plywood, lumber, solar follow." },
  { img: phaseFinished, cap: "The village. January.", note: "A hundred-plus people living off-grid for three months." },
  { img: phaseReturned, cap: "Returned to desert. May.", note: "Structures struck. Stored. Land left as we found it." },
];

const structures = [
  {
    n: "01",
    name: "The Amphitheater",
    role: "Outdoor stage · projection wall · gatherings",
    img: strAmph,
    imgCap: "Pallet-rack build, MC25",
    body: "Open-air stage and seating with north and west wind walls. The north wall doubles as a projection surface. Hosts Thunder Talks, music, algoraves, and large gatherings. A lighter, more honest build than past Chibas.",
  },
  {
    n: "02",
    name: "The Pavilion",
    role: "80 ft shade structure · living room · café",
    img: strPavilion,
    imgCap: "Build day, MC26",
    body: "Burning Man Center Camp-style shade structure. Eighty-foot diameter, shade net on a pallet rack frame in concentric rings. Comfortable seating, wind and sun protection, no solid walls. The daily living room. A central tower with a spiral staircase is on the table.",
  },
  {
    n: "03",
    name: "AI Gallery & Climate Refuge",
    role: "Enclosed · gallery · compute · classroom",
    img: strGallery,
    imgCap: "Painted pyramid, past Mars season",
    body: "Smaller, fully enclosed, climate-controlled. Part of the AI Department. Plays four roles at once: gallery (screens, projection, darkness), compute room, bad-weather refuge, and AI classroom.",
  },
  {
    n: "04",
    name: "The Projection Wall",
    role: "Freestanding 20×60 ft · classrooms behind",
    img: strProjWall,
    imgCap: "Solar pyramid, past Mars season",
    body: "A standalone twenty-by-sixty-foot artifact with classrooms tucked behind it. No longer fused into a monolith. The thing you can see from across the playa at sunset.",
  },
];

const corners = [
  { name: "Cahuilla", use: "Kitchen" },
  { name: "HQB", use: "Gallery" },
  { name: "Chatsubo", use: "Club / Bar" },
  { name: "Ba Sing Se", use: "Lounge" },
];

const TRACKS = [
  {
    title: "DPW crew",
    when: "Apply by Oct 1, 2026",
    body: "Build (Nov–Dec), maintain (Jan–Mar), strike (Mar–Apr). Housing, fee waived, meal plan.",
  },
  {
    title: "Concession operator",
    when: "Inquire any time",
    body: "Run a service Mars needs — fridge, ice, water, solar, food co-op, EUC repair, dump runs. Vendor channel through DPW.",
  },
  {
    title: "Grant applicant",
    when: "Open July → Dec 1, 2026",
    body: "Gallery, bakery, kiln, tool library, large-scale art. Issued as DPW credits, spendable on materials and services.",
  },
  {
    title: "First Camp build-track",
    when: "Arrive late December",
    body: "New to Mars. Enter through the build. Earn your season through infrastructure work. Lighter academic load.",
  },
];
---

<BaseLayout noindex={true}
  title="Build — Mars College 2027"
  description="Mars College is an off-grid pop-up college raised from bare desert every winter and taken back down each spring. Help build the 2027 village. Housing, meals, fee waived."
>
  <!-- ============= HERO ============= -->
  <section class="hero5">
    <div class="hero5__bg" aria-hidden="true">
      <Image
        src={hero}
        alt="Six Mars College builders lifting a horizontal orange pallet-rack beam together at sunset"
        widths={[768, 1280, 1920]}
        sizes="100vw"
        format="webp"
        quality={74}
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero5__scrim"></div>
    </div>
    <div class="u-shell hero5__content">
      <p class="u-eyebrow hero5__eyebrow">
        <span class="u-index">SEASON 8</span>
        <span class="u-label">Build · 2027</span>
      </p>
      <h1 class="hero5__title u-display u-rise">
        Come help build<br />
        <span class="hero5__title-em">the next Mars.</span>
      </h1>
      <p class="hero5__lede u-rise" style="animation-delay:120ms">
        Mars College is an off-grid pop-up college raised from bare desert every
        winter and taken back down each spring. Build crew is open for the 2027
        village. <strong>Housing, meals, and your season fee — covered.</strong>
      </p>
      <div class="hero5__actions u-rise" style="animation-delay:200ms">
        <a href="#inquire" class="u-cta">Apply to build <span aria-hidden="true">→</span></a>
        <a href="#arc" class="u-link hero5__what">See the arc <span class="u-arrow" aria-hidden="true">↓</span></a>
      </div>
      <p class="hero5__deadline u-label">Applications close · October 1, 2026</p>
    </div>
  </section>

  <!-- ============= THE ARC ============= -->
  <section id="arc" class="u-section is-night arc5">
    <div class="u-shell">
      <Eyebrow index="01" label="The arc, in four photographs" />
      <h2 class="arc5__title u-display">From nothing to a town to nothing again.</h2>
    </div>
    <div class="u-shell arc5__grid">
      {
        arc.map((p, i) => (
          <figure class="arc5__cell">
            <div class="u-plate arc5__plate">
              <Image
                src={p.img}
                alt={p.cap}
                widths={[600, 1000, 1400]}
                sizes="(max-width: 900px) 100vw, 50vw"
                format="webp"
                quality={68}
                loading="lazy"
              />
            </div>
            <figcaption class="arc5__cap">
              <div class="arc5__cap-head">
                <span class="u-index">{String(i + 1).padStart(2, "0")}</span>
                <span class="arc5__cap-text">{p.cap}</span>
              </div>
              <p class="arc5__cap-note">{p.note}</p>
            </figcaption>
          </figure>
        ))
      }
    </div>
    <div class="u-shell arc5__coda">
      <p class="arc5__coda-text">
        Cycle repeats. Year eight in a row in 2027.
      </p>
    </div>
  </section>

  <!-- ============= MEET DPW ============= -->
  <section class="u-section dpw5">
    <div class="u-shell dpw5__grid">
      <div class="dpw5__text">
        <Eyebrow index="02" label="Department of Public Works" />
        <h2 class="dpw5__title u-display">
          Who builds and runs the village.
        </h2>
        <p class="dpw5__body">
          For 2027 we're formalizing infrastructure under <strong>Mars DPW</strong>
          (formerly Desert Camp Services). Freeman runs it. DPW handles
          procurement, delivery, maintenance, and strike for every physical
          system the camps plug into: power, water, shelter, gear.
        </p>
        <p class="dpw5__body">
          The big practical change this year is that all material formerly
          provided as shared community resource is now rented through DPW. Camps
          plan and budget for their own power, shelter, water, and camp gear.
        </p>
        <p class="dpw5__deep">
          For the full operational picture — material catalog, deadlines,
          concessions, economics — read the
          <a href={BUILD_SUBSTACK_URL} class="u-link dpw5__link">DPW deep dive
            <span class="u-arrow" aria-hidden="true">→</span></a>
        </p>
      </div>
      <figure class="u-plate dpw5__media">
        <Image
          src={dpwHero}
          alt="A pallet-rack structure being assembled with people working, solar panels on the roof, tire circle in the foreground"
          widths={[500, 900, 1300]}
          sizes="(max-width: 900px) 100vw, 50vw"
          format="webp"
          quality={70}
          loading="lazy"
        />
        <figcaption class="dpw5__cap u-label">DPW crew · MC26 build, 2025</figcaption>
      </figure>
    </div>
  </section>

  <!-- ============= WHAT GETS BUILT ============= -->
  <section class="u-section is-night structures5">
    <div class="u-shell structures5__head">
      <Eyebrow index="03" label="What gets built · references from previous builds" />
      <h2 class="structures5__title u-display">
        Four structures. No monolith.
      </h2>
      <p class="structures5__lede">
        The old Chiba — one big building that held the bar, library, gallery,
        and stage — splits this year into four purpose-built structures. Each
        is a different solution to a different problem. Photographs below are
        from past Mars builds.
      </p>
    </div>

    <div class="u-shell">
      <ol class="strs5__list">
        {
          structures.map((s, i) => (
            <li class:list={["strs5", { "is-reverse": i % 2 === 1 }]}>
              <figure class="strs5__media-wrap">
                <div class="u-plate strs5__media">
                  <Image
                    src={s.img}
                    alt={s.name}
                    widths={[500, 900, 1300]}
                    sizes="(max-width: 900px) 100vw, 50vw"
                    format="webp"
                    quality={70}
                    loading="lazy"
                  />
                </div>
                <figcaption class="strs5__imgcap u-label">{s.imgCap}</figcaption>
              </figure>
              <div class="strs5__text">
                <p class="strs5__meta">
                  <span class="u-index">{s.n} / 04</span>
                  <span class="u-label u-label--clay">{s.role}</span>
                </p>
                <h3 class="strs5__name">{s.name}</h3>
                <p class="strs5__body">{s.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="u-shell square5">
      <div class="square5__head">
        <p class="u-label u-label--clay square5__eyebrow">Town square · four corner buildings</p>
        <p class="square5__intro">
          A commercial district around center camp delivers café, bakery, juice bar,
          library, cinema, stage. The 2022 elemental names come back as four corner buildings.
        </p>
      </div>
      <ul class="square5__corners">
        {
          corners.map((c, i) => (
            <li class="corner5">
              <span class="u-index">{String(i + 1).padStart(2, "0")}</span>
              <h4 class="corner5__name">{c.name}</h4>
              <p class="corner5__use u-label">{c.use}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============= FOUR WAYS IN ============= -->
  <section class="u-section tracks5">
    <div class="u-shell">
      <Eyebrow index="04" label="Four ways in" />
      <h2 class="tracks5__title u-display">
        Pick a track. Each one earns its way differently.
      </h2>
      <ul class="tracks5__grid">
        {
          TRACKS.map((t, i) => (
            <li class="track5">
              <p class="track5__meta">
                <span class="u-index">{String(i + 1).padStart(2, "0")}</span>
                <span class="u-label u-label--clay">{t.when}</span>
              </p>
              <h3 class="track5__title">{t.title}</h3>
              <p class="track5__body">{t.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============= TIMELINE ============= -->
  <section class="u-section--tight is-night timeline5">
    <div class="u-shell">
      <Eyebrow index="05" label="Build calendar · 2026–2027" />
      <ol class="timeline5__list">
        {
          BUILD_SCHEDULE.map((s) => (
            <li class="timeline5__item">
              <span class="timeline5__date">{s.date}</span>
              <span class="timeline5__label">{s.label}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============= FAQ ============= -->
  <section class="u-section faq5">
    <div class="u-shell">
      <Eyebrow index="06" label="Questions builders ask" />
      <ul class="faq5__list">
        {
          BUILD_FAQ.map((item, i) => (
            <li class="faq5__item">
              <details>
                <summary>
                  <span class="u-index">{String(i + 1).padStart(2, "0")}</span>
                  <span class="faq5__q">{item.q}</span>
                  <span class="faq5__chevron" aria-hidden="true">+</span>
                </summary>
                <p class="faq5__a">{item.a}</p>
              </details>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============= INQUIRY ============= -->
  <section id="inquire" class="u-section is-night inquire5">
    <div class="u-shell inquire5__grid">
      <div>
        <Eyebrow index="07" label="Apply to build" />
        <h2 class="inquire5__title u-display">Tell us what you'll bring.</h2>
        <p class="inquire5__body">
          A short form for build crew, strike crew, or DPW concessions. We'll
          follow up about phases and skills.
        </p>
        <p class="inquire5__deep">
          For the full operational picture, read the
          <a href={BUILD_SUBSTACK_URL} class="u-link inquire5__link">DPW deep dive
            <span class="u-arrow" aria-hidden="true">→</span></a>
        </p>
      </div>
      <div class="inquire5__form">
        {
          TALLY_BUILD_FORM_ID ? (
            <iframe
              data-tally-src={`https://tally.so/embed/${TALLY_BUILD_FORM_ID}?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1`}
              loading="lazy"
              width="100%"
              height="640"
              frameborder="0"
              marginheight="0"
              marginwidth="0"
              title="Mars DPW build inquiry"
            />
          ) : (
            <div class="inquire5__placeholder">
              <p class="u-label u-label--clay">Form coming soon</p>
              <p>
                In the meantime, email <a href="mailto:info@mars.college" class="inquire5__email">info@mars.college</a>
                with subject "DPW 2027" — phase(s) you'd join, what you'd bring,
                prior Mars seasons.
              </p>
              <a href={APPLY_URL} class="u-cta inquire5__fallback">
                Or apply to Mars College <span aria-hidden="true">→</span>
              </a>
            </div>
          )
        }
      </div>
    </div>
    <script async src="https://tally.so/widgets/embed.js"></script>
  </section>

  <!-- ============= CLOSER ============= -->
  <section class="closer5">
    <div class="closer5__bg">
      <Image
        src={closer}
        alt="A pallet-rack structure backlit at night with distant lights on the horizon"
        widths={[768, 1280, 1920]}
        sizes="100vw"
        format="webp"
        quality={68}
        loading="lazy"
      />
      <div class="closer5__scrim"></div>
    </div>
    <div class="u-shell closer5__content">
      <p class="closer5__text u-display">
        The town gets built. Come build it.
      </p>
    </div>
  </section>

  <style>
    /* ============================== HERO ============================== */
    .hero5 {
      position: relative;
      background: var(--color-night);
      color: var(--color-bone-on-night);
      overflow: hidden;
      isolation: isolate;
      min-height: clamp(38rem, 88vh, 56rem);
      display: flex;
      flex-direction: column;
    }
    .hero5__bg { position: absolute; inset: 0; z-index: 0; }
    .hero5__bg img { width: 100%; height: 100%; object-fit: cover; object-position: center 55%; }
    .hero5__scrim {
      position: absolute; inset: 0;
      background:
        linear-gradient(
          to top,
          rgba(18, 15, 12, 0.96) 0%,
          rgba(18, 15, 12, 0.72) 40%,
          rgba(18, 15, 12, 0.2) 80%,
          rgba(18, 15, 12, 0.45) 100%
        ),
        linear-gradient(
          to right,
          rgba(18, 15, 12, 0.55) 0%,
          rgba(18, 15, 12, 0.05) 50%,
          rgba(18, 15, 12, 0) 100%
        );
    }
    .hero5__content {
      position: relative; z-index: 2;
      margin-top: auto;
      padding-block: clamp(2rem, 5vh, 3.5rem);
      max-width: 60rem;
    }
    .hero5__eyebrow { color: var(--color-bone-on-night); }
    .hero5__eyebrow::after { background: var(--color-rule-night); }
    .hero5__eyebrow .u-label { color: #c8b89b; }
    .hero5__title {
      font-family: var(--font-display);
      font-weight: 800;
      font-size: clamp(3rem, 8vw, 6.75rem);
      line-height: 0.95;
      letter-spacing: -0.035em;
      text-wrap: balance;
      text-shadow: 0 2px 28px rgba(18, 15, 12, 0.78);
    }
    .hero5__title-em { color: var(--color-clay); }
    .hero5__lede {
      margin-top: 1.5rem;
      max-width: 52ch;
      font-size: clamp(1.15rem, 1.6vw, 1.4rem);
      line-height: 1.5;
      color: #efe6d4;
    }
    .hero5__lede strong { color: var(--color-bone-on-night); font-weight: 700; }
    .hero5__actions {
      margin-top: 2rem;
      display: flex;
      align-items: center;
      gap: 1.75rem;
      flex-wrap: wrap;
    }
    .hero5__what {
      color: var(--color-bone-on-night);
      border-color: var(--color-bone-on-night);
    }
    .hero5__deadline {
      margin-top: 2rem;
      color: var(--color-clay);
    }

    /* ============================== THE ARC ============================== */
    .arc5__title {
      font-size: clamp(1.9rem, 4vw, 3rem);
      color: var(--color-bone-on-night);
      max-width: 22ch;
      margin-bottom: 2.5rem;
    }
    .arc5__grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: clamp(1rem, 2vw, 1.75rem);
      margin-top: 1rem;
    }
    .arc5__cell {
      margin: 0;
    }
    .arc5__plate {
      aspect-ratio: 4 / 3;
    }
    .arc5__cap {
      margin-top: 1rem;
    }
    .arc5__cap-head {
      display: flex;
      align-items: baseline;
      gap: 0.75rem;
    }
    .arc5__cap-head .u-index {
      color: var(--color-clay);
    }
    .arc5__cap-text {
      font-family: var(--font-display);
      font-weight: 800;
      font-size: clamp(1.15rem, 2vw, 1.5rem);
      letter-spacing: -0.02em;
      color: var(--color-bone-on-night);
    }
    .arc5__cap-note {
      margin-top: 0.4rem;
      font-size: var(--text-sm);
      color: #b7a98f;
      max-width: 42ch;
    }
    .arc5__coda {
      margin-top: 2.25rem;
    }
    .arc5__coda-text {
      color: #b7a98f;
      font-size: var(--text-base);
      font-weight: 500;
      max-width: 40ch;
    }
    @media (max-width: 700px) {
      .arc5__grid {
        grid-template-columns: 1fr;
      }
    }

    /* ============================== MEET DPW ============================== */
    .dpw5__grid {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: clamp(2rem, 6vw, 5rem);
      align-items: center;
    }
    .dpw5__title {
      font-size: clamp(1.9rem, 4vw, 3rem);
      max-width: 18ch;
    }
    .dpw5__body {
      margin-top: 1.25rem;
      font-size: var(--text-lg);
      line-height: 1.55;
      color: var(--color-ink-2);
      max-width: 52ch;
    }
    .dpw5__body strong {
      color: var(--color-ink);
      font-weight: 700;
    }
    .dpw5__deep {
      margin-top: 1.75rem;
      color: var(--color-ink-2);
      max-width: 50ch;
    }
    .dpw5__media {
      aspect-ratio: 4 / 3;
    }
    .dpw5__cap {
      position: absolute;
      left: 0;
      bottom: 0;
      z-index: 2;
      padding: 0.65rem 0.75rem;
      color: var(--color-bone-on-night);
      background: linear-gradient(
        to top,
        rgba(20, 17, 14, 0.8),
        rgba(20, 17, 14, 0) 100%
      );
      width: 100%;
    }
    @media (max-width: 880px) {
      .dpw5__grid { grid-template-columns: 1fr; }
    }

    /* ============================== STRUCTURES ============================== */
    .structures5__head { max-width: 60rem; margin-bottom: 3rem; }
    .structures5__title {
      font-size: clamp(1.9rem, 4.2vw, 3.2rem);
      color: var(--color-bone-on-night);
      max-width: 22ch;
    }
    .structures5__lede {
      margin-top: 1.25rem;
      color: #cabda6;
      font-size: var(--text-lg);
      line-height: 1.55;
      max-width: 58ch;
    }
    .strs5__list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: clamp(3rem, 7vw, 6rem);
    }
    .strs5 {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: clamp(2rem, 5vw, 4rem);
      align-items: center;
    }
    .strs5.is-reverse {
      grid-template-columns: 1fr 1.1fr;
    }
    .strs5.is-reverse .strs5__media-wrap { order: 2; }
    .strs5.is-reverse .strs5__text { order: 1; }
    .strs5__media-wrap {
      margin: 0;
    }
    .strs5__media {
      aspect-ratio: 5 / 4;
    }
    .strs5__imgcap {
      margin-top: 0.6rem;
      color: #b7a98f;
    }
    .strs5__meta {
      display: flex;
      align-items: baseline;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 0.5rem;
    }
    .strs5__name {
      font-family: var(--font-display);
      font-weight: 800;
      font-size: clamp(1.8rem, 3.4vw, 2.8rem);
      letter-spacing: -0.025em;
      line-height: 1;
      color: var(--color-bone-on-night);
    }
    .strs5__body {
      margin-top: 1rem;
      color: #cabda6;
      font-size: var(--text-base);
      line-height: 1.55;
      max-width: 50ch;
    }
    @media (max-width: 820px) {
      .strs5, .strs5.is-reverse {
        grid-template-columns: 1fr;
      }
      .strs5.is-reverse .strs5__media-wrap { order: 0; }
