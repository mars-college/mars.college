---
// /mff — the Mars AI Film Festival. Four annual editions (2023–2026),
// screened outdoors during Mars Electronica. Embeds the full festival
// reels from the Mars College YouTube channel and collects photos of
// past screenings. Linked from the Film Festival section on /mit.
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Eyebrow from "../components/Eyebrow.astro";
import { APPLY_URL } from "../data/site";

// Header — the 2026 festival at the Bombay Beach Arts Center.
import heroImg from "../assets/photos/mff/screening-2026-wide.jpg";

// Photos of past festivals.
import pFish from "../assets/photos/learn/electronica/bbac-screening-2026.jpg";
import pAnimated from "../assets/photos/learn/electronica/animated.jpg";
// Earlier editions, at the Bombay Beach Drive-In.
import p2023Screening from "../assets/photos/mff/mff-2023-screening.webp";
import p2023Marquee from "../assets/photos/mff/mff-2023-bombay.webp";
import p2024Setup from "../assets/photos/mff/mff-2024-gandala.webp";
import p2023Audience from "../assets/photos/mff/mff-2023-audience.jpg";
import p2025Screening from "../assets/photos/mff/mff-2025-screening.jpg";
import p2026Projection from "../assets/photos/mff/mff-2026-projection.jpg";
import pFractal26 from "../assets/photos/mff/screening-2026-fractal.jpg";

// The four festivals on the Mars College YouTube channel:
// https://www.youtube.com/@MarsCollege-k7t/videos
const FESTIVALS = [
  { year: "2023", id: "SL--NeP0iHo" },
  { year: "2024", id: "ih7okZcBhEA" },
  { year: "2025", id: "olxXcD4Tjko" },
  { year: "2026", id: "jkm9IK16URU" },
];

// An editorial mosaic rather than a uniform grid. Three scales only — full
// width, half, third — and photos are only ever paired with others of the
// same scale, so every row is height-matched. Chronological, with the 2026
// projection as the full-width turn. Rows: 2 halves / 3 thirds / lead / 3 thirds.
const PHOTOS = [
  { img: p2023Screening,  size: "half",  alt: "Night screening at the Bombay Beach Drive-In, a lit cart and campfire beside the audience · 2023" },
  { img: p2023Audience,   size: "half",  alt: "Audience silhouetted against the drive-in screen, a projector running from a fairy-lit golf cart · 2023" },

  { img: p2023Marquee,    size: "minor", alt: "The illuminated Bombay Beach Drive-In marquee on festival night · 2023" },
  { img: p2024Setup,      size: "minor", alt: "Projector and sound desk set up in front of the drive-in screen at dusk · 2024" },
  { img: p2025Screening,  size: "minor", alt: "A standing crowd watching a generative AI film at the drive-in, radio tower blinking behind · 2025" },

  { img: p2026Projection, size: "lead",  alt: "A glowing guitar-shaped spaceship projected across a pyramid wall at Mars, the audience watching from camp chairs · 2026" },

  { img: pFish,           size: "minor", alt: "The 2026 festival under the recycled-metal fish sculpture at the Bombay Beach Arts Center" },
  { img: pFractal26,      size: "minor", alt: "A generative fractal film glowing over silhouetted viewers · 2026" },
  { img: pAnimated,       size: "minor", alt: "The audience watching an animated AI film at BBAC · 2026" },
];
---

<BaseLayout
  title="Mars AI Film Festival (MFF) — Mars College"
  description="Four annual editions of films made with AI at Mars College, screened outdoors in Bombay Beach during Mars Electronica. Watch every festival, 2023–2026."
  image="/og-mff.jpg?v=1"
  imageAlt="Night screening of the Mars AI Film Festival at the Bombay Beach Arts Center — audience under palm trees and a recycled-metal fish sculpture watching a generative film"
>
  <PageHeader
    index="02"
    label="MFF"
    title="The AI Film Festival."
    lede="Films made with AI at Mars, screened outdoors under the desert sky during Mars Electronica. Four editions and counting."
    image={heroImg}
    imageAlt="An outdoor night screening at the Bombay Beach Arts Center — audience in folding chairs, palm tree beside the glowing screen, recycled-metal fish sculpture overhead"
  />

  <!-- ===================== THE FOUR FESTIVALS ===================== -->
  <section class="u-section films">
    <div class="u-shell">
      <Eyebrow index="01" label="Four festivals · 2023 – 2026" />
      <h2 class="films__lead u-display">Watch every festival.</h2>
      <p class="films__intro u-measure">
        Every film is made by Martians during the semester — generative video,
        voice, music, and story — and premiered as one reel at the festival.
        The full programs are on the
        <a href="https://www.youtube.com/@MarsCollege-k7t/videos" target="_blank" rel="noopener">Mars College YouTube channel</a>.
      </p>

      <div class="films__grid">
        {FESTIVALS.map((f) => (
          <figure class="film">
            <div class="film__frame">
              <iframe
                src={`https://www.youtube-nocookie.com/embed/${f.id}`}
                title={`AI Film Festival ${f.year}`}
                loading="lazy"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
              ></iframe>
            </div>
            <figcaption class="film__cap">
              <span class="u-index">{f.year}</span>
              <span>AI Film Festival {f.year}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== SCENES FROM THE FESTIVAL ===================== -->
  <section class="u-section is-night scenes">
    <div class="u-shell">
      <Eyebrow index="02" label="Scenes from past festivals" />
      <h2 class="scenes__lead u-display">Screened under the desert sky.</h2>

      <ul class="scenes__grid">
        {PHOTOS.map((p, i) => (
          <li class={`scenes__item is-${p.size}`}>
            <div class="scenes__cell u-plate">
              <Image
                src={p.img}
                alt={p.alt}
                widths={[500, 900, 1400, 1900]}
                sizes={
                  p.size === "lead"
                    ? "(max-width: 640px) 92vw, 78vw"
                    : p.size === "minor"
                      ? "(max-width: 640px) 92vw, 26vw"
                      : "(max-width: 640px) 92vw, 40vw"
                }
                format="webp"
                quality={64}
                loading={i < 2 ? "eager" : "lazy"}
              />
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ===================== CTA ===================== -->
  <section class="u-section--tight">
    <div class="u-shell cta-band">
      <p class="cta-band__text u-display">
        Make a film with us at the next one.
      </p>
      <a href={APPLY_URL} class="u-cta">
        Apply for 2027 <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <style>
    /* ─── the four festivals ─── */
    .films__lead { font-size: var(--text-3xl); max-width: 18ch; }
    .films__intro { margin-top: 1rem; color: var(--color-ink-2); font-size: var(--text-lg); line-height: 1.55; margin-bottom: 2.5rem; }
    .films__intro a { color: inherit; text-decoration-line: underline; text-decoration-style: dashed; text-decoration-color: var(--color-clay); text-decoration-thickness: 1px; text-underline-offset: 4px; transition: color var(--dur-fast) var(--ease-out); }
    .films__intro a:hover { color: var(--color-clay); }
    .films__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.25rem, 3vw, 2.5rem); }
    .film { margin: 0; }
    .film__frame { position: relative; aspect-ratio: 16 / 9; background: var(--color-night); border: 1px solid var(--color-rule); }
    .film__frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
    .film__cap { margin-top: 0.75rem; display: flex; align-items: baseline; gap: 0.75rem; color: var(--color-ink-2); font-weight: 500; }
    @media (max-width: 820px) { .films__grid { grid-template-columns: 1fr; } }

    /* ─── scenes ─── */
    .scenes__lead { font-size: var(--text-3xl); color: var(--color-bone-on-night); max-width: 18ch; margin-bottom: 2.5rem; }

    /* Editorial mosaic on a 6-column field. Each photo spans 2, 3, 4 or all 6
       columns, and wider spans get a cinematic crop while narrow ones stay
       near 3:2 — so scale and shape both vary down the page. Spans are picked
       so every row fills exactly. */
    .scenes__grid {
      list-style: none; margin: 0; padding: 0;
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: clamp(0.6rem, 1.4vw, 1.1rem) clamp(0.6rem, 1.4vw, 1.1rem);
    }
    .scenes__item { min-width: 0; }
    .scenes__item.is-lead  { grid-column: span 6; }
    .scenes__item.is-half  { grid-column: span 3; }
    .scenes__item.is-minor { grid-column: span 2; }
    .scenes__cell {
      position: relative;
      background: var(--color-night);
      border: 1px solid var(--color-rule-night);
      overflow: hidden;
      aspect-ratio: 3 / 2;
    }
    .is-lead .scenes__cell { aspect-ratio: 2 / 1; }
    .is-half .scenes__cell { aspect-ratio: 16 / 9; }

    .scenes__cell :global(img) {
      position: absolute; inset: 0; width: 100%; height: 100%;
      object-fit: cover;
      transition: transform 700ms var(--ease-out);
    }
    .scenes__item:hover .scenes__cell :global(img) { transform: scale(1.02); }

    /* 4-column field: the two widest roles go full width, the rest halve. */
    @media (max-width: 1000px) {
      .scenes__grid { grid-template-columns: repeat(4, 1fr); }
      .scenes__item.is-lead,
        .scenes__item.is-half,
      .scenes__item.is-minor { grid-column: span 2; }
    }
    /* single column on phones — stacked, each photo full width */
    @media (max-width: 640px) {
      .scenes__grid { grid-template-columns: 1fr; }
      .scenes__item.is-lead,
      .scenes__item.is-half,
      .scenes__item.is-minor { grid-column: span 1; }
      .is-lead .scenes__cell { aspect-ratio: 16 / 9; }
    }
    @media (prefers-reduced-motion: reduce) {
      .scenes__cell :global(img) { transition: none; }
      .scenes__item:hover .scenes__cell :global(img) { transform: none; }
    }

    /* ─── cta ─── */
    .cta-band { display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap; border-top: var(--rule-strong); padding-top: 2.5rem; }
    .cta-band__text { font-size: clamp(1.6rem, 3.4vw, 2.6rem); max-width: 24ch; }
  </style>

</BaseLayout>
