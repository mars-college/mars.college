---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Eyebrow from "../components/Eyebrow.astro";
import {
  AI_TOPICS,
  LEARN_EXTRAS,
  LEARN_NOTE,
  SCHOLARSHIPS,
  APPLY_URL,
} from "../data/site";

import headerImg from "../assets/photos/learn-workshop.jpg";
import asideImg from "../assets/photos/activities/maker.jpg";
---

<BaseLayout noindex={true}
  title="Learn — The AI Program · Mars College 2027"
  description="The 2027 Mars AI program: personal AI, automation, computer use, art, income, remote work, and vanlife skills."
>
  <PageHeader
    index="02"
    label="Learn — The AI Program"
    title="Outsmart AGI."
    lede="Local AI. Own power. Own tools. Personal agents, automation, art, income. Make the machine work for a human-first life."
    image={headerImg}
    imageAlt="A talk projected on the wall at Mars College after dark"
  />

  <!-- The pitch -->
  <section class="u-section">
    <div class="u-shell pitch">
      <Eyebrow index="01" label="The pitch" />
      <p class="pitch__lead u-display">
        Five things every Martian learns to do with AI.
      </p>
      <p class="pitch__body u-measure">
        Curriculum locks in around October because agents move fast. The spine
        is clear now.
      </p>
    </div>
  </section>

  <!-- Five topics -->
  <section class="u-section--tight">
    <div class="u-shell">
      <ol class="topics">
        {
          AI_TOPICS.map((t) => (
            <li class="topic">
              <span class="topic__n u-index">{t.n}</span>
              <div class="topic__text">
                <h2 class="topic__title">{t.title}</h2>
                <p class="topic__body">{t.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Curriculum note -->
  <section class="u-section--tight">
    <div class="u-shell">
      <p class="note">
        <span class="u-label u-label--clay">Note</span>
        {LEARN_NOTE}
      </p>
    </div>
  </section>

  <!-- Remote work + vanlife -->
  <section class="u-section is-night">
    <div class="u-shell extras__grid">
      <div class="extras__text">
        <Eyebrow index="02" label="Beyond the screen" />
        <h2 class="extras__title u-display">
          Remote work. Vanlife skills.
        </h2>
        <p class="extras__lede">
          Power, water, shelter, and income make the desert livable.
        </p>
        <ul class="extras__list">
          {
            LEARN_EXTRAS.map((e) => (
              <li class="extra">
                <h3 class="extra__title">{e.title}</h3>
                <p class="extra__body">{e.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
      <figure class="extras__media u-plate">
        <Image
          src={asideImg}
          alt="The maker space at Mars College"
          widths={[600, 900, 1200]}
          sizes="(max-width: 900px) 100vw, 42vw"
          format="webp"
          quality={70}
          loading="lazy"
        />
      </figure>
    </div>
  </section>

  <!-- Scholarships -->
  <section class="u-section">
    <div class="u-shell">
      <Eyebrow index="03" label="Scholarships, not tracks" />
      <h2 class="schol__lead u-display">
        Apply your work to one of four scholarships.
      </h2>
      <p class="schol__intro u-measure">
        Dedicated agents interview, coach, and release capital over the season.
      </p>
      <ul class="schol__grid">
        {
          SCHOLARSHIPS.map((s, i) => (
            <li class="schol">
              <span class="schol__n u-index">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="schol__title">{s.title}</h3>
              <p class="schol__body">{s.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- CTA -->
  <section class="u-section--tight">
    <div class="u-shell cta-band">
      <p class="cta-band__text u-display">
        Bring the work you want to make with AI.
      </p>
      <a href={APPLY_URL} class="u-cta">
        Apply for 2027 <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <style>
    .pitch__lead {
      font-size: var(--text-3xl);
      line-height: 1.02;
      max-width: 20ch;
    }
    .pitch__lead em {
      font-style: normal;
      font-weight: 800;
      color: var(--color-clay);
    }
    .pitch__body {
      margin-top: 1.5rem;
      color: var(--color-ink-2);
    }

    .topics {
      list-style: none;
      margin: 0;
      padding: 0;
      border-top: var(--rule-strong);
    }
    .topic {
      display: grid;
      grid-template-columns: 4rem 1fr;
      gap: clamp(1rem, 3vw, 3rem);
      padding: clamp(1.5rem, 3vw, 2.25rem) 0;
      border-bottom: var(--rule);
      align-items: start;
    }
    .topic__n {
      font-size: var(--text-sm);
      padding-top: 0.5rem;
    }
    .topic__title {
      font-family: var(--font-display);
      font-size: clamp(1.75rem, 3.2vw, 2.6rem);
      font-weight: 800;
      letter-spacing: -0.025em;
      line-height: 1.02;
    }
    .topic__body {
      margin-top: 0.7rem;
      color: var(--color-ink-2);
      max-width: 56ch;
    }
    @media (max-width: 560px) {
      .topic {
        grid-template-columns: 1fr;
        gap: 0.4rem;
      }
      .topic__n {
        padding-top: 0;
      }
    }

    .note {
      border-left: 2px solid var(--color-clay);
      padding: 0.25rem 0 0.25rem 1.25rem;
      max-width: 60ch;
      color: var(--color-ink);
      font-size: var(--text-lg);
      line-height: 1.5;
    }
    .note .u-label {
      display: block;
      margin-bottom: 0.5rem;
    }

    /* extras */
    .extras__grid {
      display: grid;
      grid-template-columns: 1fr 0.8fr;
      gap: clamp(2rem, 6vw, 5rem);
      align-items: center;
    }
    .extras__title {
      font-size: clamp(1.9rem, 4vw, 3rem);
      color: var(--color-bone-on-night);
      max-width: 18ch;
    }
    .extras__lede {
      margin-top: 1.25rem;
      color: #cabda6;
      max-width: 46ch;
    }
    .extras__list {
      list-style: none;
      margin: 2rem 0 0;
      padding: 0;
      display: grid;
      gap: 0;
    }
    .extra {
      padding: 1.5rem 0;
      border-top: 1px solid var(--color-rule-night);
    }
    .extra__title {
      font-family: var(--font-body);
      font-size: var(--text-meta);
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--color-clay);
    }
    .extra__body {
      margin-top: 0.6rem;
      color: var(--color-bone-on-night);
      max-width: 48ch;
    }
    .extras__media {
      aspect-ratio: 4 / 5;
    }
    @media (max-width: 820px) {
      .extras__grid {
        grid-template-columns: 1fr;
      }
      .extras__media {
        aspect-ratio: 16 / 10;
        order: -1;
      }
    }

    /* scholarships */
    .schol__lead {
      font-size: clamp(1.9rem, 4vw, 3rem);
      max-width: 18ch;
    }
    .schol__intro {
      margin-top: 1.25rem;
      color: var(--color-ink-2);
      margin-bottom: 2.5rem;
    }
    .schol__grid {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
      border-top: var(--rule);
      border-left: var(--rule);
    }
    .schol {
      padding: clamp(1.5rem, 3vw, 2.25rem);
      border-right: var(--rule);
      border-bottom: var(--rule);
    }
    .schol__n {
      display: block;
      margin-bottom: 0.75rem;
    }
    .schol__title {
      font-family: var(--font-display);
      font-size: clamp(1.4rem, 2.6vw, 1.9rem);
      font-weight: 800;
    }
    .schol__body {
      margin-top: 0.6rem;
      color: var(--color-ink-2);
      max-width: 44ch;
    }
    @media (max-width: 640px) {
      .schol__grid {
        grid-template-columns: 1fr;
      }
    }

    .cta-band {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
      flex-wrap: wrap;
      border-top: var(--rule-strong);
      padding-top: 2.5rem;
    }
    .cta-band__text {
      font-size: clamp(1.6rem, 3.4vw, 2.6rem);
      max-width: 20ch;
    }
  </style>
</BaseLayout>
