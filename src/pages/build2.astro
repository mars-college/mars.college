---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Eyebrow from "../components/Eyebrow.astro";
import {
  BUILD_PHASES,
  BUILD_SCHEDULE,
  DPW_CREW_PERKS,
  BUILD_FAQ,
  TALLY_BUILD_FORM_ID,
  BUILD_SUBSTACK_URL,
  APPLY_URL,
} from "../data/site";

// Hero — the money shot
import hero from "../assets/photos/build-curated/047_2026_img_1144_2f1d9.jpg";

// Phase photos
import phaseBuild from "../assets/photos/build-curated/005_2025_2026_pxl_20251112_235328377_bb796.jpg";
import phaseMaintain from "../assets/photos/build-curated/041_2026_20260130_170446_06ab8.jpg";
import phaseStrike from "../assets/photos/build-curated/027_2026_dscf2755_ff363.jpg";

// Mosaic
import m1 from "../assets/photos/build-curated/035_2025_2026_rn_image_picker_lib_temp_b98e501f_86f0_478_dc559.jpg";
import m2 from "../assets/photos/build-curated/043_2025_2026_84e299b5_828c_4af6_98e0_7c33283dd54a_a1ef4.jpg";
import m3 from "../assets/photos/build-curated/046_2025_img_8471_9edae.jpg";
import m4 from "../assets/photos/build-curated/006_2025_2026_img_4779_a826a.jpg";
import m5 from "../assets/photos/build-curated/003_2025_2026_pxl_20251111_203710932_2c374.jpg";
import m6 from "../assets/photos/build-curated/021_2025_2026_img_20251116_161732_63192.jpg";
import m7 from "../assets/photos/build-curated/004_2025_2026_pxl_20251112_235256510_f02f7.jpg";
import m8 from "../assets/photos/build-curated/009_2026_img_3344_fdd4a.jpg";

const phasePhotos = [phaseBuild, phaseMaintain, phaseStrike];

const mosaic = [
  { img: m1, cap: "Frame against sky", span: "" },
  { img: m2, cap: "Forklift lift", span: "" },
  { img: m4, cap: "Looking up", span: "" },
  { img: m6, cap: "Working into the night", span: "feature" },
  { img: m3, cap: "Laying floor", span: "" },
  { img: m7, cap: "Golden hour assembly", span: "" },
  { img: m5, cap: "Inside the structure", span: "" },
  { img: m8, cap: "Sunset over the playa", span: "feature" },
];
---

<BaseLayout noindex={true}
  title="Build crew — Mars College 2027"
  description="Mars College DPW is recruiting now. Housing, fee waived, meal plan. Build Nov–Dec, maintain Jan–Mar, strike Mar–Apr. Applications close Oct 1."
>
  <!-- ============= HERO ============= -->
  <section class="hero2">
    <div class="hero2__bg" aria-hidden="true">
      <Image
        src={hero}
        alt="Six Mars College builders lifting a horizontal orange pallet-rack beam together at sunset"
        widths={[768, 1280, 1920]}
        sizes="100vw"
        format="webp"
        quality={74}
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero2__scrim"></div>
    </div>
    <div class="u-shell hero2__content">
      <p class="u-eyebrow hero2__eyebrow">
        <span class="u-index">SEASON 8</span>
        <span class="u-label">Department of Public Works</span>
      </p>
      <h1 class="hero2__title u-display u-rise">
        Come help build<br />
        <span class="hero2__title-em">the next Mars.</span>
      </h1>
      <p class="hero2__lede u-rise" style="animation-delay:120ms">
        DPW crew is open. <strong>Housing, meal plan, fee waived.</strong> Build
        the off-grid village in November and December. Maintain it through the
        season. Take it apart in April.
      </p>
      <div class="hero2__actions u-rise" style="animation-delay:200ms">
        <a href="#inquire" class="u-cta">Apply for DPW <span aria-hidden="true">→</span></a>
        <a href="#what" class="u-link hero2__what">What you'd do <span class="u-arrow" aria-hidden="true">↓</span></a>
      </div>
      <p class="hero2__deadline u-label">Applications close · October 1, 2026</p>
    </div>
  </section>

  <!-- ============= THE ASK ============= -->
  <section id="what" class="u-section ask">
    <div class="u-shell ask__shell">
      <Eyebrow index="01" label="The ask" />
      <h2 class="ask__title u-display">
        We need hands. Three phases. Pick yours.
      </h2>
      <p class="ask__body">
        Mars DPW (Department of Public Works) runs the physical village: power,
        water, shelter, gear, the civic infrastructure every camp plugs into.
        Almost everyone in DPW starts on general construction — pallet rack
        assembly, plywood walls, simple wiring, basic plumbing. Specialists move
        to their craft as the structures come up.
      </p>
    </div>

    <div class="u-shell ask__phases">
      {
        BUILD_PHASES.map((p, i) => (
          <article class="phase">
            <div class="u-plate phase__media">
              <Image
                src={phasePhotos[i]}
                alt={`${p.title} phase at Mars College`}
                widths={[400, 700, 1000]}
                sizes="(max-width: 900px) 100vw, 33vw"
                format="webp"
                quality={68}
                loading="lazy"
              />
            </div>
            <div class="phase__text">
              <p class="phase__meta">
                <span class="u-index">{p.n} / 03</span>
                <span class="u-label phase__hours">{p.hours}</span>
              </p>
              <h3 class="phase__title">{p.title}</h3>
              <p class="phase__when u-label u-label--clay">{p.when}</p>
              <p class="phase__body">{p.body}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- ============= WHAT YOU GET ============= -->
  <section class="u-section is-night perks2">
    <div class="u-shell perks2__grid">
      <div class="perks2__intro">
        <Eyebrow index="02" label="What DPW crew gets" />
        <h2 class="perks2__title u-display">
          You don't pay for the season. The season pays for you.
        </h2>
      </div>
      <ul class="perks2__list">
        <li class="perks2__item">
          <span class="u-index">A</span>
          <div>
            <h3 class="perks2__h">Housing</h3>
            <p>A bed in a pod or shared structure for the duration. You don't need a van.</p>
          </div>
        </li>
        <li class="perks2__item">
          <span class="u-index">B</span>
          <div>
            <h3 class="perks2__h">General fee waived</h3>
            <p>The ~$500 Treasury fee that funds toilets, internet, and central drinking water — you don't pay it.</p>
          </div>
        </li>
        <li class="perks2__item">
          <span class="u-index">C</span>
          <div>
            <h3 class="perks2__h">DPW meal plan</h3>
            <p>Cooked together. Eaten together. You're never figuring out dinner alone in the dark.</p>
          </div>
        </li>
        <li class="perks2__item">
          <span class="u-index">D</span>
          <div>
            <h3 class="perks2__h">Honest work</h3>
            <p>Real construction with experienced people. A finished town that's half yours.</p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <!-- ============= MOSAIC ============= -->
  <section class="u-section gallery">
    <div class="u-shell gallery__head">
      <Eyebrow index="03" label="What it looks like" />
      <h2 class="gallery__title u-display">Eight months. One village.</h2>
      <p class="gallery__lede">
        Photographs from Build 2025 and 2026 at the Mars campus, one mile east
        of Bombay Beach, California.
      </p>
    </div>
    <div class="u-shell">
      <ul class="mosaic2">
        {
          mosaic.map((m) => (
            <li
              class:list={[
                "mosaic2__cell u-plate",
                { "is-feature": m.span === "feature" },
              ]}
            >
              <Image
                src={m.img}
                alt={m.cap}
                widths={[400, 700, 1100]}
                sizes="(max-width: 700px) 100vw, 30vw"
                format="webp"
                quality={66}
                loading="lazy"
              />
              <figcaption class="mosaic2__cap u-label">{m.cap}</figcaption>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============= UNUSUAL FACT ============= -->
  <section class="u-section unusual">
    <div class="u-shell unusual__shell">
      <p class="unusual__text u-display">
        Mars College is the unusual fact that an off-grid college built from
        the ground up exists at all. The build is how it stays true.
      </p>
      <p class="unusual__sub">
        Bare playa in October. Finished village by the first Monday in January.
        Back to bare playa by May 1. We do this every year. Now in our eighth
        season.
      </p>
    </div>
  </section>

  <!-- ============= TIMELINE ============= -->
  <section class="u-section--tight is-night timeline2">
    <div class="u-shell">
      <Eyebrow index="04" label="Build timeline" />
      <ol class="timeline2__list">
        {
          BUILD_SCHEDULE.map((s) => (
            <li class="timeline2__item">
              <span class="timeline2__date">{s.date}</span>
              <span class="timeline2__label">{s.label}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============= FAQ ============= -->
  <section class="u-section faq2">
    <div class="u-shell">
      <Eyebrow index="05" label="Common questions" />
      <ul class="faq2__list">
        {
          BUILD_FAQ.map((item) => (
            <li class="faq2__item">
              <details>
                <summary>
                  <span class="faq2__q">{item.q}</span>
                  <span class="faq2__chevron" aria-hidden="true">+</span>
                </summary>
                <p class="faq2__a">{item.a}</p>
              </details>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============= INQUIRY ============= -->
  <section id="inquire" class="u-section is-night inquire2">
    <div class="u-shell">
      <Eyebrow index="06" label="Inquire" />
      <h2 class="inquire2__title u-display">Apply to build the village.</h2>
      <p class="inquire2__lede">
        A short form. We'll follow up about phases, skills, and what brings you
        to it. For full operational detail (materials, deadlines, architecture,
        economics), read the
        <a href={BUILD_SUBSTACK_URL} class="u-link inquire2__link">DPW deep dive
          <span class="u-arrow" aria-hidden="true">→</span></a>
      </p>

      <div class="inquire2__form">
        {
          TALLY_BUILD_FORM_ID ? (
            <iframe
              data-tally-src={`https://tally.so/embed/${TALLY_BUILD_FORM_ID}?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1`}
              loading="lazy"
              width="100%"
              height="640"
              frameborder="0"
              marginheight="0"
              marginwidth="0"
              title="Mars DPW build inquiry"
            />
          ) : (
            <div class="inquire2__placeholder">
              <p class="u-label u-label--clay">Form coming soon</p>
              <p>
                Until the form is up, email <a href="mailto:info@mars.college" class="inquire2__email">info@mars.college</a>
                with subject "DPW 2027". Tell us which phase(s) you'd join, what
                you bring, and whether you've been to Mars before.
              </p>
              <a href={APPLY_URL} class="u-cta inquire2__fallback">
                Or apply to Mars College <span aria-hidden="true">→</span>
              </a>
            </div>
          )
        }
      </div>
    </div>
    <script async src="https://tally.so/widgets/embed.js"></script>
  </section>

  <style>
    /* ---- hero ---- */
    .hero2 {
      position: relative;
      background: var(--color-night);
      color: var(--color-bone-on-night);
      overflow: hidden;
      isolation: isolate;
      min-height: clamp(38rem, 88vh, 56rem);
      display: flex;
      flex-direction: column;
    }
    .hero2__bg {
      position: absolute;
      inset: 0;
      z-index: 0;
    }
    .hero2__bg img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 55%;
    }
    .hero2__scrim {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(
          to top,
          rgba(18, 15, 12, 0.96) 0%,
          rgba(18, 15, 12, 0.72) 40%,
          rgba(18, 15, 12, 0.2) 80%,
          rgba(18, 15, 12, 0.45) 100%
        ),
        linear-gradient(
          to right,
          rgba(18, 15, 12, 0.55) 0%,
          rgba(18, 15, 12, 0.05) 50%,
          rgba(18, 15, 12, 0) 100%
        );
    }
    .hero2__content {
      position: relative;
      z-index: 2;
      margin-top: auto;
      padding-block: clamp(2rem, 5vh, 3.5rem);
      max-width: 60rem;
    }
    .hero2__eyebrow {
      color: var(--color-bone-on-night);
    }
    .hero2__eyebrow::after { background: var(--color-rule-night); }
    .hero2__eyebrow .u-label { color: #c8b89b; }
    .hero2__title {
      font-family: var(--font-display);
      font-weight: 800;
      font-size: clamp(3rem, 8vw, 6.75rem);
      line-height: 0.95;
      letter-spacing: -0.035em;
      text-wrap: balance;
      text-shadow: 0 2px 28px rgba(18, 15, 12, 0.78);
    }
    .hero2__title-em { color: var(--color-clay); }
    .hero2__lede {
      margin-top: 1.5rem;
      max-width: 50ch;
      font-size: clamp(1.15rem, 1.6vw, 1.4rem);
      line-height: 1.5;
      color: #efe6d4;
    }
    .hero2__lede strong { color: var(--color-bone-on-night); font-weight: 700; }
    .hero2__actions {
      margin-top: 2rem;
      display: flex;
      align-items: center;
      gap: 1.75rem;
      flex-wrap: wrap;
    }
    .hero2__what {
      color: var(--color-bone-on-night);
      border-color: var(--color-bone-on-night);
    }
    .hero2__deadline {
      margin-top: 2rem;
      color: var(--color-clay);
    }

    /* ---- ask ---- */
    .ask__shell { max-width: 60rem; }
    .ask__title {
      font-size: clamp(2rem, 4.4vw, 3.4rem);
      line-height: 1.04;
      max-width: 20ch;
    }
    .ask__body {
      margin-top: 1.5rem;
      font-size: var(--text-lg);
      line-height: 1.55;
      color: var(--color-ink-2);
      max-width: 60ch;
    }
    .ask__phases {
      margin-top: 3.5rem;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: clamp(1.5rem, 3vw, 2.5rem);
    }
    .phase__media {
      aspect-ratio: 4 / 5;
      margin-bottom: 1.25rem;
    }
    .phase__meta {
      display: flex;
      align-items: baseline;
      gap: 1rem;
      margin-bottom: 0.5rem;
    }
    .phase__hours {
      color: var(--color-ink-2);
    }
    .phase__title {
      font-family: var(--font-display);
      font-weight: 800;
      font-size: clamp(1.8rem, 3vw, 2.4rem);
      letter-spacing: -0.025em;
      line-height: 1;
    }
    .phase__when {
      margin-top: 0.5rem;
      font-weight: 700;
    }
    .phase__body {
      margin-top: 0.9rem;
      color: var(--color-ink-2);
      max-width: 44ch;
    }
    @media (max-width: 820px) {
      .ask__phases { grid-template-columns: 1fr; }
      .phase {
        display: grid;
        grid-template-columns: 38% 1fr;
        gap: 1.25rem;
        align-items: start;
      }
      .phase__media { margin-bottom: 0; aspect-ratio: 3 / 4; }
    }
    @media (max-width: 480px) {
      .phase { grid-template-columns: 1fr; }
      .phase__media { aspect-ratio: 16 / 10; }
    }

    /* ---- perks ---- */
    .perks2__grid {
      display: grid;
      grid-template-columns: 1fr 1.4fr;
      gap: clamp(2rem, 6vw, 5rem);
      align-items: start;
    }
    .perks2__title {
      font-size: clamp(1.8rem, 3.8vw, 2.8rem);
      color: var(--color-bone-on-night);
      max-width: 16ch;
    }
    .perks2__list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
    .perks2__item {
      display: grid;
      grid-template-columns: 2.25rem 1fr;
      gap: 0.6rem;
      padding: 1.25rem;
      border: 1px solid var(--color-rule-night);
      align-items: start;
    }
    .perks2__h {
      font-family: var(--font-display);
      font-weight: 800;
      font-size: clamp(1.15rem, 1.8vw, 1.4rem);
      letter-spacing: -0.02em;
      color: var(--color-bone-on-night);
    }
    .perks2__item p {
      margin-top: 0.5rem;
      color: #cabda6;
      font-size: var(--text-base);
      line-height: 1.45;
    }
    @media (max-width: 880px) {
      .perks2__grid { grid-template-columns: 1fr; }
      .perks2__list { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 520px) {
      .perks2__list { grid-template-columns: 1fr; }
    }

    /* ---- mosaic ---- */
    .gallery__head { max-width: 60rem; margin-bottom: 2.5rem; }
    .gallery__title {
      font-size: clamp(1.9rem, 4vw, 3rem);
    }
    .gallery__lede {
      margin-top: 1rem;
      color: var(--color-ink-2);
      max-width: 56ch;
    }
    .mosaic2 {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      grid-auto-rows: 11rem;
      grid-auto-flow: dense;
      gap: clamp(0.5rem, 1.2vw, 1rem);
    }
    .mosaic2__cell {
      grid-column: span 2;
      grid-row: span 1;
    }
    .mosaic2__cell.is-feature {
      grid-column: span 3;
      grid-row: span 2;
    }
    .mosaic2__cell :global(img) {
      transition: transform 700ms var(--ease-out);
    }
    .mosaic2__cell:hover :global(img) {
      transform: scale(1.04);
    }
    .mosaic2__cap {
      position: absolute;
      left: 0;
      bottom: 0;
      z-index: 2;
      padding: 0.65rem 0.75rem;
      color: var(--color-bone-on-night);
      background: linear-gradient(
        to top,
        rgba(20, 17, 14, 0.78),
        rgba(20, 17, 14, 0) 100%
      );
      width: 100%;
    }
    @media (max-width: 820px) {
      .mosaic2 {
        grid-template-columns: repeat(4, 1fr);
        grid-auto-rows: 9rem;
      }
      .mosaic2__cell { grid-column: span 2; }
      .mosaic2__cell.is-feature { grid-column: span 4; grid-row: span 2; }
    }
    @media (max-width: 520px) {
      .mosaic2 { grid-template-columns: repeat(2, 1fr); }
      .mosaic2__cell, .mosaic2__cell.is-feature {
        grid-column: span 2;
        grid-row: span 1;
      }
    }

    /* ---- unusual fact ---- */
    .unusual__shell { max-width: 56rem; }
    .unusual__text {
      font-size: clamp(1.8rem, 4vw, 3rem);
      line-height: 1.05;
      max-width: 28ch;
    }
    .unusual__sub {
      margin-top: 1.5rem;
      font-size: var(--text-lg);
      line-height: 1.55;
      color: var(--color-ink-2);
      max-width: 56ch;
    }

    /* ---- timeline ---- */
    .timeline2__list {
      list-style: none;
      margin: 1rem 0 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
      border-top: 1px solid var(--color-rule-night);
    }
    .timeline2__item {
      padding: 1.25rem 1rem 1.25rem 0;
      border-right: 1px solid var(--color-rule-night);
      border-bottom: 1px solid var(--color-rule-night);
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }
    .timeline2__item:nth-child(4n) { border-right: 0; }
    .timeline2__date {
      font-family: var(--font-mono);
      font-size: var(--text-sm);
      font-weight: 500;
      color: var(--color-clay);
    }
    .timeline2__label {
      font-family: var(--font-body);
      font-size: var(--text-base);
      font-weight: 500;
      color: var(--color-bone-on-night);
    }
    @media (max-width: 820px) {
      .timeline2__list { grid-template-columns: 1fr 1fr; }
      .timeline2__item:nth-child(4n) { border-right: 1px solid var(--color-rule-night); }
      .timeline2__item:nth-child(2n) { border-right: 0; }
    }
    @media (max-width: 480px) {
      .timeline2__list { grid-template-columns: 1fr; }
      .timeline2__item { border-right: 0; }
    }

    /* ---- faq ---- */
    .faq2__list {
      list-style: none;
      margin: 1rem 0 0;
      padding: 0;
      border-top: var(--rule);
    }
    .faq2__item details { border-bottom: var(--rule); }
    .faq2__item summary {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
      padding: 1.25rem 0;
      cursor: pointer;
      list-style: none;
    }
    .faq2__item summary::-webkit-details-marker { display: none; }
    .faq2__q {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: clamp(1.15rem, 2vw, 1.45rem);
      letter-spacing: -0.015em;
      line-height: 1.25;
      color: var(--color-ink);
    }
    .faq2__chevron {
      flex: none;
      font-family: var(--font-mono);
      font-size: 1.25rem;
      color: var(--color-clay);
      transition: transform var(--dur-fast) var(--ease-out);
    }
    .faq2__item details[open] .faq2__chevron { transform: rotate(45deg); }
    .faq2__a {
      padding: 0 0 1.5rem 0;
      color: var(--color-ink-2);
      max-width: 64ch;
      line-height: 1.55;
    }

    /* ---- inquire ---- */
    .inquire2__title {
      font-size: clamp(2rem, 4vw, 3rem);
      color: var(--color-bone-on-night);
      max-width: 18ch;
    }
    .inquire2__lede {
      margin-top: 1.5rem;
      color: #cabda6;
      max-width: 56ch;
      font-size: var(--text-lg);
      line-height: 1.5;
    }
    .inquire2__link {
      color: var(--color-bone-on-night);
      border-color: var(--color-bone-on-night);
    }
    .inquire2__form {
      margin-top: 2.5rem;
      max-width: 44rem;
    }
    .inquire2__form iframe {
      background: var(--color-bone-on-night);
    }
    .inquire2__placeholder {
