---
// /agentlab4 — Agent Lab candidate #4: "Image-rich editorial almanac."
// The most visually designed candidate: alternating full-width media+text
// rows, an elegant vertical schedule timeline, refined pricing cards, a
// featured clay grants band, the Off-Grid AI lineage strip on night, and a
// closing winter media row. Reads ALL copy from src/data/agentlab.ts.
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Eyebrow from "../components/Eyebrow.astro";
import { EMAIL, TALLY_OFFGRID_FORM_ID } from "../data/site";
import {
  AGENTLAB,
  AGENTLAB_TOPICS,
  AGENTLAB_SCHEDULE,
  AGENTLAB_TIERS,
  AGENTLAB_GRANTS,
  AGENTLAB_FACTS,
  AGENTLAB_WINTER,
  AGENTLAB_LINEAGE,
  AGENTLAB_LINKS,
  HERO_IMG,
  IMG_ART,
  IMG_RESEARCH,
  IMG_DESERT,
} from "../data/agentlab";

// Pair each topic with its image + an alt string. Rows alternate sides via :nth.
const TOPIC_MEDIA = [
  {
    img: IMG_RESEARCH,
    alt: "A Mars College research-and-learn session — laptops open, people working through AI together",
  },
  {
    img: IMG_ART,
    alt: "AI-generated artwork from the Mars College cohort projected and exhibited",
  },
  {
    img: IMG_DESERT,
    alt: "The off-grid Mars College village glowing in the desert night",
  },
];
const TOPICS = AGENTLAB_TOPICS.map((t, i) => ({ ...t, ...TOPIC_MEDIA[i] }));
---

<BaseLayout noindex={true}
  title="Agent Lab — Off-Grid AI · Fall 2026"
  description={AGENTLAB.blurb}
>
  <!-- ============ HERO ============ -->
  <PageHeader
    index=""
    label={`${AGENTLAB.name} · ${AGENTLAB.season}`}
    title="Off-Grid AI."
    lede={AGENTLAB.lede}
    image={HERO_IMG}
    imageAlt="A class at Mars College — laptops open, an instructor at the front, AI work projected on the wall"
  />

  <!-- ============ INTRO STRIP ============ -->
  <section class="u-section u-section--tight intro">
    <div class="u-shell intro__grid">
      <Eyebrow index="01" label={`${AGENTLAB.tagline} · ${AGENTLAB.cadence}`} />
      <div class="intro__body">
        <h2 class="intro__lead u-display">An agent that works for you.</h2>
        <p class="intro__copy u-measure">{AGENTLAB.blurb}</p>
        <a href={AGENTLAB_LINKS.enroll} class="u-cta intro__cta">
          Join the cohort <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ THREE TOPICS — ALTERNATING MEDIA ROWS ============ -->
  <section class="u-section topics">
    <div class="u-shell">
      <Eyebrow index="02" label="What you'll build · three arcs" />
      <ol class="rows">
        {TOPICS.map((t) => (
          <li class="row">
            <figure class="row__media u-plate">
              <Image
                src={t.img}
                alt={t.alt}
                widths={[600, 1000, 1400]}
                sizes="(max-width: 880px) 100vw, 50vw"
                format="webp"
                quality={72}
                loading="lazy"
              />
            </figure>
            <div class="row__text">
              <span class="row__n u-index">{t.n}</span>
              <h3 class="row__title u-display">{t.title}</h3>
              <p class="row__body">{t.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ SCHEDULE — VERTICAL TIMELINE ============ -->
  <section class="u-section is-night sked">
    <div class="u-shell sked__grid">
      <div class="sked__head">
        <Eyebrow index="03" label="The cohort · 12 Tuesdays" />
        <h2 class="sked__lead u-display">Every Tuesday this fall.</h2>
        <dl class="facts">
          {AGENTLAB_FACTS.map((f) => (
            <div class="facts__row">
              <dt class="facts__k u-label">{f.k}</dt>
              <dd class="facts__v">{f.v}</dd>
            </div>
          ))}
        </dl>
        <a href={AGENTLAB_LINKS.enroll} class="u-cta sked__cta">
          Save your seat <span aria-hidden="true">→</span>
        </a>
      </div>

      <ol class="timeline">
        {AGENTLAB_SCHEDULE.map((s) => {
          const isDemo = s.arc === "Demo Day";
          return (
            <li class={`tl${isDemo ? " tl--demo" : ""}`}>
              <span class="tl__dot" aria-hidden="true"></span>
              <span class="tl__date">{s.date}</span>
              <div class="tl__body">
                <span class="tl__arc u-label">{s.arc}</span>
                <span class="tl__title">{s.title}</span>
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <!-- ============ PRICING ============ -->
  <section class="u-section join">
    <div class="u-shell">
      <Eyebrow index="04" label="Join · four cumulative tiers" />
      <h2 class="join__lead u-display">Four ways in — each builds on the last.</h2>
      <ul class="tiers">
        {AGENTLAB_TIERS.map((tier) => {
          const isFree = "free" in tier && tier.free;
          return (
            <li class={`tier${tier.featured ? " tier--featured" : ""}${isFree ? " tier--free" : ""}`}>
              {tier.featured && <span class="tier__flag u-label">Recommended</span>}
              <p class="tier__name u-label u-label--clay">{tier.name}</p>
              <p class="tier__price">
                <span class="tier__amount">{tier.price}</span>
                <span class="tier__unit">{tier.unit}</span>
              </p>
              <p class="tier__tagline">
                {tier.tagline}
                {"abbr" in tier && tier.abbr ? <span class="tier__abbr">{tier.abbr}</span> : null}
              </p>
              <ul class="tier__features">
                {tier.features.map((f) => <li>{f}</li>)}
              </ul>
              <a
                href={AGENTLAB_LINKS.enroll}
                class={`u-cta tier__cta${tier.featured || isFree ? "" : " u-cta--ghost"}`}
              >
                {isFree ? "Join free" : `Enroll · ${tier.name}`} <span aria-hidden="true">→</span>
              </a>
              {"link" in tier && tier.link && (
                <a href={tier.link.href} class="tier__learn" target="_blank" rel="noopener">
                  {tier.link.label} <span aria-hidden="true">→</span>
                </a>
              )}
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <!-- ============ GRANTS — FEATURED CLAY BAND ============ -->
  <section class="u-section--tight grants-band" id="grant">
    <div class="u-shell grants">
      <div class="grants__text">
        <p class="grants__badge u-label">{AGENTLAB_GRANTS.badge}</p>
        <h2 class="grants__headline u-display">{AGENTLAB_GRANTS.headline}</h2>
        <p class="grants__body">{AGENTLAB_GRANTS.body}</p>
      </div>
      <a href={AGENTLAB_LINKS.grant} class="u-cta grants__cta">
        {AGENTLAB_GRANTS.cta} <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <!-- ============ OFF-GRID AI LINEAGE ============ -->
  <section class="u-section is-night lineage">
    <div class="u-shell">
      <Eyebrow index="05" label="Off-Grid AI — at Mars since the beginning" />
      <h2 class="lineage__lead u-display">This isn't our first cohort.</h2>
      <p class="lineage__intro u-measure">
        Agent Lab comes out of <em>Off-Grid AI</em>, the AI program that's run at
        Mars since before it had a name — a GAN trained on Bombay Beach in 2019,
        GPT-3 house bots by 2022, an AI Film Festival by 2024, a personal agent
        for every Martian by 2025.
      </p>
      <ol class="lineage__strip">
        {AGENTLAB_LINEAGE.map((h) => (
          <li class="ly">
            <div class="ly__plate u-plate">
              <Image
                src={h.img}
                alt={h.alt}
                widths={[300, 500, 800]}
                sizes="(max-width: 720px) 50vw, 14vw"
                format="webp"
                quality={70}
                loading="lazy"
              />
            </div>
            <p class="ly__year u-index">{h.year}</p>
            <p class="ly__cap" set:html={h.captionHtml}></p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ WINTER CONNECTION — CLOSING MEDIA ROW ============ -->
  <section class="u-section winter">
    <div class="u-shell winter__grid">
      <figure class="winter__media u-plate">
        <Image
          src={IMG_DESERT}
          alt="The off-grid Mars College village lit by warm cabin lights at night in the California desert"
          widths={[600, 1000, 1400]}
          sizes="(max-width: 880px) 100vw, 50vw"
          format="webp"
          quality={72}
          loading="lazy"
        />
      </figure>
      <div class="winter__text">
        <Eyebrow index="06" label={AGENTLAB_WINTER.eyebrow} />
        <h2 class="winter__lead u-display">{AGENTLAB_WINTER.headline}</h2>
        <p class="winter__body">{AGENTLAB_WINTER.body}</p>
        <a href={AGENTLAB_LINKS.winter} class="u-link">
          {AGENTLAB_WINTER.cta} <span class="u-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ SIGNUP ============ -->
  <section id="signup" class="u-section is-night signup">
    <div class="u-shell signup__grid">
      <div class="signup__text">
        <Eyebrow index="07" label="Sign up · Demo Day Nov 24" />
        <h2 class="signup__lead u-display">Twelve weeks. One agent. Demo Day.</h2>
        <p class="signup__intro u-measure">
          The cohort ends with Demo Day — you ship something cool with the agent
          you built. Sessions are recorded, lectures come throughout, and it all
          happens online over Discord. Save your seat below.
        </p>
        <ul class="signup__list">
          <li>{AGENTLAB.cadence}</li>
          <li>{AGENTLAB.time}</li>
          <li>{AGENTLAB.where}</li>
        </ul>
      </div>

      <div class="signup__form">
        <p class="u-label u-label--clay signup__form-eyebrow">Save your seat</p>
        {
          TALLY_OFFGRID_FORM_ID ? (
            <iframe
              data-tally-src={`https://tally.so/embed/${TALLY_OFFGRID_FORM_ID}?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1`}
              loading="lazy"
              width="100%"
              height="600"
              frameborder="0"
              marginheight="0"
              marginwidth="0"
              title="Agent Lab signup"
            />
          ) : (
            <div class="signup__form-placeholder">
              <p class="signup__form-headline">Form coming soon.</p>
              <p>
                Email{" "}
                <a href={`mailto:${EMAIL}?subject=Agent%20Lab%20cohort`}>{EMAIL}</a>{" "}
                with subject "Agent Lab" and we'll save you a seat.
              </p>
            </div>
          )
        }
      </div>
    </div>
    <script async src="https://tally.so/widgets/embed.js"></script>
  </section>

  <style>
    /* ── intro strip ── */
    .intro__grid { display: grid; grid-template-columns: 1fr; gap: 0; }
    .intro__lead { font-size: var(--text-3xl); max-width: 16ch; }
    .intro__copy { margin-top: 1.25rem; color: var(--color-ink-2); font-size: var(--text-lg); line-height: 1.5; }
    .intro__copy :global(em) { color: var(--color-clay-deep); font-style: normal; font-weight: 700; }
    .intro__cta { margin-top: 2rem; }

    /* ── topics: alternating media rows (the signature) ── */
    .rows { list-style: none; margin: 2.5rem 0 0; padding: 0; display: grid; gap: clamp(3rem, 7vw, 6rem); }
    .row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: clamp(2rem, 5vw, 4.5rem);
      align-items: center;
    }
    /* Flip every even row: image moves to the right, text to the left. */
    .row:nth-child(even) .row__media { order: 2; }
    .row__media {
      aspect-ratio: 4 / 3;
      border: var(--rule);
    }
    .row__media :global(img) {
      transition: transform 700ms var(--ease-out);
    }
    .row:hover .row__media :global(img),
    .row:focus-within .row__media :global(img) { transform: scale(1.04); }
    .row__n { display: block; }
    .row__title {
      margin-top: 0.6rem;
      font-size: clamp(2rem, 4.4vw, 3.25rem);
      line-height: 1;
      max-width: 14ch;
    }
    .row__body {
      margin-top: 1rem;
      color: var(--color-ink-2);
      font-size: var(--text-lg);
      line-height: 1.5;
      max-width: 46ch;
    }
    @media (max-width: 880px) {
      .row { grid-template-columns: 1fr; gap: 1.5rem; }
      .row:nth-child(even) .row__media { order: 0; }
      .row__media { aspect-ratio: 16 / 10; }
    }

    /* ── schedule: vertical timeline ── */
    .sked__grid { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(2rem, 6vw, 5rem); align-items: start; }
    .sked__lead { font-size: var(--text-3xl); color: var(--color-bone-on-night); max-width: 12ch; }
    .sked__cta { margin-top: 2rem; }
    .facts { margin: 2rem 0 0; padding: 0; border-top: 1px solid var(--color-rule-night); }
    .facts__row { display: grid; grid-template-columns: 7rem 1fr; gap: 1rem; padding: 0.85rem 0; border-bottom: 1px solid var(--color-rule-night); align-items: baseline; }
    .facts__k { color: #b7a98f !important; }
    .facts__v { color: var(--color-bone-on-night); font-size: 1.0625rem; line-height: 1.4; }

    .timeline { list-style: none; margin: 0; padding: 0; }
    .tl {
      position: relative;
      display: grid;
      grid-template-columns: 4.75rem 1fr;
      gap: 1.25rem;
      padding: 0 0 1.6rem 1.5rem;
      align-items: start;
    }
    /* The vertical spine */
    .tl::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0.5rem;
      bottom: -0.5rem;
      width: 1.5px;
      background: var(--color-rule-night);
    }
    .tl:last-child::before { bottom: auto; height: 0.5rem; }
    .tl__dot {
      position: absolute;
      left: -3.5px;
      top: 0.4rem;
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--color-night);
      border: 1.5px solid var(--color-clay);
    }
    .tl__date { font-family: var(--font-mono); font-size: var(--text-meta); color: var(--color-clay); padding-top: 0.05rem; }
    .tl__body { display: flex; flex-direction: column; gap: 0.2rem; }
    .tl__arc { color: #b7a98f !important; }
    .tl__title { color: var(--color-bone-on-night); font-weight: 500; line-height: 1.35; }
    /* Demo Day distinguished: filled clay dot, clay rule, bolder title */
    .tl--demo .tl__dot { background: var(--color-clay); border-color: var(--color-clay); width: 12px; height: 12px; left: -5px; }
    .tl--demo .tl__arc { color: var(--color-clay) !important; }
    .tl--demo .tl__title { color: var(--color-clay); font-family: var(--font-display); font-weight: 800; font-size: 1.2rem; letter-spacing: -0.01em; }
    @media (max-width: 880px) { .sked__grid { grid-template-columns: 1fr; gap: 2.5rem; } }
    @media (max-width: 560px) {
      .tl { grid-template-columns: 1fr; gap: 0.25rem; padding-left: 1.5rem; }
      .tl__date { padding-top: 0; }
    }

    /* ── pricing: four cumulative tiers, 4-up → 2×2 → 1-up ── */
    .join__lead { font-size: var(--text-3xl); max-width: 18ch; margin-bottom: 2.5rem; }
    .tiers { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(1rem, 2vw, 1.5rem); align-items: stretch; }
    .tier { position: relative; display: flex; flex-direction: column; padding: clamp(1.35rem, 2vw, 1.9rem); border: var(--rule); background: var(--color-paper); }
    /* $0 card reads as the quiet, open-door option */
    .tier--free { background: transparent; border-style: dashed; }
    .tier--featured { border: 2px solid var(--color-clay); background: var(--color-paper-2); }
    .tier__flag { position: absolute; top: -0.7rem; left: clamp(1.35rem, 2vw, 1.9rem); background: var(--color-clay); color: var(--color-paper) !important; padding: 0.2rem 0.6rem; letter-spacing: 0.1em; }
    .tier__name { margin-bottom: 0.7rem; }
    .tier__price { display: flex; align-items: baseline; gap: 0.4rem; flex-wrap: wrap; }
    .tier__amount { font-family: var(--font-display); font-weight: 800; font-size: clamp(2.1rem, 3vw, 2.9rem); letter-spacing: -0.03em; line-height: 1; }
    .tier__unit { color: var(--color-ink-3); font-size: var(--text-meta); }
    .tier__tagline { margin-top: 0.8rem; font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; letter-spacing: -0.01em; display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
    .tier__abbr { font-family: var(--font-mono); font-size: 0.7rem; font-weight: 600; letter-spacing: 0.08em; color: var(--color-clay); border: 1px solid color-mix(in srgb, var(--color-clay) 45%, transparent); padding: 0.1rem 0.4rem; }
    .tier__body { margin-top: 0.7rem; color: var(--color-ink-2); font-size: var(--text-sm); line-height: 1.5; }
    .tier__features { list-style: none; margin: 1.1rem 0 1.5rem; padding: 0; display: grid; gap: 0.5rem; }
    .tier__features li { padding-left: 1.4rem; position: relative; color: var(--color-ink); font-size: var(--text-sm); line-height: 1.4; }
    .tier__features li::before { content: "✓"; position: absolute; left: 0; color: var(--color-clay); font-weight: 800; }
    .tier__cta { margin-top: auto; align-self: flex-start; font-size: var(--text-sm); padding: 0.8em 1.3em; }
    .tier__learn { display: inline-block; margin-top: 0.9rem; font-size: var(--text-meta); color: var(--color-ink-2); text-decoration: underline; text-decoration-color: var(--color-clay); text-decoration-style: dashed; text-underline-offset: 4px; }
    .tier__learn:hover { color: var(--color-clay); }
    @media (max-width: 980px) { .tiers { grid-template-columns: repeat(2, 1fr); gap: clamp(1.25rem, 3vw, 2rem); } }
    @media (max-width: 540px) { .tiers { grid-template-columns: 1fr; } }

    /* ── grants: featured clay band ── */
    .grants-band { padding-block: clamp(2.5rem, 6vw, 5rem); }
    .grants { background: var(--color-clay); color: var(--color-paper); padding: clamp(1.75rem, 4vw, 3rem); display: flex; align-items: center; justify-content: space-between; gap: 2.5rem; flex-wrap: wrap; }
    .grants__badge { color: color-mix(in srgb, var(--color-paper) 82%, transparent) !important; margin-bottom: 0.6rem; }
    .grants__headline { font-size: clamp(1.8rem, 3.6vw, 2.8rem); color: var(--color-paper); max-width: 18ch; line-height: 1.02; }
    .grants__body { margin-top: 0.9rem; max-width: 54ch; color: color-mix(in srgb, var(--color-paper) 92%, transparent); line-height: 1.5; }
    .grants__cta { background: var(--color-paper); color: var(--color-clay-deep); border-color: var(--color-paper); flex-shrink: 0; }
    .grants__cta:hover { background: var(--color-ink); color: var(--color-paper); border-color: var(--color-ink); }

    /* ── lineage ── */
    .lineage__lead { font-size: var(--text-3xl); color: var(--color-bone-on-night); max-width: 16ch; }
    .lineage__intro { margin-top: 1rem; color: #cabda6; font-size: var(--text-lg); line-height: 1.5; margin-bottom: 2.5rem; }
    .lineage__intro :global(em) { color: var(--color-clay); font-style: normal; font-weight: 700; }
    .lineage__strip { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(7, 1fr); gap: clamp(0.6rem, 1.2vw, 1rem); }
    .ly { display: flex; flex-direction: column; gap: 0.5rem; }
    .ly__plate { aspect-ratio: 3 / 4; background: var(--color-night); border: 1px solid var(--color-rule-night); }
    .ly__plate :global(img) { transition: transform 600ms var(--ease-out); }
    .ly:hover .ly__plate :global(img) { transform: scale(1.05); }
    .ly__year { color: var(--color-clay); }
    .ly__cap { color: #d2c5af; font-size: 0.8125rem; line-height: 1.4; }
    .ly__cap :global(a) { color: var(--color-bone-on-night); text-decoration: none; border-bottom: 1px solid color-mix(in srgb, var(--color-clay) 65%, transparent); padding-bottom: 1px; transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out); }
    .ly__cap :global(a:hover) { color: var(--color-clay); border-color: var(--color-clay); }
    @media (max-width: 1100px) { .lineage__strip { grid-template-columns: repeat(4, 1fr); } }
    @media (max-width: 720px) { .lineage__strip { grid-template-columns: repeat(2, 1fr); } }

    /* ── winter: closing media row ── */
    .winter__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
    .winter__media { aspect-ratio: 5 / 4; border: var(--rule); }
    .winter__media :global(img) { transition: transform 700ms var(--ease-out); }
    .winter__media:hover :global(img), .winter__media:focus-within :global(img) { transform: scale(1.04); }
    .winter__lead { font-size: var(--text-3xl); max-width: 16ch; margin-top: 0.5rem; }
    .winter__body { margin-top: 1rem; color: var(--color-ink-2); font-size: var(--text-lg); line-height: 1.5; margin-bottom: 1.75rem; }
    @media (max-width: 880px) { .winter__grid { grid-template-columns: 1fr; } .winter__media { aspect-ratio: 16 / 10; } }

    /* ── signup ── */
    .signup__grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(2rem, 6vw, 5rem); align-items: start; }
    .signup__lead { font-size: clamp(1.9rem, 4vw, 3rem); color: var(--color-bone-on-night); max-width: 16ch; }
    .signup__intro { color: #cabda6; margin-top: 1rem; font-size: var(--text-lg); }
    .signup__list { list-style: none; margin: 2rem 0 0; padding: 0; border-top: 1px solid var(--color-rule-night); }
    .signup__list li { padding: 0.85rem 0 0.85rem 1.4rem; border-bottom: 1px solid var(--color-rule-night); color: var(--color-bone-on-night); position: relative; }
    .signup__list li::before { content: "→"; position: absolute; left: 0; color: var(--color-clay); font-weight: 700; }
    .signup__form { background: var(--color-bone-on-night); color: var(--color-ink); padding: clamp(1.25rem, 2.5vw, 2rem); }
    .signup__form-eyebrow { margin-bottom: 1rem; }
    .signup__form iframe { background: transparent; display: block; }
