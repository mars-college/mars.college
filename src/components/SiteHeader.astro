---
import { Image } from "astro:assets";
import { SOCIAL } from "../data/site";
import marsLogo from "../assets/brand/mars-logo.png";
const path = Astro.url.pathname;

// Pages that carry their own application form: the Apply button scrolls to
// that camp's form and stays on the page, instead of bouncing back to the
// home page's apply section. Values are the anchor each page actually uses.
const LOCAL_APPLY: Record<string, string> = {
  "/mit": "#apply",
  "/build": "#inquire",
};
const localApply = LOCAL_APPLY[path.replace(/\/$/, "") || "/"];
---

<header class="hdr">
  <div class="u-shell hdr__inner">
    <a href="/" class="hdr__brand" aria-label="Mars College — home">
      <Image src={marsLogo} alt="" class="hdr__logo" width={64} height={64} loading="eager" />
      <span class="hdr__word">Mars College</span>
    </a>

    <nav class="hdr__nav" aria-label="Primary">
      <span class="hdr__social">
        <a
          href={SOCIAL.substack}
          class="hdr__icon"
          target="_blank"
          rel="noopener"
          aria-label="Mars College on Substack"
          data-goatcounter-click="outbound-substack-header"
          data-goatcounter-title="Substack (header)"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
            <path d="M22.54 8.24H1.46V5.4h21.08v2.84zM1.46 10.81V24L12 18.11 22.54 24V10.81H1.46zM22.54 0H1.46v2.84h21.08V0z" />
          </svg>
        </a>
        <a
          href={SOCIAL.instagram}
          class="hdr__icon"
          target="_blank"
          rel="noopener"
          aria-label="Mars College on Instagram"
          data-goatcounter-click="outbound-instagram-header"
          data-goatcounter-title="Instagram (header)"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4.1" />
            <circle cx="17.4" cy="6.6" r="1" fill="currentColor" stroke="none" />
          </svg>
        </a>
        <a
          href={SOCIAL.x}
          class="hdr__icon"
          target="_blank"
          rel="noopener"
          aria-label="Mars College on X"
          data-goatcounter-click="outbound-x-header"
          data-goatcounter-title="X (header)"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
          </svg>
        </a>
      </span>
      <a
        href={localApply ?? "/#apply"}
        class="hdr__apply"
        data-goatcounter-click="click-apply-header"
        data-goatcounter-title="Apply button (header)"
      >Apply</a>
    </nav>
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-paper) 86%, transparent);
    backdrop-filter: saturate(1.1) blur(6px);
    border-bottom: var(--rule);
  }
  .hdr__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 4.25rem;
  }
  .hdr__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--color-ink);
  }
  .hdr__logo {
    height: 2rem;
    width: 2rem;
    max-height: 2rem;
    display: block;
    object-fit: contain;
  }
  .hdr__word {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
  }
  .hdr__nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2rem);
  }
  .hdr__social {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
  }
  .hdr__icon {
    display: inline-flex;
    /* 18px glyph, but a 44px hit area — the WCAG 2.5.8 / iOS minimum.
       Negative margin keeps the visual spacing unchanged. */
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    margin-inline: -0.65rem;
    color: var(--color-ink-2);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .hdr__icon:hover {
    color: var(--color-clay);
  }
  .hdr__icon svg {
    display: block;
    width: 1.15rem;
    height: 1.15rem;
  }
  .hdr__apply {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-paper);
    background: var(--color-clay);
    padding: 0.55rem 1.1rem;
    border: 1.5px solid var(--color-clay);
    transition: background var(--dur-fast) var(--ease-out);
  }
  .hdr__apply:hover {
    background: var(--color-clay-deep);
    border-color: var(--color-clay-deep);
  }
  @media (max-width: 640px) {
    .hdr__nav {
      gap: 0.9rem;
    }
    .hdr__word {
      font-size: 1.05rem;
    }
    .hdr__logo {
      height: 1.75rem;
    }
  }
</style>
