---
import { Image } from "astro:assets";
import { SOCIAL, EMAIL, NAV } from "../data/site";
import footerBg from "../assets/photos/night-glow.jpg";

interface Props {
  /** Swap the photo backdrop for the playable desert volleyball panel.
   *  Defaults to the home page only — it pulls in p5 and the game code, so
   *  the rest of the site keeps the light photo footer. */
  game?: boolean;
}
const isHome = Astro.url.pathname.replace(/\/$/, "") === "";
const { game = isHome } = Astro.props;
const year = new Date().getFullYear();

// Boot script for the footer game. Kept as a string so it only ships on the
// page that actually renders the court.
const VOLLEY_BOOT = `
// Neural slime volleyball — David Ha (otoro.net), by way of brahman.ai.
// Everything is deferred until the footer is actually on screen, and
// until window 'load' has fired: p5 0.4.4 self-starts on load if it can
// see window.setup, so booting it by hand afterwards avoids a double
// sketch.
(() => {
  const host = document.getElementById("p5Container");
  if (!host || window.__volleyBooted) return;

  const load = (src) =>
    new Promise((resolve, reject) => {
      const el = document.createElement("script");
      el.src = src;
      el.onload = resolve;
      el.onerror = reject;
      document.head.appendChild(el);
    });

  const pageLoaded = () =>
    document.readyState === "complete"
      ? Promise.resolve()
      : new Promise((r) => window.addEventListener("load", r, { once: true }));

  const boot = async () => {
    if (window.__volleyBooted) return;
    window.__volleyBooted = true;
    try {
      await pageLoaded();
      for (const f of [
        "/volley/convnet.js",
        "/volley/ga.js",
        "/volley/useful.js",
        "/volley/p5.min.js",
        "/volley/p5.dom.js",
        "/volley/slimevolley.js",
      ]) {
        await load(f);
      }
      new window.p5();
      // The sketch reads its size from the container, so keep it in step.
      // Wait for setup() to have built the game — resizeCanvas forces a
      // synchronous redraw, which would run draw() against half a world.
      if (window.ResizeObserver) {
        new ResizeObserver(() => {
          if (window.game && window.game.agent1 && window.game.agent2) {
            window.windowResized();
          }
        }).observe(host);
      }
    } catch (e) {
      host.classList.add("is-failed");
    }
  };

  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          boot();
        }
      },
      { rootMargin: "300px" }
    );
    io.observe(host);
  } else {
    boot();
  }
})();
`;
---

<footer class:list={["ftr", "is-night", game && "ftr--game"]}>
  {
    !game && (
      <div class="ftr__bg" aria-hidden="true">
        <Image
          src={footerBg}
          alt=""
          widths={[768, 1280, 1920]}
          sizes="100vw"
          format="webp"
          quality={66}
          loading="lazy"
        />
        <div class="ftr__scrim" />
      </div>
    )
  }

  {game && <div id="p5Container" class="ftr__court" aria-hidden="true" />}

  <div class="u-shell ftr__inner">
    <div class="ftr__navs">
      <nav class="ftr__col" aria-label="Pages">
        <p class="u-label ftr__h">Pages</p>
        <ul>
          {NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </nav>

      <nav class="ftr__col" aria-label="Elsewhere">
        <p class="u-label ftr__h">Elsewhere</p>
        <ul>
          <li><a href={SOCIAL.substack}>Substack</a></li>
          <li><a href={SOCIAL.instagram}>Instagram</a></li>
          <li><a href={SOCIAL.x}>X</a></li>
          <li><a href={SOCIAL.github}>GitHub</a></li>
          <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
        </ul>
      </nav>
    </div>
  </div>

  {
    game ? (
      <div class="u-shell ftr__credit">
        <span aria-hidden="true">(o_ _)ﾉ彡☆</span>{" "}
        <a href="https://otoro.net/ml/slimevolley/index.html" target="_blank" rel="noopener">
          @hardmaru
        </a>
      </div>
    ) : (
      <div class="u-shell ftr__base">
        <span class="u-label">Near Salton Sea, California</span>
        <span class="u-label">© {year} Mars College</span>
      </div>
    )
  }
</footer>

{game && <script is:inline set:html={VOLLEY_BOOT} />}

<style>
  .ftr {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-top: clamp(4rem, 9vw, 7rem);
    padding-bottom: 2rem;
  }
  .ftr__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .ftr__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ftr__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(20, 17, 14, 0.86) 0%,
      rgba(20, 17, 14, 0.72) 55%,
      rgba(20, 17, 14, 0.8) 100%
    );
  }
  .ftr__inner {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(2.5rem, 10vw, 7rem);
    align-items: start;
  }
  .ftr__navs {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(2.5rem, 10vw, 7rem);
  }
  .ftr__h {
    margin-bottom: 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--color-rule-night);
  }
  .ftr__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .ftr__col a {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-bone-on-night);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .ftr__col a:hover {
    color: var(--color-clay);
  }
  .ftr__base {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-rule-night);
  }

  /* ─── game footer: the desert court IS the section ─── */
  .ftr--game {
    display: flex;
    flex-direction: column;
    min-height: clamp(32rem, 78vh, 52rem);
    padding-top: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: clamp(1.25rem, 2.5vw, 2rem);
    background: var(--color-night);
    background-image: none;
  }
  /* full-bleed sketch behind everything in the section */
  .ftr__court {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(to bottom, #2b2b62, #6a6ab0);
  }
  .ftr__court :global(canvas) {
    display: block;
    width: 100% !important;
    height: 100% !important;
  }
  .ftr--game .ftr__inner,
  .ftr--game .ftr__credit {
    position: relative;
    z-index: 1;
  }
  /* --volley-ink is driven by the sketch's day/night cycle: black over the
     day sky, white once the stars come out. */
  .ftr--game {
    --volley-ink: #ece2d0;
    --volley-ink-inv: rgba(20, 17, 14, 0.55);
  }
  .ftr--game .ftr__h,
  .ftr--game .ftr__col a,
  .ftr--game .ftr__credit,
  .ftr--game .ftr__credit a {
    color: var(--volley-ink);
    text-shadow: 0 0 10px var(--volley-ink-inv), 0 0 3px var(--volley-ink-inv);
    transition: none;
  }
  .ftr--game .ftr__h {
    border-bottom-color: color-mix(in srgb, var(--volley-ink) 35%, transparent);
  }
  .ftr--game .ftr__col a:hover,
  .ftr--game .ftr__credit a:hover {
    color: var(--color-clay);
  }
  .ftr__credit {
    margin-top: auto;
    padding-top: clamp(2rem, 5vw, 4rem);
    /* clear the sand band, which stays light through the night cycle */
    padding-bottom: calc(var(--volley-ground, 4rem) + 0.6rem);
    text-align: right;
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    letter-spacing: 0.02em;
  }
  .ftr__credit a {
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--volley-ink) 45%, transparent);
    padding-bottom: 1px;
  }

  @media (max-width: 760px) {
    .ftr__base {
      flex-direction: column;
    }
    .ftr--game {
      min-height: clamp(26rem, 62vh, 34rem);
    }
  }
</style>
