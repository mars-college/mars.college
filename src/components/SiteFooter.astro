---
import { Image } from "astro:assets";
import { SOCIAL, EMAIL, NAV } from "../data/site";
import footerBg from "../assets/photos/night-glow.jpg";
const year = new Date().getFullYear();
---

<footer class="ftr is-night">
  <div class="ftr__bg" aria-hidden="true">
    <Image
      src={footerBg}
      alt=""
      widths={[768, 1280, 1920]}
      sizes="100vw"
      format="webp"
      quality={66}
      loading="lazy"
    />
    <div class="ftr__scrim"></div>
  </div>
  <div class="u-shell ftr__inner">
    <nav class="ftr__col" aria-label="Pages">
      <p class="u-label ftr__h">Pages</p>
      <ul>
        {NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </nav>

    <nav class="ftr__col" aria-label="Elsewhere">
      <p class="u-label ftr__h">Elsewhere</p>
      <ul>
        <li><a href={SOCIAL.substack}>Substack</a></li>
        <li><a href={SOCIAL.instagram}>Instagram</a></li>
        <li><a href={SOCIAL.x}>X</a></li>
        <li><a href={SOCIAL.github}>GitHub</a></li>
        <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
      </ul>
    </nav>
  </div>

  <div class="u-shell ftr__base">
    <span class="u-label">Near Salton Sea, California</span>
    <span class="u-label">© {year} Mars College</span>
  </div>
</footer>

<style>
  .ftr {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-top: clamp(4rem, 9vw, 7rem);
    padding-bottom: 2rem;
  }
  .ftr__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .ftr__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ftr__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(20, 17, 14, 0.86) 0%,
      rgba(20, 17, 14, 0.72) 55%,
      rgba(20, 17, 14, 0.8) 100%
    );
  }
  .ftr__inner {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(2.5rem, 10vw, 7rem);
    align-items: start;
  }
  .ftr__line {
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.02;
    margin-top: 1.1rem;
    color: var(--color-bone-on-night);
  }
  .ftr__cta {
    margin-top: 1.75rem;
  }
  .ftr__formnote {
    margin-top: 0.9rem;
    text-transform: none;
    letter-spacing: 0.02em;
    color: #9c8e76;
  }
  .ftr__h {
    margin-bottom: 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--color-rule-night);
  }
  .ftr__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .ftr__col a {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-bone-on-night);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .ftr__col a:hover {
    color: var(--color-clay);
  }
  .ftr__base {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-rule-night);
  }
  @media (max-width: 760px) {
    .ftr__inner {
      grid-template-columns: 1fr 1fr;
    }
    .ftr__lead {
      grid-column: 1 / -1;
    }
    .ftr__base {
      flex-direction: column;
    }
  }
</style>
