---
import { Image } from "astro:assets";
import { SOCIAL, EMAIL, NAV } from "../data/site";
import footerBg from "../assets/photos/night-glow.jpg";

interface Props {
  /** Swap the photo backdrop for the desert volleyball court (two neural
   *  nets rallying — scenery, not playable). Defaults to the pages in
   *  COURT_PAGES — it pulls in p5 and the game code, so everywhere else
   *  keeps the light photo footer. */
  game?: boolean;
}
// Pages that get the volleyball court instead of the photo footer.
const COURT_PAGES = ["", "/mit", "/build"];
const path = Astro.url.pathname.replace(/\/$/, "");
const { game = COURT_PAGES.includes(path) } = Astro.props;
const year = new Date().getFullYear();

// Boot script for the footer game. Kept as a string so it only ships on the
// page that actually renders the court.
const VOLLEY_BOOT = `
// Neural slime volleyball — David Ha (otoro.net), by way of brahman.ai.
// volley.min.js is generated from slimevolley.js (see its header) and folds
// in the neural-net shim + helpers, so there are only two script loads.
//
// Boot is deferred until the footer first approaches the viewport AND window
// 'load' has fired. Order matters for p5 0.4.4: it self-starts a sketch at
// eval time if it can already see window.setup, so p5.min.js must evaluate
// before the sketch script defines setup — then new p5() is the only sketch.
//
// After boot, the draw loop runs ONLY while the footer is actually on
// screen and the tab is visible. Pause state is derived from
// (intersecting, document.hidden) on every signal — never toggled from
// event edges — and a slow reconciler re-checks real geometry so a missed
// IntersectionObserver event during a violent scroll can't strand it in
// the wrong state.
(() => {
  const host = document.getElementById("p5Container");
  if (!host || host.dataset.volleyBooted) return;

  const load = (src) =>
    new Promise((resolve, reject) => {
      const el = document.createElement("script");
      el.src = src;
      el.async = false; // parallel download, in-order execution
      el.onload = resolve;
      el.onerror = reject;
      document.head.appendChild(el);
    });

  const pageLoaded = () =>
    document.readyState === "complete"
      ? Promise.resolve()
      : new Promise((r) => window.addEventListener("load", r, { once: true }));

  let sketch = null;
  let running = false;
  let visible = false;
  let resumeTimer = 0;
  const MARGIN = 160; // px beyond the viewport that still counts as "on screen"

  const applyRunState = () => {
    const want = visible && !document.hidden && !!sketch;
    if (want === running && !(!want && resumeTimer)) return;
    if (!want) {
      clearTimeout(resumeTimer);
      resumeTimer = 0;
      if (running) {
        sketch.noLoop();
        running = false;
      }
    } else if (!resumeTimer) {
      // p5 0.4.4's loop() draws synchronously and noLoop() can leave one
      // frame callback in flight for ~2 frames; resuming after a beat
      // guarantees a single draw chain no matter how fast the user flings
      // the page up and down.
      resumeTimer = setTimeout(() => {
        resumeTimer = 0;
        if (visible && !document.hidden && sketch && !running) {
          sketch.loop();
          running = true;
        }
      }, 60);
    }
  };

  const boot = async () => {
    if (host.dataset.volleyBooted) return;
    host.dataset.volleyBooted = "1";
    try {
      await pageLoaded();
      await Promise.all(["/volley/p5.min.js", "/volley/volley.min.js"].map(load));
      sketch = new window.p5();
      running = true;
      // The court is pure scenery — it takes no input. p5 0.4.4 still hangs
      // ~16 listeners on window (including non-passive touchmove and
      // devicemotion, which tax scrolling and battery on phones); strip
      // them all. Guarded: if a future p5 changes shape, worst case the
      // listeners stay.
      try {
        for (const name in sketch._events) {
          const h = sketch._events[name];
          if (h) window.removeEventListener(name, h);
        }
      } catch (e) {}
      applyRunState(); // pause immediately if the user already scrolled away
      // Container resize → canvas resize. Debounced to one per frame;
      // volleyResized() itself bails when the size didn't really change
      // (mobile URL-bar show/hide spams this while scrolling).
      if (window.ResizeObserver) {
        let raf = 0;
        new ResizeObserver(() => {
          if (raf) return;
          raf = requestAnimationFrame(() => {
            raf = 0;
            if (window.__volleyReady) window.volleyResized();
          });
        }).observe(host);
      }
    } catch (e) {
      host.classList.add("is-failed");
    }
  };

  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        visible = entries[entries.length - 1].isIntersecting;
        if (visible) boot();
        applyRunState();
      },
      { rootMargin: MARGIN + "px" }
    );
    io.observe(host);
  } else {
    visible = true;
    boot();
  }

  document.addEventListener("visibilitychange", applyRunState);

  // Belt and braces: reconcile from real geometry every few seconds, so the
  // sketch can never stay paused while on screen (or keep burning while off).
  setInterval(() => {
    if (document.hidden || !sketch) return;
    const r = host.getBoundingClientRect();
    visible = r.bottom > -MARGIN && r.top < window.innerHeight + MARGIN;
    applyRunState();
  }, 3000);
})();
`;
---

<footer class:list={["ftr", "is-night", game && "ftr--game"]}>
  {
    !game && (
      <div class="ftr__bg" aria-hidden="true">
        <Image
          src={footerBg}
          alt=""
          widths={[768, 1280, 1920]}
          sizes="100vw"
          format="webp"
          quality={66}
          loading="lazy"
        />
        <div class="ftr__scrim" />
      </div>
    )
  }

  {game && <div id="p5Container" class="ftr__court" aria-hidden="true" />}

  <div class="u-shell ftr__inner">
    <div class="ftr__navs">
      <nav class="ftr__col" aria-label="Pages">
        <p class="u-label ftr__h">Pages</p>
        <ul>
          {NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </nav>

      <nav class="ftr__col" aria-label="Elsewhere">
        <p class="u-label ftr__h">Elsewhere</p>
        <ul>
          <li><a href={SOCIAL.substack}>Substack</a></li>
          <li><a href={SOCIAL.instagram}>Instagram</a></li>
          <li><a href={SOCIAL.x}>X</a></li>
          <li><a href={SOCIAL.github}>GitHub</a></li>
          <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
        </ul>
      </nav>
    </div>
  </div>

  {
    game ? (
      <div class="ftr__credit">
        <span aria-hidden="true">(o_ _)ﾉ彡☆</span>{" "}
        <a href="https://otoro.net/ml/slimevolley/index.html" target="_blank" rel="noopener">
          @hardmaru
        </a>
      </div>
    ) : (
      <div class="u-shell ftr__base">
        <span class="u-label">Near Salton Sea, California</span>
        <span class="u-label">© {year} Mars College</span>
      </div>
    )
  }
</footer>

{game && <script is:inline set:html={VOLLEY_BOOT} />}

<style>
  .ftr {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-top: clamp(4rem, 9vw, 7rem);
    padding-bottom: 2rem;
  }
  .ftr__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .ftr__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ftr__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(20, 17, 14, 0.86) 0%,
      rgba(20, 17, 14, 0.72) 55%,
      rgba(20, 17, 14, 0.8) 100%
    );
  }
  .ftr__inner {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(2.5rem, 10vw, 7rem);
    align-items: start;
  }
  .ftr__navs {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(2.5rem, 10vw, 7rem);
  }
  .ftr__h {
    margin-bottom: 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--color-rule-night);
  }
  .ftr__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .ftr__col a {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-bone-on-night);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .ftr__col a:hover {
    color: var(--color-clay);
  }
  .ftr__base {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-rule-night);
  }

  /* ─── game footer: the desert court IS the section ─── */
  .ftr--game {
    display: flex;
    flex-direction: column;
    min-height: clamp(37rem, 90vh, 60rem);
    padding-top: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: 0.5rem;
    background: var(--color-night);
    background-image: none;
  }
  /* full-bleed sketch behind everything in the section */
  .ftr__court {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(to bottom, #2b2b62, #6a6ab0);
  }
  .ftr__court :global(canvas) {
    display: block;
    width: 100% !important;
    height: 100% !important;
  }
  .ftr--game .ftr__inner,
  .ftr--game .ftr__credit {
    position: relative;
    z-index: 1;
  }
  /* --volley-ink is driven by the sketch's day/night cycle: black over the
     day sky, white once the stars come out. */
  .ftr--game {
    --volley-ink: #ece2d0;
    --volley-ink-inv: rgba(20, 17, 14, 0.55);
  }
  .ftr--game .ftr__h,
  .ftr--game .ftr__col a {
    color: var(--volley-ink);
    text-shadow: 0 0 10px var(--volley-ink-inv), 0 0 3px var(--volley-ink-inv);
    transition: none;
  }
  /* The credit rides down on the sand, which stays light through the night
     cycle — so it stays black rather than following --volley-ink. */
  .ftr--game .ftr__credit,
  .ftr--game .ftr__credit a {
    color: #14110e;
    text-shadow: 0 0 8px rgba(240, 210, 130, 0.9);
  }
  .ftr--game .ftr__h {
    border-bottom-color: color-mix(in srgb, var(--volley-ink) 35%, transparent);
  }
  .ftr--game .ftr__col a:hover,
  .ftr--game .ftr__credit a:hover {
    color: var(--color-clay);
  }
  .ftr__credit {
    margin-top: auto;
    padding-top: clamp(2rem, 5vw, 4rem);
    padding-bottom: 0.35rem;
    /* hugs the viewport edge rather than the content shell */
    padding-right: clamp(0.5rem, 1.2vw, 1rem);
    text-align: right;
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    letter-spacing: 0.02em;
  }
  .ftr__credit a {
    text-decoration: none;
    border-bottom: 1px solid rgba(20, 17, 14, 0.45);
    padding-bottom: 1px;
  }

  @media (max-width: 760px) {
    .ftr__base {
      flex-direction: column;
    }
    .ftr--game {
      min-height: clamp(30rem, 71vh, 39rem);
    }
  }
</style>
