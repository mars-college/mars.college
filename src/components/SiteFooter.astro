---
import { SOCIAL, EMAIL, NAV, APPLY_URL } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="ftr is-night">
  <div class="u-shell ftr__inner">
    <div class="ftr__lead">
      <p class="u-label">Mars College</p>
      <a href={APPLY_URL} class="u-cta ftr__cta">
        Apply for 2027 <span aria-hidden="true">→</span>
      </a>
    </div>

    <nav class="ftr__col" aria-label="Pages">
      <p class="u-label ftr__h">Pages</p>
      <ul>
        {NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        <li><a href={APPLY_URL}>Apply</a></li>
      </ul>
    </nav>

    <nav class="ftr__col" aria-label="Elsewhere">
      <p class="u-label ftr__h">Elsewhere</p>
      <ul>
        <li><a href={SOCIAL.substack}>Substack</a></li>
        <li><a href={SOCIAL.instagram}>Instagram</a></li>
        <li><a href={SOCIAL.x}>X</a></li>
        <li><a href={SOCIAL.github}>GitHub</a></li>
        <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
      </ul>
    </nav>
  </div>

  <div class="u-shell ftr__base">
    <span class="u-label">Near Salton Sea, California</span>
    <span class="u-label">© {year} Mars College</span>
  </div>
</footer>

<style>
  .ftr {
    padding-top: clamp(3.5rem, 7vw, 6rem);
    padding-bottom: 2rem;
  }
  .ftr__inner {
    display: grid;
    grid-template-columns: 1.6fr 0.7fr 0.9fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .ftr__line {
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.02;
    margin-top: 1.1rem;
    color: var(--color-bone-on-night);
  }
  .ftr__cta {
    margin-top: 1.75rem;
  }
  .ftr__formnote {
    margin-top: 0.9rem;
    text-transform: none;
    letter-spacing: 0.02em;
    color: #9c8e76;
  }
  .ftr__h {
    margin-bottom: 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--color-rule-night);
  }
  .ftr__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .ftr__col a {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-bone-on-night);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .ftr__col a:hover {
    color: var(--color-clay);
  }
  .ftr__base {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-rule-night);
  }
  @media (max-width: 760px) {
    .ftr__inner {
      grid-template-columns: 1fr 1fr;
    }
    .ftr__lead {
      grid-column: 1 / -1;
    }
    .ftr__base {
      flex-direction: column;
    }
  }
</style>
