---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Analytics from "../components/Analytics.astro";
import { SOCIAL } from "../data/site";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  image?: string; // og/twitter image path (in /public)
  imageAlt?: string; // og/twitter image alt text
  preloadImage?: string; // LCP image to preload on this page
  jsonLd?: object; // extra page-specific structured data (e.g. Course)
}
const {
  title,
  description,
  noindex = false,
  image = "/og-image.jpg?v=3", // ?v busts scraper caches (Discord etc.) when the image changes
  imageAlt = "Giant white MARS letters at the Mars College desert camp at golden hour — trailers and a mural around the letters, a unicycle rider in front, mountains and open sky behind",
  preloadImage,
  jsonLd,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site).href;

// Site-wide organization schema — tells search engines Mars College is a school.
const orgLd = {
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  name: "Mars College",
  alternateName: "Mars College AI School",
  url: Astro.site?.href,
  logo: new URL("/mars-logo.png", Astro.site).href,
  image: ogImage,
  description:
    "Mars College is an annual off-grid AI school and pop-up college in the California desert. Learn sovereign, off-grid AI engineering: personal AI agents, art with AI, and earning a living with AI.",
  email: "info@mars.college",
  foundingDate: "2020",
  founder: [
    { "@type": "Person", name: "Gene Kogan", url: "https://genekogan.com" },
    { "@type": "Person", name: "Freeman" },
  ],
  address: {
    "@type": "PostalAddress",
    addressLocality: "Bombay Beach",
    addressRegion: "CA",
    addressCountry: "US",
  },
  sameAs: [SOCIAL.substack, SOCIAL.instagram, SOCIAL.x, SOCIAL.github, SOCIAL.youtube],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Mars College" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <meta name="theme-color" content="#f3ede1" />
    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    <Analytics />
    <style>
      .skip-link {
        position: absolute;
        left: -999px;
        top: 0;
        background: var(--color-ink);
        color: var(--color-paper);
        padding: 0.75rem 1rem;
        font-family: var(--font-body);
        font-weight: 700;
        font-size: var(--text-sm);
        z-index: 100;
      }
      .skip-link:focus {
        left: 0;
      }
    </style>
  </body>
</html>
